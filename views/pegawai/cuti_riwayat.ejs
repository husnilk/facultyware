<% include ../layouts/header %>

<!-- Breadcrumb -->
<nav class="flex text-slate-500 text-xs font-semibold uppercase tracking-wider mb-4" aria-label="Breadcrumb">
    <ol class="inline-flex items-center space-x-1 md:space-x-3">
        <li class="inline-flex items-center">
            <a href="/pegawai" class="hover:text-blue-600 flex items-center gap-1.5">
                <i class="fa-solid fa-house"></i> Dashboard
            </a>
        </li>
        <li aria-current="page">
            <div class="flex items-center gap-2">
                <i class="fa-solid fa-chevron-right text-[10px] text-slate-400"></i>
                <span class="text-slate-400">Riwayat Pengajuan Cuti</span>
            </div>
        </li>
    </ol>
</nav>

<!-- Alerts -->
<% if (success) { %>
    <div class="bg-emerald-50 border border-emerald-200 text-emerald-700 px-4 py-3 rounded-lg flex items-center gap-3 mb-6 text-sm">
        <i class="fa-solid fa-circle-check text-lg text-emerald-500"></i>
        <span><%= success %></span>
    </div>
<% } %>
<% if (error) { %>
    <div class="bg-rose-50 border border-rose-200 text-rose-700 px-4 py-3 rounded-lg flex items-center gap-3 mb-6 text-sm">
        <i class="fa-solid fa-circle-exclamation text-lg text-rose-500"></i>
        <span><%= error %></span>
    </div>
<% } %>

<!-- Main Table Card -->
<div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden">
    
    <!-- Export Bar -->
    <div class="px-5 pt-4 pb-0 flex items-center justify-between">
        <h2 class="text-sm font-bold text-slate-700 uppercase tracking-wider">Riwayat Pengajuan Cuti</h2>
        <div class="flex items-center gap-2">
            <span class="text-xs text-slate-400 font-medium mr-1">Export:</span>
            <a 
                href="/pegawai/cuti/export/pdf?search=<%= search %>&status=<%= status %>" 
                class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-rose-600 hover:bg-rose-700 text-white text-xs font-semibold rounded-lg shadow-sm transition-colors"
                title="Export ke PDF"
            >
                <i class="fa-solid fa-file-pdf"></i> PDF
            </a>
        </div>
    </div>

    <!-- Filter & Search Bar Header -->
    <div class="p-5 border-b border-slate-200 bg-slate-50/50">
        <form action="/pegawai/cuti" method="GET" class="flex flex-col md:flex-row gap-4 justify-between items-stretch md:items-center">
            
            <!-- Pencarian -->
            <div class="relative flex-1 max-w-md">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </div>
                <input 
                    type="text" 
                    name="search" 
                    value="<%= search %>" 
                    placeholder="Cari jenis cuti atau alasan..." 
                    class="w-full pl-9 pr-4 py-2 border border-slate-300 rounded-lg text-sm bg-white outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500/10 transition-all"
                >
            </div>

            <!-- Filters & Sorting -->
            <div class="flex flex-wrap items-center gap-3">
                <!-- Filter Status -->
                <select name="status" class="px-3 py-2 border border-slate-300 rounded-lg text-sm bg-white outline-none focus:border-blue-500">
                    <option value="">Semua Status</option>
                    <option value="pending" <%= status === 'pending' ? 'selected' : '' %>>Menunggu Persetujuan</option>
                    <option value="approved" <%= status === 'approved' ? 'selected' : '' %>>Disetujui</option>
                    <option value="rejected" <%= status === 'rejected' ? 'selected' : '' %>>Ditolak</option>
                </select>

                <!-- Sorting -->
                <select name="sort" class="px-3 py-2 border border-slate-300 rounded-lg text-sm bg-white outline-none focus:border-blue-500">
                    <option value="DESC" <%= sort === 'DESC' ? 'selected' : '' %>>Terbaru</option>
                    <option value="ASC" <%= sort === 'ASC' ? 'selected' : '' %>>Terlama</option>
                </select>

                <!-- Cari Button -->
                <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-4 py-2 rounded-lg text-sm shadow-sm transition-colors">
                    Filter
                </button>

                <!-- Reset Filter -->
                <% if (search || status || sort !== 'DESC') { %>
                    <a href="/pegawai/cuti" class="border border-slate-300 hover:bg-slate-50 text-slate-700 font-semibold px-4 py-2 rounded-lg text-sm transition-colors">
                        Reset
                    </a>
                <% } %>
            </div>
        </form>
    </div>

    <!-- Data Table -->
    <div class="overflow-x-auto">
        <table class="w-full text-left text-sm whitespace-nowrap">
            <thead>
                <tr class="border-b border-slate-200 bg-slate-50/30 text-slate-400 text-xs font-semibold uppercase">
                    <th class="px-6 py-4">No. Pengajuan</th>
                    <th class="px-6 py-4">Jenis Cuti</th>
                    <th class="px-6 py-4">Tanggal Pengajuan</th>
                    <th class="px-6 py-4">Tanggal Mulai</th>
                    <th class="px-6 py-4">Tanggal Selesai</th>
                    <th class="px-6 py-4">Durasi</th>
                    <th class="px-6 py-4">Status</th>
                    <th class="px-6 py-4 text-center">Aksi</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 text-slate-700">
                <% if (requests && requests.length > 0) { %>
                    <% requests.forEach(r => { %>
                        <tr class="hover:bg-slate-50/50 transition-colors">
                            <td class="px-6 py-4.5 font-semibold text-slate-900">#<%= r.id %></td>
                            <td class="px-6 py-4.5"><%= r.leave_type_name %></td>
                            <td class="px-6 py-4.5"><%= new Date(r.submitted_at).toLocaleDateString('id-ID', {day: 'numeric', month: 'long', year: 'numeric'}) %></td>
                            <td class="px-6 py-4.5"><%= new Date(r.start_date).toLocaleDateString('id-ID', {day: 'numeric', month: 'short', year: 'numeric'}) %></td>
                            <td class="px-6 py-4.5"><%= new Date(r.end_date).toLocaleDateString('id-ID', {day: 'numeric', month: 'short', year: 'numeric'}) %></td>
                            <td class="px-6 py-4.5"><%= r.total_days %> Hari</td>
                            <td class="px-6 py-4.5">
                                <% if (r.status === 'pending') { %>
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-100">
                                        <span class="h-1.5 w-1.5 rounded-full bg-amber-500"></span> Menunggu Persetujuan
                                    </span>
                                <% } else if (r.status === 'approved') { %>
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-100">
                                        <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span> Disetujui
                                    </span>
                                <% } else if (r.status === 'rejected') { %>
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-rose-50 text-rose-700 border border-rose-100">
                                        <span class="h-1.5 w-1.5 rounded-full bg-rose-500"></span> Ditolak
                                    </span>
                                <% } else { %>
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-slate-50 text-slate-700 border border-slate-100">
                                        <span class="h-1.5 w-1.5 rounded-full bg-slate-500"></span> Dibatalkan
                                    </span>
                                <% } %>
                            </td>
                            <td class="px-6 py-4.5 text-center flex items-center justify-center gap-2">
                                <a href="/pegawai/cuti/<%= r.id %>" class="text-blue-600 hover:text-blue-700 hover:bg-blue-50 p-2 rounded-lg transition-colors" title="Detail">
                                    <i class="fa-solid fa-eye"></i>
                                </a>
                                <% if (r.status === 'pending') { %>
                                    <a href="/pegawai/cuti/<%= r.id %>/edit" class="text-amber-600 hover:text-amber-700 hover:bg-amber-50 p-2 rounded-lg transition-colors" title="Edit">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </a>
                                    <button 
                                        type="button" 
                                        onclick="confirmDelete(<%= r.id %>)" 
                                        class="text-rose-600 hover:text-rose-700 hover:bg-rose-50 p-2 rounded-lg transition-colors" 
                                        title="Hapus"
                                    >
                                        <i class="fa-solid fa-trash-can"></i>
                                    </button>
                                <% } else { %>
                                    <span class="p-2 text-slate-300 select-none">
                                        <i class="fa-solid fa-ban"></i>
                                    </span>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="8" class="py-12 text-center text-slate-400">
                            <div class="flex flex-col items-center justify-center gap-2">
                                <i class="fa-regular fa-folder-open text-4xl"></i>
                                <span class="font-medium">Tidak ada data pengajuan cuti ditemukan</span>
                            </div>
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>

    <!-- Pagination Footer -->
    <% if (totalPages > 1) { %>
        <div class="px-6 py-4 border-t border-slate-200 flex items-center justify-between bg-slate-50/30">
            <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Halaman <%= currentPage %> dari <%= totalPages %></span>
            <div class="inline-flex gap-2">
                <!-- Back -->
                <% if (currentPage > 1) { %>
                    <a href="/pegawai/cuti?page=<%= currentPage - 1 %>&search=<%= search %>&status=<%= status %>&sort=<%= sort %>" class="px-3 py-1.5 border border-slate-300 hover:bg-slate-50 text-slate-700 rounded-lg text-xs font-semibold transition-all">
                        <i class="fa-solid fa-angle-left"></i> Sebelum
                    </a>
                <% } else { %>
                    <span class="px-3 py-1.5 border border-slate-200 text-slate-300 rounded-lg text-xs font-semibold select-none cursor-not-allowed">
                        <i class="fa-solid fa-angle-left"></i> Sebelum
                    </span>
                <% } %>

                <!-- Next -->
                <% if (currentPage < totalPages) { %>
                    <a href="/pegawai/cuti?page=<%= currentPage + 1 %>&search=<%= search %>&status=<%= status %>&sort=<%= sort %>" class="px-3 py-1.5 border border-slate-300 hover:bg-slate-50 text-slate-700 rounded-lg text-xs font-semibold transition-all">
                        Berikut <i class="fa-solid fa-angle-right"></i>
                    </a>
                <% } else { %>
                    <span class="px-3 py-1.5 border border-slate-200 text-slate-300 rounded-lg text-xs font-semibold select-none cursor-not-allowed">
                        Berikut <i class="fa-solid fa-angle-right"></i>
                    </span>
                <% } %>
            </div>
        </div>
    <% } %>
</div>

<!-- Modal Konfirmasi Hapus (Custom UI & Premium) -->
<div id="delete-modal" class="fixed inset-0 z-50 overflow-y-auto flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm hidden transition-opacity duration-300">
    <div class="relative bg-white rounded-xl max-w-sm w-full p-6 shadow-xl space-y-6 transform scale-95 transition-transform duration-300">
        <div class="flex items-center gap-4 text-rose-600">
            <div class="bg-rose-100 p-3 rounded-full">
                <i class="fa-solid fa-trash-can text-2xl"></i>
            </div>
            <div>
                <h3 class="text-lg font-bold text-slate-800">Hapus Pengajuan Cuti?</h3>
                <p class="text-xs text-slate-500 mt-1">Tindakan ini permanen dan tidak dapat dibatalkan.</p>
            </div>
        </div>
        
        <form id="delete-form" method="POST" class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
            <button type="button" onclick="closeDeleteModal()" class="px-4 py-2 border border-slate-300 hover:bg-slate-50 text-slate-700 rounded-lg text-sm font-semibold transition-colors">
                Batal
            </button>
            <button type="submit" class="bg-rose-600 hover:bg-rose-700 text-white font-semibold px-4 py-2 rounded-lg text-sm shadow-sm transition-colors">
                Ya, Hapus
            </button>
        </form>
    </div>
</div>

<script>
    function confirmDelete(id) {
        const modal = document.getElementById('delete-modal');
        const form = document.getElementById('delete-form');
        
        form.action = `/pegawai/cuti/${id}/delete`;
        
        modal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    }

    function closeDeleteModal() {
        const modal = document.getElementById('delete-modal');
        modal.classList.add('hidden');
        document.body.style.overflow = '';
    }
</script>

<% include ../layouts/footer %>
