<div class="mb-6 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
    <div>
        <h2 class="text-2xl font-bold text-gray-800">Riwayat Pengajuan Cuti</h2>
        <p class="text-sm text-gray-500 mt-1">Daftar seluruh pengajuan cuti yang telah selesai diproses.</p>
    </div>
    
    <div class="flex gap-3">
        <a href="/pegawai/export-pdf" target="_blank" class="bg-red-50 text-red-600 hover:bg-red-100 hover:text-red-700 font-medium py-2 px-4 border border-red-200 rounded-lg shadow-sm transition-colors flex items-center gap-2 text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
            Cetak PDF
        </a>
    </div>
</div>

<div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-sm text-left text-gray-500">
            <thead class="text-xs text-gray-700 uppercase bg-gray-50 border-b border-gray-100">
                <tr>
                    <th scope="col" class="px-6 py-4">ID</th>
                    <th scope="col" class="px-6 py-4">Jenis Cuti</th>
                    <th scope="col" class="px-6 py-4">Tanggal Mulai - Selesai</th>
                    <th scope="col" class="px-6 py-4">Durasi</th>
                    <th scope="col" class="px-6 py-4">Status</th>
                    <th scope="col" class="px-6 py-4 text-center">Aksi</th>
                </tr>
            </thead>
            <tbody>
                <% if (requests.length === 0) { %>
                    <tr>
                        <td colspan="6" class="px-6 py-8 text-center text-gray-500">
                            Belum ada riwayat pengajuan cuti yang selesai diproses.
                        </td>
                    </tr>
                <% } else { %>
                    <% requests.forEach(cuti => { %>
                        <tr class="bg-white border-b border-gray-50 hover:bg-gray-50 transition-colors">
                            <td class="px-6 py-4 font-medium text-gray-900">#<%= cuti.id %></td>
                            <td class="px-6 py-4 font-semibold text-gray-800"><%= cuti.leave_type_name %></td>
                            <td class="px-6 py-4">
                                <%= new Date(cuti.start_date).toLocaleDateString('id-ID') %> s/d <br>
                                <%= new Date(cuti.end_date).toLocaleDateString('id-ID') %>
                            </td>
                            <td class="px-6 py-4"><%= cuti.total_days %> Hari</td>
                            <td class="px-6 py-4">
                                <span class="px-2.5 py-1 rounded-full text-xs font-bold 
                                    <%= cuti.status === 'approved' ? 'bg-green-50 text-green-700 border border-green-200' : 
                                       (cuti.status === 'rejected' ? 'bg-red-50 text-red-700 border border-red-200' : 
                                       'bg-gray-100 text-gray-700 border border-gray-300') %>">
                                    <%= cuti.status.charAt(0).toUpperCase() + cuti.status.slice(1) %>
                                </span>
                            </td>
                            <td class="px-6 py-4 text-center">
                                <a href="/pegawai/<%= cuti.id %>" class="text-blue-600 hover:text-blue-800 font-medium hover:underline">Lihat Detail</a>
                            </td>
                        </tr>
                    <% }) %>
                <% } %>
            </tbody>
        </table>
    </div>
</div>