<div class="max-w-2xl mx-auto">
    <div class="mb-6">
        <a href="/pegawai" class="text-gray-500 hover:text-gray-700 text-sm font-medium">&larr; Kembali ke Riwayat</a>
        <h2 class="text-2xl font-bold text-gray-800 mt-2">Detail Pengajuan #<%= cuti.id %></h2>
    </div>

    <% if (cuti.status !== 'pending' && typeof approvals !== 'undefined' && approvals.length > 0) { %>
        <% const latestNote = approvals[approvals.length - 1].notes; %>
        <% const isRejected = cuti.status === 'rejected'; %>
        
        <div class="mb-6 p-4 rounded-xl border flex items-start gap-3 <%= isRejected ? 'bg-red-50 border-red-200 text-red-800' : 'bg-green-50 border-green-200 text-green-800' %>">
            <div class="shrink-0 mt-0.5">
                <% if (isRejected) { %>
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                <% } else { %>
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                <% } %>
            </div>
            <div>
                <h3 class="text-sm font-bold mb-1"><%= isRejected ? 'Pengajuan Ditolak oleh Atasan' : 'Pengajuan Disetujui oleh Atasan' %></h3>
                <p class="text-sm leading-relaxed"><span class="font-semibold opacity-75">Komentar/Catatan:</span> <%= latestNote || 'Tidak ada catatan tambahan.' %></p>
            </div>
        </div>
    <% } %>

    <div class="bg-white shadow-sm border border-gray-100 rounded-xl p-6 space-y-6">
        <div class="grid grid-cols-2 gap-4">
            <div>
                <p class="text-xs text-gray-400 uppercase">Jenis Cuti</p>
                <p class="font-semibold text-gray-800"><%= cuti.leave_type_name %></p>
            </div>
            <div>
                <p class="text-xs text-gray-400 uppercase">Status</p>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold <%= cuti.status === 'pending' ? 'bg-yellow-50 text-yellow-700' : (cuti.status === 'approved' ? 'bg-green-50 text-green-700' : 'bg-red-50 text-red-700') %>">
                    <%= cuti.status.charAt(0).toUpperCase() + cuti.status.slice(1) %>
                </span>
            </div>
            <div>
                <p class="text-xs text-gray-400 uppercase">Tanggal Mulai</p>
                <p class="font-medium"><%= new Date(cuti.start_date).toLocaleDateString('id-ID') %></p>
            </div>
            <div>
                <p class="text-xs text-gray-400 uppercase">Tanggal Selesai</p>
                <p class="font-medium"><%= new Date(cuti.end_date).toLocaleDateString('id-ID') %></p>
            </div>
        </div>

        <div>
            <p class="text-xs text-gray-400 uppercase">Alasan</p>
            <p class="text-gray-700 mt-1"><%= cuti.reason %></p>
        </div>
    </div>

   <% if (cuti.status === 'pending') { %>
        <div class="mt-6 flex justify-end gap-3">
            <a href="/pegawai/<%= cuti.id %>/edit" class="bg-yellow-50 text-yellow-700 hover:bg-yellow-100 font-semibold py-2 px-5 border border-yellow-200 rounded-lg shadow-sm transition-colors flex items-center gap-2">
                <i class="fa-solid fa-pen-to-square"></i> Ubah Pengajuan
            </a>

            <form action="/pegawai/<%= cuti.id %>/delete" method="POST" onsubmit="return confirm('Apakah Anda yakin ingin membatalkan dan menghapus pengajuan ini? Data yang dihapus tidak dapat dikembalikan.');">
                <button type="submit" class="bg-red-50 text-red-600 hover:bg-red-100 hover:text-red-700 font-semibold py-2 px-5 border border-red-200 rounded-lg shadow-sm transition-colors flex items-center gap-2">
                    <i class="fa-solid fa-trash-can"></i> Batalkan & Hapus
                </button>
            </form>
        </div>
    <% } %>
</div>