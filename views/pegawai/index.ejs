<div class="mb-6">
    <h2 class="text-2xl font-bold text-gray-800">Dashboard Cuti</h2>
    <p class="text-sm text-gray-500 mt-1">Ringkasan status dan pengajuan cuti Anda yang sedang menunggu persetujuan.</p>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
    <div class="bg-white p-5 rounded-xl border border-gray-100 shadow-sm flex items-center gap-4">
        <div class="h-12 w-12 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
        </div>
        <div>
            <p class="text-sm text-gray-500 font-medium">Total Diajukan</p>
            <p class="text-2xl font-bold text-gray-900"><%= stats.total_requests %></p>
        </div>
    </div>

    <div class="bg-white p-5 rounded-xl border border-gray-100 shadow-sm flex items-center gap-4">
        <div class="h-12 w-12 rounded-lg bg-yellow-50 text-yellow-600 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
        </div>
        <div>
            <p class="text-sm text-gray-500 font-medium">Menunggu</p>
            <p class="text-2xl font-bold text-gray-900"><%= stats.total_pending %></p>
        </div>
    </div>

    <div class="bg-white p-5 rounded-xl border border-gray-100 shadow-sm flex items-center gap-4">
        <div class="h-12 w-12 rounded-lg bg-green-50 text-green-600 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
        </div>
        <div>
            <p class="text-sm text-gray-500 font-medium">Disetujui</p>
            <p class="text-2xl font-bold text-gray-900"><%= stats.total_approved %></p>
        </div>
    </div>

    <div class="bg-white p-5 rounded-xl border border-gray-100 shadow-sm flex items-center gap-4">
        <div class="h-12 w-12 rounded-lg bg-red-50 text-red-600 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
        </div>
        <div>
            <p class="text-sm text-gray-500 font-medium">Ditolak</p>
            <p class="text-2xl font-bold text-gray-900"><%= stats.total_rejected %></p>
        </div>
    </div>
</div>

<h3 class="text-lg font-bold text-gray-800 mb-4 border-b border-gray-200 pb-2">Menunggu Persetujuan Atasan</h3>
<div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-sm text-left text-gray-500">
            <thead class="text-xs text-gray-700 uppercase bg-gray-50 border-b border-gray-100">
                <tr>
                    <th scope="col" class="px-6 py-4">ID</th>
                    <th scope="col" class="px-6 py-4">Jenis Cuti</th>
                    <th scope="col" class="px-6 py-4">Tanggal Mulai - Selesai</th>
                    <th scope="col" class="px-6 py-4">Durasi</th>
                    <th scope="col" class="px-6 py-4">Status</th>
                    <th scope="col" class="px-6 py-4 text-center">Aksi</th>
                </tr>
            </thead>
            <tbody>
                <% if (requests.length === 0) { %>
                    <tr>
                        <td colspan="6" class="px-6 py-8 text-center text-gray-500">
                            Tidak ada pengajuan cuti yang sedang menunggu persetujuan.
                        </td>
                    </tr>
                <% } else { %>
                    <% requests.forEach(cuti => { %>
                        <tr class="bg-white border-b border-gray-50 hover:bg-gray-50 transition-colors">
                            <td class="px-6 py-4 font-medium text-gray-900">#<%= cuti.id %></td>
                            <td class="px-6 py-4 font-semibold text-gray-800"><%= cuti.leave_type_name %></td>
                            <td class="px-6 py-4">
                                <%= new Date(cuti.start_date).toLocaleDateString('id-ID') %> s/d <br>
                                <%= new Date(cuti.end_date).toLocaleDateString('id-ID') %>
                            </td>
                            <td class="px-6 py-4"><%= cuti.total_days %> Hari</td>
                            <td class="px-6 py-4">
                                <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-yellow-50 text-yellow-700 border border-yellow-200">
                                    Pending
                                </span>
                            </td>
                            <td class="px-6 py-4 text-center">
                                <a href="/pegawai/<%= cuti.id %>" class="text-blue-600 hover:text-blue-800 font-medium hover:underline">Lihat Detail</a>
                            </td>
                        </tr>
                    <% }) %>
                <% } %>
            </tbody>
        </table>
    </div>
</div>