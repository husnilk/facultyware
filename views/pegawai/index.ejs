<div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 gap-4">
    <div>
        <h2 class="text-2xl font-bold text-gray-800">Riwayat Pengajuan Cuti</h2>
        <p class="text-sm text-gray-500 mt-1">Daftar seluruh pengajuan cuti yang pernah Anda buat di sistem.</p>
    </div>
    <a href="/pegawai/create" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2.5 px-5 rounded-lg shadow-sm flex items-center gap-2 transition-colors">
        <i class="fa-solid fa-plus"></i> Buat Pengajuan Baru
    </a>
</div>

<div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-gray-50 border-b border-gray-100 text-xs text-gray-500 uppercase tracking-wider">
                    <th class="px-6 py-4 font-semibold">No. Pengajuan</th>
                    <th class="px-6 py-4 font-semibold">Jenis Cuti</th>
                    <th class="px-6 py-4 font-semibold">Tanggal Mulai</th>
                    <th class="px-6 py-4 font-semibold">Durasi</th>
                    <th class="px-6 py-4 font-semibold">Status</th>
                    <th class="px-6 py-4 font-semibold text-right">Aksi</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 text-sm text-gray-700">
                <% if (requests && requests.length > 0) { %>
                    <% requests.forEach(r => { %>
                        <tr class="hover:bg-gray-50/80 transition-colors">
                            <td class="px-6 py-4 font-medium text-gray-900">#<%= r.id %></td>
                            <td class="px-6 py-4"><%= r.leave_type_name %></td>
                            <td class="px-6 py-4">
                                <%= new Date(r.start_date).toLocaleDateString('id-ID', {day: 'numeric', month: 'short', year: 'numeric'}) %>
                            </td>
                            <td class="px-6 py-4"><%= r.total_days %> Hari</td>
                            <td class="px-6 py-4">
                                <% if (r.status === 'pending') { %>
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-yellow-50 text-yellow-700 border border-yellow-100">
                                        <span class="h-1.5 w-1.5 rounded-full bg-yellow-500"></span> Menunggu
                                    </span>
                                <% } else if (r.status === 'approved') { %>
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-green-50 text-green-700 border border-green-100">
                                        <span class="h-1.5 w-1.5 rounded-full bg-green-500"></span> Disetujui
                                    </span>
                                <% } else if (r.status === 'rejected') { %>
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-red-50 text-red-700 border border-red-100">
                                        <span class="h-1.5 w-1.5 rounded-full bg-red-500"></span> Ditolak
                                    </span>
                                <% } else { %>
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-gray-50 text-gray-700 border border-gray-200">
                                        <span class="h-1.5 w-1.5 rounded-full bg-gray-500"></span> Dibatalkan
                                    </span>
                                <% } %>
                            </td>
                            <td class="px-6 py-4 text-right">
                                <a href="/pegawai/<%= r.id %>" class="text-blue-600 hover:text-blue-800 font-semibold text-xs border border-blue-200 hover:bg-blue-50 px-3 py-1.5 rounded-md transition-all">
                                    Detail
                                </a>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="6" class="px-6 py-12 text-center text-gray-500">
                            <div class="flex flex-col items-center justify-center gap-3">
                                <svg class="w-12 h-12 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                                </svg>
                                <span class="text-base font-medium text-gray-600">Belum ada riwayat pengajuan cuti</span>
                                <span class="text-sm">Silakan buat pengajuan cuti baru dengan menekan tombol di atas.</span>
                            </div>
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>