<% include ../layouts/header %>

<% 
    // Format tanggal ke format YYYY-MM-DD agar bisa dibaca oleh input type="date"
    const formatDate = (dateVal) => {
        if (!dateVal) return '';
        const d = new Date(dateVal);
        const month = '' + (d.getMonth() + 1);
        const day = '' + d.getDate();
        const year = d.getFullYear();

        return [year, month.padStart(2, '0'), day.padStart(2, '0')].join('-');
    }

    const startFormatted = formatDate(cuti.start_date);
    const endFormatted = formatDate(cuti.end_date);
%>

<!-- Breadcrumb -->
<nav class="flex text-slate-500 text-xs font-semibold uppercase tracking-wider mb-4" aria-label="Breadcrumb">
    <ol class="inline-flex items-center space-x-1 md:space-x-3">
        <li class="inline-flex items-center">
            <a href="/pegawai" class="hover:text-blue-600 flex items-center gap-1.5">
                <i class="fa-solid fa-house"></i> Dashboard
            </a>
        </li>
        <li>
            <div class="flex items-center gap-2">
                <i class="fa-solid fa-chevron-right text-[10px] text-slate-400"></i>
                <a href="/pegawai/cuti" class="hover:text-blue-600">Riwayat Cuti</a>
            </div>
        </li>
        <li>
            <div class="flex items-center gap-2">
                <i class="fa-solid fa-chevron-right text-[10px] text-slate-400"></i>
                <a href="/pegawai/cuti/<%= cuti.id %>" class="hover:text-blue-600">Detail Pengajuan #<%= cuti.id %></a>
            </div>
        </li>
        <li aria-current="page">
            <div class="flex items-center gap-2">
                <i class="fa-solid fa-chevron-right text-[10px] text-slate-400"></i>
                <span class="text-slate-400">Ubah</span>
            </div>
        </li>
    </ol>
</nav>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Form Card (2/3 width) -->
    <div class="lg:col-span-2 bg-white border border-slate-200 rounded-xl p-6 shadow-sm">
        <h1 class="text-2xl font-extrabold text-slate-800 tracking-tight mb-2">Ubah Pengajuan Cuti #<%= cuti.id %></h1>
        <p class="text-sm text-slate-400 mb-6">Ubah data pengajuan cuti Anda yang berstatus <strong>Menunggu Persetujuan</strong>.</p>

        <% if (error) { %>
            <div class="bg-rose-50 border border-rose-200 text-rose-700 px-4 py-3 rounded-lg flex items-center gap-3 mb-6 text-sm">
                <i class="fa-solid fa-circle-exclamation text-lg text-rose-500"></i>
                <span><%= error %></span>
            </div>
        <% } %>

        <form action="/pegawai/cuti/<%= cuti.id %>/edit" method="POST" id="form-cuti" class="space-y-6">
            
            <!-- Jenis Cuti -->
            <div>
                <label for="leave_type_id" class="block text-sm font-semibold text-slate-700 mb-1">Jenis Cuti <span class="text-rose-500">*</span></label>
                <select name="leave_type_id" id="leave_type_id" required class="w-full px-4 py-2.5 border border-slate-300 rounded-lg text-slate-700 bg-white outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/10 transition-all">
                    <% balances.forEach(b => { %>
                        <option value="<%= b.leave_type_id %>" data-remaining="<%= b.remaining %>" <%= b.leave_type_id === cuti.leave_type_id ? 'selected' : '' %>>
                            <%= b.leave_type_name %> (Sisa: <%= b.remaining %> Hari)
                        </option>
                    <% }) %>
                </select>
                <p id="quota-warning" class="text-rose-600 text-xs font-medium mt-1 hidden"></p>
            </div>

            <!-- Periode Tanggal -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label for="start_date" class="block text-sm font-semibold text-slate-700 mb-1">Tanggal Mulai <span class="text-rose-500">*</span></label>
                    <input type="date" name="start_date" id="start_date" value="<%= startFormatted %>" required class="w-full px-4 py-2.5 border border-slate-300 rounded-lg text-slate-700 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/10 transition-all">
                </div>
                <div>
                    <label for="end_date" class="block text-sm font-semibold text-slate-700 mb-1">Tanggal Selesai <span class="text-rose-500">*</span></label>
                    <input type="date" name="end_date" id="end_date" value="<%= endFormatted %>" required class="w-full px-4 py-2.5 border border-slate-300 rounded-lg text-slate-700 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/10 transition-all">
                </div>
            </div>

            <!-- Estimasi Durasi (Kalkulasi Otomatis) -->
            <div id="duration-info" class="bg-blue-50/50 border border-blue-100 rounded-lg p-3.5 flex justify-between items-center">
                <span class="text-sm text-slate-600 font-medium">Estimasi Durasi Pengajuan:</span>
                <span id="calculated-days" class="text-base font-bold text-blue-700"><%= cuti.total_days %> Hari</span>
            </div>

            <!-- Alasan Cuti -->
            <div>
                <label for="reason" class="block text-sm font-semibold text-slate-700 mb-1">Alasan Cuti <span class="text-rose-500">*</span></label>
                <textarea name="reason" id="reason" rows="4" required class="w-full px-4 py-2.5 border border-slate-300 rounded-lg text-slate-700 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/10 transition-all resize-none"><%= cuti.reason %></textarea>
            </div>

            <!-- Action Buttons -->
            <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
                <a href="/pegawai/cuti/<%= cuti.id %>" class="px-5 py-2.5 border border-slate-300 hover:bg-slate-50 text-slate-700 rounded-lg text-sm font-semibold transition-all">
                    Batal
                </a>
                <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-bold px-6 py-2.5 rounded-lg text-sm shadow-md shadow-blue-500/20 transition-all flex items-center gap-2 hover:-translate-y-0.5 active:translate-y-0">
                    <i class="fa-solid fa-floppy-disk"></i> Simpan Perubahan
                </button>
            </div>
        </form>
    </div>

    <!-- Right Side Info Card -->
    <div class="space-y-4">
        <div class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm space-y-4">
            <h2 class="text-base font-bold text-slate-800 flex items-center gap-2 border-b border-slate-100 pb-3">
                <i class="fa-solid fa-circle-info text-blue-600"></i> Ketentuan Pengubahan
            </h2>
            <ul class="space-y-3 text-xs text-slate-500">
                <li class="flex items-start gap-2.5">
                    <i class="fa-solid fa-check text-emerald-500 mt-0.5"></i>
                    <span>Setelah disimpan, data akan langsung terupdate dan status tetap <strong>Menunggu Persetujuan</strong>.</span>
                </li>
                <li class="flex items-start gap-2.5">
                    <i class="fa-solid fa-check text-emerald-500 mt-0.5"></i>
                    <span>Sisa kuota akan diverifikasi kembali saat Anda menyimpan perubahan.</span>
                </li>
            </ul>
        </div>
    </div>
</div>

<!-- JavaScript Kalkulasi Durasi & Validasi Saldo -->
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const leaveSelect = document.getElementById('leave_type_id');
        const startDateInput = document.getElementById('start_date');
        const endDateInput = document.getElementById('end_date');
        const durationInfo = document.getElementById('duration-info');
        const calculatedDaysSpan = document.getElementById('calculated-days');
        const quotaWarning = document.getElementById('quota-warning');

        function updateDuration() {
            const startDateStr = startDateInput.value;
            const endDateStr = endDateInput.value;

            if (startDateStr && endDateStr) {
                const start = new Date(startDateStr);
                const end = new Date(endDateStr);

                if (end < start) {
                    durationInfo.classList.add('hidden');
                    quotaWarning.textContent = "Tanggal selesai tidak boleh sebelum tanggal mulai!";
                    quotaWarning.classList.remove('hidden');
                    return;
                } else {
                    quotaWarning.classList.add('hidden');
                }

                // Hitung selisih hari (inklusif)
                const diffTime = Math.abs(end - start);
                const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24)) + 1;

                calculatedDaysSpan.textContent = `${diffDays} Hari`;
                durationInfo.classList.remove('hidden');

                // Validasi saldo lokal
                const selectedOption = leaveSelect.options[leaveSelect.selectedIndex];
                if (selectedOption.value) {
                    const remaining = parseInt(selectedOption.getAttribute('data-remaining'));
                    if (diffDays > remaining) {
                        quotaWarning.textContent = `Durasi cuti (${diffDays} hari) melebihi kuota tersedia (${remaining} hari)!`;
                        quotaWarning.classList.remove('hidden');
                    } else {
                        quotaWarning.classList.add('hidden');
                    }
                }
            } else {
                durationInfo.classList.add('hidden');
                quotaWarning.classList.add('hidden');
            }
        }

        leaveSelect.addEventListener('change', updateDuration);
        startDateInput.addEventListener('change', updateDuration);
        endDateInput.addEventListener('change', updateDuration);
        
        // Trigger kalkulasi awal saat halaman dimuat
        updateDuration();
    });
</script>

<% include ../layouts/footer %>
