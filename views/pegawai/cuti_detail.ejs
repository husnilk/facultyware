<% include ../layouts/header %>

<!-- Breadcrumb -->
<nav class="flex text-slate-500 text-xs font-semibold uppercase tracking-wider mb-4" aria-label="Breadcrumb">
    <ol class="inline-flex items-center space-x-1 md:space-x-3">
        <li class="inline-flex items-center">
            <a href="/pegawai" class="hover:text-blue-600 flex items-center gap-1.5">
                <i class="fa-solid fa-house"></i> Dashboard
            </a>
        </li>
        <li>
            <div class="flex items-center gap-2">
                <i class="fa-solid fa-chevron-right text-[10px] text-slate-400"></i>
                <a href="/pegawai/cuti" class="hover:text-blue-600">Riwayat Cuti</a>
            </div>
        </li>
        <li aria-current="page">
            <div class="flex items-center gap-2">
                <i class="fa-solid fa-chevron-right text-[10px] text-slate-400"></i>
                <span class="text-slate-400">Detail Pengajuan #<%= cuti.id %></span>
            </div>
        </li>
    </ol>
</nav>

<!-- Alerts -->
<% if (success) { %>
    <div class="bg-emerald-50 border border-emerald-200 text-emerald-700 px-4 py-3 rounded-lg flex items-center gap-3 mb-6 text-sm">
        <i class="fa-solid fa-circle-check text-lg text-emerald-500"></i>
        <span><%= success %></span>
    </div>
<% } %>
<% if (error) { %>
    <div class="bg-rose-50 border border-rose-200 text-rose-700 px-4 py-3 rounded-lg flex items-center gap-3 mb-6 text-sm">
        <i class="fa-solid fa-circle-exclamation text-lg text-rose-500"></i>
        <span><%= error %></span>
    </div>
<% } %>

<div class="space-y-6">
    <!-- Tombol Kembali -->
    <a href="/pegawai/cuti" class="inline-flex items-center gap-2 text-sm font-semibold text-slate-600 hover:text-blue-600 transition-colors">
        <i class="fa-solid fa-arrow-left"></i> Kembali ke Riwayat Cuti
    </a>

    <!-- Main Document Sheet -->
    <div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden">
        <!-- Header Sheet -->
        <div class="px-6 py-5 border-b border-slate-200 bg-slate-50/50 flex justify-between items-center">
            <div>
                <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Lembar Pengajuan Cuti</span>
                <h1 class="text-xl font-bold text-slate-800">Nomor Pengajuan: #<%= cuti.id %></h1>
            </div>
            <div>
                <% if (cuti.status === 'pending') { %>
                    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold bg-amber-50 text-amber-700 border border-amber-200">
                        <span class="h-2 w-2 rounded-full bg-amber-500"></span> Menunggu Persetujuan
                    </span>
                <% } else if (cuti.status === 'approved') { %>
                    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                        <span class="h-2 w-2 rounded-full bg-emerald-500"></span> Disetujui
                    </span>
                <% } else if (cuti.status === 'rejected') { %>
                    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold bg-rose-50 text-rose-700 border border-rose-200">
                        <span class="h-2 w-2 rounded-full bg-rose-500"></span> Ditolak
                    </span>
                <% } else { %>
                    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold bg-slate-50 text-slate-700 border border-slate-200">
                        <span class="h-2 w-2 rounded-full bg-slate-500"></span> Dibatalkan
                    </span>
                <% } %>
            </div>
        </div>

        <!-- Content Sheet -->
        <div class="p-6 space-y-6">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div>
                    <span class="block text-xs font-bold text-slate-400 uppercase tracking-wider">Jenis Cuti</span>
                    <span class="text-sm font-semibold text-slate-700 mt-1 block"><%= cuti.leave_type_name %></span>
                </div>
                <div>
                    <span class="block text-xs font-bold text-slate-400 uppercase tracking-wider">Tanggal Pengajuan</span>
                    <span class="text-sm font-semibold text-slate-700 mt-1 block">
                        <%= new Date(cuti.submitted_at).toLocaleDateString('id-ID', {day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit'}) %>
                    </span>
                </div>
                <div>
                    <span class="block text-xs font-bold text-slate-400 uppercase tracking-wider">Tanggal Mulai Cuti</span>
                    <span class="text-sm font-semibold text-slate-700 mt-1 block">
                        <%= new Date(cuti.start_date).toLocaleDateString('id-ID', {day: 'numeric', month: 'long', year: 'numeric'}) %>
                    </span>
                </div>
                <div>
                    <span class="block text-xs font-bold text-slate-400 uppercase tracking-wider">Tanggal Selesai Cuti</span>
                    <span class="text-sm font-semibold text-slate-700 mt-1 block">
                        <%= new Date(cuti.end_date).toLocaleDateString('id-ID', {day: 'numeric', month: 'long', year: 'numeric'}) %>
                    </span>
                </div>
                <div>
                    <span class="block text-xs font-bold text-slate-400 uppercase tracking-wider">Durasi Cuti</span>
                    <span class="text-sm font-bold text-blue-700 mt-1 block"><%= cuti.total_days %> Hari Kerja</span>
                </div>
            </div>

            <div class="border-t border-slate-100 pt-5">
                <span class="block text-xs font-bold text-slate-400 uppercase tracking-wider">Alasan Pengajuan Cuti</span>
                <p class="text-sm text-slate-600 mt-1.5 bg-slate-50/50 p-4 rounded-lg border border-slate-100 leading-relaxed"><%= cuti.reason %></p>
            </div>

            <!-- Keputusan Atasan -->
            <% if (cuti.status !== 'pending' && cuti.approver_name) { %>
                <div class="border-t border-slate-100 pt-5 space-y-4">
                    <span class="block text-xs font-bold text-slate-400 uppercase tracking-wider">Keputusan Atasan</span>
                    <div class="flex items-start gap-4 p-4 rounded-xl border border-slate-200 <%= cuti.status === 'approved' ? 'bg-emerald-50/30' : 'bg-rose-50/30' %>">
                        <div class="h-10 w-10 rounded-full flex items-center justify-center text-lg font-bold <%= cuti.status === 'approved' ? 'bg-emerald-100 text-emerald-700' : 'bg-rose-100 text-rose-700' %>">
                            <i class="fa-solid <%= cuti.status === 'approved' ? 'fa-user-check' : 'fa-user-xmark' %>"></i>
                        </div>
                        <div class="flex-1 space-y-1">
                            <div class="flex justify-between items-center">
                                <span class="text-sm font-bold text-slate-800"><%= cuti.approver_name %></span>
                                <span class="text-xs text-slate-400 font-medium">
                                    <%= cuti.approval_date ? new Date(cuti.approval_date).toLocaleDateString('id-ID', {day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit'}) : '' %>
                                </span>
                            </div>
                            <p class="text-xs font-medium text-slate-400">Persetujuan Tingkat 1</p>
                            <div class="text-sm text-slate-600 mt-2">
                                <strong>Komentar Atasan:</strong>
                                <p class="mt-1 leading-relaxed bg-white border border-slate-100 rounded-lg p-3 italic text-slate-500">
                                    "<%= cuti.approver_notes || 'Tidak ada catatan khusus.' %>"
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            <% } else if (cuti.status === 'pending') { %>
                <div class="border-t border-slate-100 pt-5 text-center py-4 text-slate-400 text-sm flex flex-col items-center gap-2 bg-slate-50/20 rounded-lg">
                    <i class="fa-regular fa-clock text-2xl text-amber-500 animate-pulse"></i>
                    <span>Pengajuan ini sedang menunggu keputusan dari Atasan Anda.</span>
                </div>
            <% } %>
        </div>

        <!-- Footer Action Buttons -->
        <% if (cuti.status === 'pending') { %>
            <div class="px-6 py-4 border-t border-slate-200 bg-slate-50/50 flex justify-between items-center">
                <button type="button" onclick="confirmDelete(<%= cuti.id %>)" class="px-4 py-2 border border-rose-200 hover:bg-rose-50 text-rose-600 rounded-lg text-sm font-semibold transition-colors flex items-center gap-2">
                    <i class="fa-solid fa-trash-can"></i> Hapus Pengajuan
                </button>
                <a href="/pegawai/cuti/<%= cuti.id %>/edit" class="bg-amber-500 hover:bg-amber-600 text-white font-bold px-5 py-2 rounded-lg text-sm shadow-md shadow-amber-500/20 transition-all flex items-center gap-2 hover:-translate-y-0.5 active:translate-y-0">
                    <i class="fa-solid fa-pen-to-square"></i> Ubah Pengajuan
                </a>
            </div>
        <% } %>
    </div>
</div>

<!-- Modal Konfirmasi Hapus -->
<div id="delete-modal" class="fixed inset-0 z-50 overflow-y-auto flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm hidden">
    <div class="relative bg-white rounded-xl max-w-sm w-full p-6 shadow-xl space-y-6">
        <div class="flex items-center gap-4 text-rose-600">
            <div class="bg-rose-100 p-3 rounded-full">
                <i class="fa-solid fa-trash-can text-2xl"></i>
            </div>
            <div>
                <h3 class="text-lg font-bold text-slate-800">Hapus Pengajuan Cuti?</h3>
                <p class="text-xs text-slate-500 mt-1">Tindakan ini permanen dan tidak dapat dibatalkan.</p>
            </div>
        </div>
        <form id="delete-form" method="POST" class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
            <button type="button" onclick="closeDeleteModal()" class="px-4 py-2 border border-slate-300 hover:bg-slate-50 text-slate-700 rounded-lg text-sm font-semibold transition-colors">
                Batal
            </button>
            <button type="submit" class="bg-rose-600 hover:bg-rose-700 text-white font-semibold px-4 py-2 rounded-lg text-sm shadow-sm transition-colors">
                Ya, Hapus
            </button>
        </form>
    </div>
</div>

<script>
    function confirmDelete(id) {
        const modal = document.getElementById('delete-modal');
        const form = document.getElementById('delete-form');
        form.action = `/pegawai/cuti/${id}/delete`;
        modal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    }

    function closeDeleteModal() {
        const modal = document.getElementById('delete-modal');
        modal.classList.add('hidden');
        document.body.style.overflow = '';
    }
</script>

<% include ../layouts/footer %>
