         <form action="/item/create" method="POST" class="form grid gap-4">
            <div class="grid gap-2">
               <label for="name">Kode Item</label>
               <input type="text" id="code" name="code" class="input" required>
            </div>
            
            <div class="grid gap-2">
                <label for="name">Nama Item</label>
                <input type="text" id="name" name="name" class="input" required />
            </div>
            
            <div class="flex gap-2 mt-4">
               <label for="unit">Unit</label>
               <input type="text" id="unit" name="unit" class="input" required />
            </div>

            <div class="grid gap-2">
               <label for="minimal_quantity">Minimal Quantity</label>
               <input type="number" id="minimal_quantity" name="minimal_quantity" class="input" value="0" />
            </div>

            <div class="grid gap-2">
               <label for="description">Deskripsi</label>
               <textarea id="description" name="description" class="input"></textarea>
            </div>

            <button type="submit" class="btn">Simpan Item</button>
