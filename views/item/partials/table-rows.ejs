<% items.forEach((item, index) => { %>
    <tr class="hover:bg-surface/50 transition-colors duration-150 border-b border-edge last:border-0">
        <td class="px-6 py-4 text-sm text-muted"><%= index + 1 %></td>
        <td class="px-6 py-4 text-sm font-medium text-primary"><%= item.code %></td>
        <td class="px-6 py-4 text-sm text-primary"><%= item.name %></td>
        <td class="px-6 py-4 text-sm text-muted"><%= item.unit %></td>
        <td class="px-6 py-4 text-sm text-muted"><%= item.minimal_quantity %></td>
        <td class="px-6 py-4 text-sm text-muted max-w-[150px] truncate" title="<%= item.description %>">
            <%= item.description || '-' %>
        </td>
        <td class="px-6 py-4 whitespace-nowrap text-sm text-right">
            <div class="flex items-center justify-end gap-1">
                <a href="/item/edit/<%= item.id %>" class="text-muted hover:text-emerald-500 hover:bg-emerald-500/10 p-2 rounded-md transition-all" title="Edit">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path>
                    </svg>
                </a>
                <form action="/item/delete/<%= item.id %>" method="POST" onsubmit="return confirm('Hapus item ini?');" class="inline-block m-0">
                    <button type="submit" class="text-muted hover:text-rose-500 hover:bg-rose-500/10 p-2 rounded-md transition-all" title="Hapus">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                        </svg>
                    </button>
                </form>
            </div>
        </td>
    </tr>
<% }) %>