<div class="max-w-screen-xl mx-auto w-full">
    <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4 mb-6">
        <header class="flex flex-col gap-1.5">
            <h1 class="text-2xl font-bold tracking-tight sm:text-3xl text-gray-900"><%= title %></h1>
            <p class="text-gray-500 text-sm sm:text-base">Daftar pengajuan cuti yang perlu ditinjau oleh Atasan Level 2.</p>
        </header>
        <div class="shrink-0">
            <a href="/atasan-lvl2/export/riwayat/pdf" class="inline-flex items-center gap-2 bg-white border border-gray-300 text-gray-700 hover:bg-gray-50 px-4 py-2 rounded-lg shadow-sm text-sm font-medium transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="7 10 12 15 17 10"></polyline>
                    <line x1="12" x2="12" y1="15" y2="3"></line>
                </svg>
                Download PDF Riwayat Approval
            </a>
        </div>
    </div>

    <% if (typeof success !== 'undefined' && success) { %>
        <div class="mb-6 p-4 rounded-lg border bg-green-50 text-green-800 border-green-200 flex items-start gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 mt-0.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
            <div>
                <p class="text-sm font-medium">
                    <% if (success === 'approved') { %> Pengajuan cuti berhasil disetujui.
                    <% } else if (success === 'rejected') { %> Pengajuan cuti berhasil ditolak.
                    <% } else { %> Aksi berhasil dilakukan. <% } %>
                </p>
            </div>
        </div>
    <% } %>

    <div class="bg-white p-4 mb-6 shadow-sm border border-gray-200 rounded-xl">
        <form action="/atasan-lvl2/cuti/pending" method="GET" class="flex flex-col md:flex-row items-end gap-3 w-full">
            <div class="w-full md:flex-1">
                <label for="search" class="block text-xs font-semibold text-gray-500 mb-1.5">Cari Pegawai</label>
                <div class="relative">
                    <span class="absolute left-3 top-1/2 -translate-y-1/2 flex items-center pointer-events-none text-gray-400">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
                    </span>
                    <input type="text" id="search" name="search" value="<%= typeof search !== 'undefined' ? search : '' %>" placeholder="Ketik nama pegawai..." class="h-10 w-full rounded-md border border-gray-300 bg-white pl-9 pr-3 text-sm focus:ring-blue-500 focus:border-blue-500">
                </div>
            </div>
            
            <div class="w-full md:w-auto flex gap-2">
                <button type="submit" class="flex-1 md:flex-none h-10 px-6 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-md transition-colors shadow-sm">
                    Cari
                </button>
                <a href="/atasan-lvl2/cuti/pending" class="flex-1 md:flex-none h-10 px-6 bg-white hover:bg-gray-50 text-gray-700 border border-gray-300 text-sm font-medium rounded-md flex items-center justify-center transition-colors shadow-sm">
                    Reset
                </a>
            </div>
        </form>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-gray-600">
                <thead class="bg-gray-50 border-b border-gray-200 text-gray-700 uppercase text-xs">
                    <tr>
                        <th class="w-10 text-center py-4 font-semibold">No</th>
                        <th class="py-4 font-semibold">Nama Pegawai</th>
                        <th class="py-4 font-semibold">NIP</th>
                        <th class="py-4 font-semibold">Jenis Cuti</th>
                        <th class="py-4 font-semibold">Tgl Mulai</th>
                        <th class="py-4 font-semibold">Tgl Selesai</th>
                        <th class="text-center py-4 font-semibold">Jumlah Hari</th>
                        <th class="text-center py-4 font-semibold">Status</th>
                        <th class="text-center py-4 font-semibold w-24">Aksi</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    <% if (requests && requests.length > 0) { %>
                        <% requests.forEach((req, index)=> { %>
                            <tr class="hover:bg-gray-50 transition-colors">
                                <td class="text-center py-3 text-gray-500"><%= index + 1 %></td>
                                <td class="py-3 font-semibold text-gray-900"><%= req.employee_name %></td>
                                <td class="py-3 text-gray-500"><%= req.employee_number %></td>
                                <td class="py-3"><span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800"><%= req.leave_type_name %></span></td>
                                <td class="py-3 text-gray-500"><%= new Date(req.start_date).toLocaleDateString('id-ID', {day: 'numeric', month: 'short' , year: 'numeric' }) %></td>
                                <td class="py-3 text-gray-500"><%= new Date(req.end_date).toLocaleDateString('id-ID', {day: 'numeric' , month: 'short' , year: 'numeric' }) %></td>
                                <td class="text-center py-3 font-semibold text-gray-900"><%= req.total_days %> Hari</td>
                                <td class="text-center py-3">
                                    <% if (req.status === 'pending') { %><span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800 border border-yellow-200">Pending</span><% } %>
                                </td>
                                <td class="text-center py-3">
                                    <a href="/atasan-lvl2/cuti/<%= req.id %>" class="inline-block px-3 py-1.5 bg-white border border-gray-300 text-blue-600 font-medium text-xs rounded hover:bg-blue-50 transition-colors">Detail</a>
                                </td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="9" class="text-center py-12 text-gray-500">
                                <div class="flex flex-col items-center justify-center space-y-3">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="text-gray-300"><rect width="18" height="18" x="3" y="4" rx="2" ry="2" /><line x1="16" x2="16" y1="2" y2="6" /><line x1="8" x2="8" y1="2" y2="6" /><line x1="3" x2="21" y1="10" y2="10" /><path d="m9 16 2 2 4-4" /></svg>
                                    <p class="text-lg font-medium text-gray-600">Tidak ada pengajuan cuti yang menunggu persetujuan.</p>
                                </div>
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>