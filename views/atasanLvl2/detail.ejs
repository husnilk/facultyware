<!DOCTYPE html>
<html lang="id" class="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <!-- Basecoat & Tailwind CSS -->
    <link rel="stylesheet" href="/assets/styles.css" />
    <script src="https://unpkg.com/htmx.org@1.9.10"></script>
    <script>
      (() => {
        try {
          const stored = localStorage.getItem("themeMode");
          if (stored ? stored === "dark" : matchMedia("(prefers-color-scheme: dark)").matches) {
            document.documentElement.classList.add("dark");
          }
        } catch (_) {}
      })();
    </script>
    <style>
        .approval-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 24px;
            align-items: stretch;
        }

        .approval-card {
            border-radius: 16px;
            padding: 24px;
            min-height: 245px;
            display: flex;
            flex-direction: column;
        }

        .approval-card.approve {
            background: #ecfdf5;
            border: 1px solid #a7f3d0;
        }

        .approval-card.reject {
            background: #fef2f2;
            border: 1px solid #fecaca;
        }

        .approval-title {
            font-size: 16px;
            font-weight: 700;
            margin-bottom: 6px;
            color: #111827;
        }

        .approval-description {
            font-size: 14px;
            line-height: 1.6;
            color: #6b7280;
            margin-bottom: 18px;
        }

        .approval-form {
            margin-top: auto;
        }

        .approval-form-reject {
            display: flex;
            flex-direction: column;
            flex: 1;
        }

        .approval-textarea {
            width: 100%;
            min-height: 88px;
            padding: 12px 14px;
            border-radius: 12px;
            border: 1px solid #fecaca;
            background: #ffffff;
            font-size: 14px;
            outline: none;
            resize: vertical;
        }

        .approval-button-wrap {
            margin-top: auto;
            padding-top: 18px;
            display: flex;
            align-items: center;
        }

        .approval-btn {
            min-width: 190px;
            height: 44px;
            padding: 0 22px;
            border: none;
            border-radius: 10px;
            color: #ffffff;
            font-size: 14px;
            font-weight: 700;
            line-height: 1;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            white-space: nowrap;
            cursor: pointer;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
            transition: 0.15s ease-in-out;
        }

        .approval-btn.approve {
            background: #059669;
        }

        .approval-btn.approve:hover {
            background: #047857;
        }

        .approval-btn.reject {
            background: #dc2626;
        }

        .approval-btn.reject:hover {
            background: #b91c1c;
        }

        @media (max-width: 1024px) {
            .approval-grid {
                grid-template-columns: 1fr;
            }

            .approval-card {
                min-height: auto;
            }
        }
    </style>
</head>
<body class="bg-background text-foreground antialiased min-h-screen flex">

    <!-- Render Partial Sidebar -->
    <%- include('../layouts/sidebar') %>

    <!-- Konten Utama -->
    <main id="content" class="flex-1 min-w-0 transition-all duration-300">
        <!-- Header -->
        <header class="bg-background sticky inset-x-0 top-0 isolate flex shrink-0 items-center gap-2 border-b z-10 px-4 h-14">
            <button type="button" onclick="document.dispatchEvent(new CustomEvent('basecoat:sidebar'))" class="btn-sm-icon-ghost md:hidden">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="4" x2="20" y1="12" y2="12"></line>
                    <line x1="4" x2="20" y1="6" y2="6"></line>
                    <line x1="4" x2="20" y1="18" y2="18"></line>
                </svg>
            </button>
            <div class="flex-1 flex items-center justify-between">
                <div class="font-semibold">Panel Atasan Level 2</div>
                
                <div class="flex items-center gap-4">
                    <div class="text-sm font-medium px-3 py-1 bg-muted rounded-full text-muted-foreground hidden md:block">
                        <%= user.name %> (<%= user.role %>)
                    </div>
                </div>
            </div>
        </header>

        <div class="p-6 max-w-5xl mx-auto">
            <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4 mb-8">
                <header class="flex flex-col gap-1.5">
                    <h1 class="text-2xl font-bold tracking-tight sm:text-3xl"><%= title %></h1>
                    <p class="text-muted-foreground text-sm sm:text-base">Informasi lengkap pengajuan cuti yang perlu ditinjau oleh Atasan Level 2.</p>
                </header>
                <!-- Tombol Kembali -->
                <div class="shrink-0">
                    <a href="/atasan-lvl2/cuti/pending" class="btn-sm-outline inline-flex items-center gap-2 bg-background hover:bg-muted transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m12 19-7-7 7-7" />
                            <path d="M19 12H5" />
                        </svg>
                        Kembali ke Pending Approval
                    </a>
                </div>
            </div>

            <% const pageError = typeof error !== 'undefined' ? error : null; %>
            <% if (pageError) { %>
                <div class="mb-6 p-4 rounded-lg border flex items-start gap-3 
                    <%= pageError === 'notes_required' || pageError === 'approver_not_found' ? 'bg-red-50 text-red-800 border-red-200 dark:bg-red-950/30 dark:text-red-400 dark:border-red-900' : 
                        'bg-amber-50 text-amber-800 border-amber-200 dark:bg-amber-950/30 dark:text-amber-400 dark:border-amber-900' %>">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 mt-0.5"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                    <div>
                        <p class="text-sm font-medium">
                            <% if (pageError === 'notes_required') { %>
                                Alasan penolakan wajib diisi.
                            <% } else if (pageError === 'already_processed') { %>
                                Pengajuan ini sudah diproses.
                            <% } else if (pageError === 'approver_not_found') { %>
                                Data employee untuk Atasan Level 2 tidak ditemukan.
                            <% } else { %>
                                Terjadi kesalahan.
                            <% } %>
                        </p>
                    </div>
                </div>
            <% } %>

            <div class="flex flex-col gap-6">
                <!-- Card 1: Informasi Pegawai -->
                <div class="card p-6 shadow-sm border border-border rounded-xl bg-background">
                    <h2 class="text-lg font-semibold mb-5 flex items-center gap-2 text-foreground">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                        Informasi Pegawai
                    </h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="bg-muted/30 border border-border/50 rounded-lg p-4">
                            <p class="text-xs font-medium text-muted-foreground uppercase tracking-wider mb-1">Nama Lengkap</p>
                            <p class="font-semibold text-base text-foreground"><%= request.employee_name %></p>
                        </div>
                        <div class="bg-muted/30 border border-border/50 rounded-lg p-4">
                            <p class="text-xs font-medium text-muted-foreground uppercase tracking-wider mb-1">Nomor Pegawai / NIP</p>
                            <p class="font-semibold text-base text-foreground"><%= request.employee_number %></p>
                        </div>
                    </div>
                </div>

                <!-- Card 2: Data Pengajuan Cuti -->
                <div class="card p-6 shadow-sm border border-border rounded-xl bg-background">
                    <h2 class="text-lg font-semibold mb-5 flex items-center gap-2 text-foreground">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect><line x1="16" x2="16" y1="2" y2="6"></line><line x1="8" x2="8" y1="2" y2="6"></line><line x1="3" x2="21" y1="10" y2="10"></line><path d="M8 14h.01"></path><path d="M12 14h.01"></path><path d="M16 14h.01"></path><path d="M8 18h.01"></path><path d="M12 18h.01"></path><path d="M16 18h.01"></path></svg>
                        Data Pengajuan Cuti
                    </h2>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                        <div class="bg-muted/30 border border-border/50 rounded-lg p-4">
                            <p class="text-xs font-medium text-muted-foreground uppercase tracking-wider mb-2">Status Pengajuan</p>
                            <% if (request.status === 'pending') { %>
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-semibold bg-amber-100 text-amber-800 border border-amber-200">Pending</span>
                            <% } else if (request.status === 'approved') { %>
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-semibold bg-emerald-100 text-emerald-800 border border-emerald-200">Approved</span>
                            <% } else if (request.status === 'rejected') { %>
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-semibold bg-red-100 text-red-800 border border-red-200">Rejected</span>
                            <% } else if (request.status === 'cancelled') { %>
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-semibold bg-slate-100 text-slate-800 border border-slate-200">Cancelled</span>
                            <% } %>
                        </div>
                        <div class="bg-muted/30 border border-border/50 rounded-lg p-4">
                            <p class="text-xs font-medium text-muted-foreground uppercase tracking-wider mb-1">Jenis Cuti</p>
                            <p class="font-semibold text-foreground"><%= request.leave_type_name %></p>
                        </div>
                        <div class="bg-muted/30 border border-border/50 rounded-lg p-4">
                            <p class="text-xs font-medium text-muted-foreground uppercase tracking-wider mb-1">Tanggal Pengajuan</p>
                            <p class="font-semibold text-foreground"><%= new Date(request.submitted_at || request.created_at).toLocaleDateString('id-ID', {day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute:'2-digit'}) %></p>
                        </div>
                        <div class="bg-muted/30 border border-border/50 rounded-lg p-4">
                            <p class="text-xs font-medium text-muted-foreground uppercase tracking-wider mb-1">Jumlah Hari Cuti</p>
                            <p class="font-semibold text-foreground"><%= request.total_days %> Hari</p>
                        </div>
                        <div class="bg-muted/30 border border-border/50 rounded-lg p-4">
                            <p class="text-xs font-medium text-muted-foreground uppercase tracking-wider mb-1">Tanggal Mulai</p>
                            <p class="font-semibold text-foreground"><%= new Date(request.start_date).toLocaleDateString('id-ID', {day: 'numeric', month: 'short', year: 'numeric'}) %></p>
                        </div>
                        <div class="bg-muted/30 border border-border/50 rounded-lg p-4">
                            <p class="text-xs font-medium text-muted-foreground uppercase tracking-wider mb-1">Tanggal Selesai</p>
                            <p class="font-semibold text-foreground"><%= new Date(request.end_date).toLocaleDateString('id-ID', {day: 'numeric', month: 'short', year: 'numeric'}) %></p>
                        </div>
                        <div class="bg-muted/30 border border-border/50 rounded-lg p-4 md:col-span-1 lg:col-span-1">
                            <p class="text-xs font-medium text-muted-foreground uppercase tracking-wider mb-1">Alamat Selama Cuti</p>
                            <p class="font-semibold text-foreground"><%= request.address_leave || '-' %></p>
                        </div>
                        <div class="bg-muted/30 border border-border/50 rounded-lg p-4 md:col-span-1 lg:col-span-2">
                            <p class="text-xs font-medium text-muted-foreground uppercase tracking-wider mb-1">Kontak Darurat</p>
                            <p class="font-semibold text-foreground"><%= request.contact_leave || '-' %></p>
                        </div>
                    </div>

                    <div class="mt-4 bg-muted/10 border border-border/50 rounded-lg p-5">
                        <p class="text-xs font-medium text-muted-foreground uppercase tracking-wider mb-2">Alasan / Deskripsi Cuti</p>
                        <p class="text-sm text-foreground leading-relaxed">
                            <%= request.reason || 'Tidak ada alasan spesifik yang diberikan.' %>
                        </p>
                    </div>

                    <div class="mt-4 bg-muted/10 border border-border/50 rounded-lg p-5">
                        <p class="text-xs font-medium text-muted-foreground uppercase tracking-wider mb-3">Lampiran Dokumen</p>
                        <% if (request.attachment) { %>
                            <a href="/uploads/attachments/<%= request.attachment %>" target="_blank" class="inline-flex items-center px-4 py-2 bg-primary/10 hover:bg-primary/20 text-primary rounded-md text-sm font-medium transition-colors border border-primary/20">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"></path></svg>
                                Lihat Lampiran
                            </a>
                        <% } else { %>
                            <p class="text-sm font-medium text-muted-foreground flex items-center gap-2 opacity-70">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
                                <i>Tidak ada lampiran</i>
                            </p>
                        <% } %>
                    </div>
                </div>

<% if (request.status === 'pending') { %> 
<div class="card p-6 shadow-sm border border-border rounded-xl bg-background"> 
    <div class="flex items-start gap-3 mb-6"> 
        <div class="h-10 w-10 rounded-lg bg-muted flex items-center justify-center shrink-0"> 
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground"> 
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path> 
            </svg> 
        </div> 
        <div> 
            <h2 class="text-lg font-semibold text-foreground">Aksi Persetujuan</h2> 
            <p class="text-sm text-muted-foreground mt-1">
                Pilih tindakan untuk memproses pengajuan cuti pegawai. 
            </p> 
        </div> 
    </div>

    <div class="approval-grid">
        <div class="approval-card approve">
            <div>
                <h3 class="approval-title">Setujui Pengajuan</h3>
                <p class="approval-description">
                    Setujui pengajuan cuti jika data, tanggal, dan alasan cuti sudah sesuai.
                </p>
            </div>

            <form
                method="POST"
                action="/atasan-lvl2/cuti/<%= request.id %>/approve"
                onsubmit="return confirm('Yakin ingin menyetujui pengajuan cuti ini?');"
                class="approval-form"
            >
                <div class="approval-button-wrap">
                    <button type="submit" class="approval-btn approve">
                        Setujui Pengajuan
                    </button>
                </div>
            </form>
        </div>

        <div class="approval-card reject">
            <div>
                <h3 class="approval-title">Tolak Pengajuan</h3>
                <p class="approval-description">
                    Isi alasan penolakan agar pegawai mengetahui alasan pengajuan ditolak.
                </p>
            </div>

            <form
                method="POST"
                action="/atasan-lvl2/cuti/<%= request.id %>/reject"
                onsubmit="return confirm('Yakin ingin menolak pengajuan cuti ini?');"
                class="approval-form-reject"
            >
                <textarea
                    name="notes"
                    required
                    placeholder="Masukkan alasan penolakan..."
                    class="approval-textarea"
                ></textarea>

                <div class="approval-button-wrap">
                    <button type="submit" class="approval-btn reject">
                        Tolak Pengajuan
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
<% } else { %> 
<div class="bg-muted/30 border border-border rounded-xl p-4 flex items-center justify-center gap-2 text-muted-foreground"> 
    <p class="text-sm font-medium">Pengajuan ini sudah diproses.</p> 
</div>
<% } %>

                <!-- Card 3: Riwayat Approval -->
                <div class="card p-6 shadow-sm border border-border rounded-xl bg-background">
                    <h2 class="text-lg font-semibold mb-5 flex items-center gap-2 text-foreground">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                        Riwayat Approval
                    </h2>
                    
                    <% if (approvals && approvals.length > 0) { %>
                        <div class="relative border-l-2 border-muted ml-3 mt-2 space-y-8 pb-2">
                            <% approvals.forEach(appr => { %>
                                <div class="relative pl-6">
                                    <div class="absolute w-4 h-4 rounded-full bg-background border-2 border-primary -left-[9px] top-1"></div>
                                    <div class="mb-1 flex items-center gap-3">
                                        <h3 class="font-semibold text-base"><%= appr.approver_name || 'Sistem / Approver Tidak Ditemukan' %></h3>
                                        <% if (appr.status === 'approved') { %>
                                            <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-emerald-100 text-emerald-800 border border-emerald-200">Disetujui</span>
                                        <% } else if (appr.status === 'rejected') { %>
                                            <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-red-100 text-red-800 border border-red-200">Ditolak</span>
                                        <% } %>
                                    </div>
                                    <p class="text-xs text-muted-foreground mb-2">
                                        Level <%= appr.level %> &bull; <%= new Date(appr.action_date || appr.created_at).toLocaleDateString('id-ID', {day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute:'2-digit'}) %>
                                    </p>
                                    <% if (appr.notes) { %>
                                        <div class="p-3 bg-muted/30 rounded-lg text-sm text-foreground border border-border/50 mt-2">
                                            <span class="font-medium text-muted-foreground block mb-1 text-[10px] uppercase tracking-wider">Catatan:</span>
                                            <%= appr.notes %>
                                        </div>
                                    <% } %>
                                </div>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <div class="flex flex-col items-center justify-center py-12 bg-muted/10 border border-dashed border-border/60 rounded-lg">
                            <div class="h-12 w-12 rounded-full bg-muted/50 flex items-center justify-center mb-3">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                            </div>
                            <p class="text-sm font-medium text-muted-foreground">Belum ada riwayat approval tercatat.</p>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </main>
</body>
</html>
