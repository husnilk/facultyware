<div class="max-w-[1200px] mx-auto w-full">
    <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4 mb-8">
        <header class="flex flex-col gap-1.5">
            <h1 class="text-2xl font-bold tracking-tight sm:text-3xl text-gray-900"><%= title %></h1>
            <p class="text-gray-500 text-sm sm:text-base">Informasi lengkap pengajuan cuti yang perlu ditinjau oleh Atasan Level 2.</p>
        </header>
        <div class="shrink-0">
            <a href="/atasan-lvl2/cuti/pending" class="inline-flex items-center gap-2 px-4 py-2 bg-white border border-gray-300 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-50 shadow-sm transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7" /><path d="M19 12H5" /></svg>
                Kembali ke Pending Approval
            </a>
        </div>
    </div>

    <% const pageError = typeof error !== 'undefined' ? error : null; %>
    <% if (pageError) { %>
        <div class="mb-6 p-4 rounded-lg border flex items-start gap-3 <%= pageError === 'notes_required' || pageError === 'approver_not_found' ? 'bg-red-50 text-red-800 border-red-200' : 'bg-yellow-50 text-yellow-800 border-yellow-200' %>">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 mt-0.5"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
            <div>
                <p class="text-sm font-medium">
                    <% if (pageError === 'notes_required') { %> Alasan penolakan wajib diisi.
                    <% } else if (pageError === 'already_processed') { %> Pengajuan ini sudah diproses.
                    <% } else if (pageError === 'approver_not_found') { %> Data employee untuk Atasan Level 2 tidak ditemukan.
                    <% } else { %> Terjadi kesalahan. <% } %>
                </p>
            </div>
        </div>
    <% } %>

    <div class="flex flex-col gap-6">
        <div class="bg-white p-6 shadow-sm border border-gray-200 rounded-xl">
            <h2 class="text-lg font-semibold mb-5 flex items-center gap-2 text-gray-900 border-b border-gray-100 pb-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-500"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                Informasi Pegawai
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="bg-gray-50 border border-gray-100 rounded-lg p-4">
                    <p class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-1">Nama Lengkap</p>
                    <p class="font-semibold text-base text-gray-900"><%= request.employee_name %></p>
                </div>
                <div class="bg-gray-50 border border-gray-100 rounded-lg p-4">
                    <p class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-1">Nomor Pegawai / NIP</p>
                    <p class="font-semibold text-base text-gray-900"><%= request.employee_number %></p>
                </div>
            </div>
        </div>

        <div class="bg-white p-6 shadow-sm border border-gray-200 rounded-xl">
            <h2 class="text-lg font-semibold mb-5 flex items-center gap-2 text-gray-900 border-b border-gray-100 pb-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-500"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect><line x1="16" x2="16" y1="2" y2="6"></line><line x1="8" x2="8" y1="2" y2="6"></line><line x1="3" x2="21" y1="10" y2="10"></line><path d="M8 14h.01"></path><path d="M12 14h.01"></path><path d="M16 14h.01"></path><path d="M8 18h.01"></path><path d="M12 18h.01"></path><path d="M16 18h.01"></path></svg>
                Data Pengajuan Cuti
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                <div class="bg-gray-50 border border-gray-100 rounded-lg p-4">
                    <p class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-2">Status Pengajuan</p>
                    <% if (request.status === 'pending') { %><span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-semibold bg-yellow-100 text-yellow-800 border border-yellow-200">Pending</span>
                    <% } else if (request.status === 'approved') { %><span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-semibold bg-green-100 text-green-800 border border-green-200">Approved</span>
                    <% } else if (request.status === 'rejected') { %><span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-semibold bg-red-100 text-red-800 border border-red-200">Rejected</span>
                    <% } else if (request.status === 'cancelled') { %><span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-semibold bg-gray-200 text-gray-800 border border-gray-300">Cancelled</span><% } %>
                </div>
                <div class="bg-gray-50 border border-gray-100 rounded-lg p-4">
                    <p class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-1">Jenis Cuti</p>
                    <p class="font-semibold text-gray-900"><%= request.leave_type_name %></p>
                </div>
                <div class="bg-gray-50 border border-gray-100 rounded-lg p-4">
                    <p class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-1">Tanggal Pengajuan</p>
                    <p class="font-semibold text-gray-900"><%= new Date(request.submitted_at || request.created_at).toLocaleDateString('id-ID', {day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute:'2-digit'}) %></p>
                </div>
                <div class="bg-gray-50 border border-gray-100 rounded-lg p-4">
                    <p class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-1">Jumlah Hari Cuti</p>
                    <p class="font-semibold text-gray-900"><%= request.total_days %> Hari</p>
                </div>
                <div class="bg-gray-50 border border-gray-100 rounded-lg p-4">
                    <p class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-1">Tanggal Mulai</p>
                    <p class="font-semibold text-gray-900"><%= new Date(request.start_date).toLocaleDateString('id-ID', {day: 'numeric', month: 'short', year: 'numeric'}) %></p>
                </div>
                <div class="bg-gray-50 border border-gray-100 rounded-lg p-4">
                    <p class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-1">Tanggal Selesai</p>
                    <p class="font-semibold text-gray-900"><%= new Date(request.end_date).toLocaleDateString('id-ID', {day: 'numeric', month: 'short', year: 'numeric'}) %></p>
                </div>
                <div class="bg-gray-50 border border-gray-100 rounded-lg p-4 md:col-span-1 lg:col-span-1">
                    <p class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-1">Alamat Selama Cuti</p>
                    <p class="font-semibold text-gray-900"><%= request.address_leave || '-' %></p>
                </div>
                <div class="bg-gray-50 border border-gray-100 rounded-lg p-4 md:col-span-1 lg:col-span-2">
                    <p class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-1">Kontak Darurat</p>
                    <p class="font-semibold text-gray-900"><%= request.contact_leave || '-' %></p>
                </div>
            </div>

            <div class="mt-4 bg-gray-50 border border-gray-200 rounded-lg p-5">
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-2">Alasan / Deskripsi Cuti</p>
                <p class="text-sm text-gray-900 leading-relaxed"><%= request.reason || 'Tidak ada alasan spesifik yang diberikan.' %></p>
            </div>
            <div class="mt-4 bg-gray-50 border border-gray-200 rounded-lg p-5">
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-3">Lampiran Dokumen</p>
                <% if (request.attachment) { %>
                    <a href="/uploads/attachments/<%= request.attachment %>" target="_blank" class="inline-flex items-center px-4 py-2 bg-blue-50 hover:bg-blue-100 text-blue-700 rounded-md text-sm font-medium transition-colors border border-blue-200"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"></path></svg>Lihat Lampiran</a>
                <% } else { %>
                    <p class="text-sm font-medium text-gray-500 flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg><i>Tidak ada lampiran</i></p>
                <% } %>
            </div>
        </div>

        <% if (request.status === 'pending') { %> 
        <div class="bg-white p-6 shadow-sm border border-gray-200 rounded-xl"> 
            <div class="flex items-start gap-3 mb-6"> 
                <div class="h-10 w-10 rounded-lg bg-gray-100 flex items-center justify-center shrink-0"> 
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-600"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg> 
                </div> 
                <div> 
                    <h2 class="text-lg font-semibold text-gray-900">Aksi Persetujuan</h2> 
                    <p class="text-sm text-gray-500 mt-1">Pilih tindakan untuk memproses pengajuan cuti pegawai.</p> 
                </div> 
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <div class="bg-green-50 border border-green-200 rounded-xl p-6 flex flex-col h-full shadow-sm">
                    <h3 class="text-lg font-bold text-green-900 mb-2">Setujui Pengajuan</h3>
                    <p class="text-green-700 text-sm mb-6">Setujui pengajuan cuti jika data, tanggal, dan alasan cuti sudah sesuai.</p>
                    <form method="POST" action="/atasan-lvl2/cuti/<%= request.id %>/approve" onsubmit="return confirm('Yakin ingin menyetujui pengajuan cuti ini?');" class="mt-auto">
                        <button type="submit" class="w-full sm:w-auto px-6 py-2.5 bg-green-600 hover:bg-green-700 text-white font-medium rounded-lg shadow-sm transition-colors flex items-center justify-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                            Setujui Pengajuan
                        </button>
                    </form>
                </div>

                <div class="bg-red-50 border border-red-200 rounded-xl p-6 flex flex-col h-full shadow-sm">
                    <h3 class="text-lg font-bold text-red-900 mb-2">Tolak Pengajuan</h3>
                    <p class="text-red-700 text-sm mb-4">Isi alasan penolakan agar pegawai mengetahui alasan pengajuan ditolak.</p>
                    <form method="POST" action="/atasan-lvl2/cuti/<%= request.id %>/reject" onsubmit="return confirm('Yakin ingin menolak pengajuan cuti ini?');" class="flex flex-col flex-1">
                        <textarea name="notes" required placeholder="Masukkan alasan penolakan..." class="w-full min-h-[100px] p-3 rounded-lg border border-red-300 bg-white text-sm text-gray-900 focus:ring-red-500 focus:border-red-500 mb-4 placeholder:text-gray-400"></textarea>
                        <div class="mt-auto">
                            <button type="submit" class="w-full sm:w-auto px-6 py-2.5 bg-red-600 hover:bg-red-700 text-white font-medium rounded-lg shadow-sm transition-colors flex items-center justify-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                                Tolak Pengajuan
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <% } else { %> 
        <div class="bg-gray-50 border border-gray-200 rounded-xl p-4 flex items-center justify-center gap-2 text-gray-500"> 
            <p class="text-sm font-medium">Pengajuan ini sudah diproses.</p> 
        </div>
        <% } %>

        <div class="bg-white p-6 shadow-sm border border-gray-200 rounded-xl">
            <h2 class="text-lg font-semibold mb-5 flex items-center gap-2 text-gray-900 border-b border-gray-100 pb-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-500"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                Riwayat Approval
            </h2>
            <% if (approvals && approvals.length > 0) { %>
                <div class="relative border-l-2 border-gray-200 ml-3 mt-2 space-y-8 pb-2">
                    <% approvals.forEach(appr => { %>
                        <div class="relative pl-6">
                            <div class="absolute w-4 h-4 rounded-full bg-white border-2 border-blue-500 -left-[9px] top-1"></div>
                            <div class="mb-1 flex items-center gap-3">
                                <h3 class="font-semibold text-base text-gray-900"><%= appr.approver_name || 'Sistem / Approver Tidak Ditemukan' %></h3>
                                <% if (appr.status === 'approved') { %><span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-green-100 text-green-800 border border-green-200">Disetujui</span>
                                <% } else if (appr.status === 'rejected') { %><span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-red-100 text-red-800 border border-red-200">Ditolak</span><% } %>
                            </div>
                            <p class="text-xs text-gray-500 mb-2">Level <%= appr.level %> &bull; <%= new Date(appr.action_date || appr.created_at).toLocaleDateString('id-ID', {day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute:'2-digit'}) %></p>
                            <% if (appr.notes) { %>
                                <div class="p-3 bg-gray-50 rounded-lg text-sm text-gray-900 border border-gray-200 mt-2">
                                    <span class="font-medium text-gray-500 block mb-1 text-[10px] uppercase tracking-wider">Catatan:</span><%= appr.notes %>
                                </div>
                            <% } %>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="flex flex-col items-center justify-center py-12 bg-gray-50 border border-dashed border-gray-300 rounded-lg">
                    <div class="h-12 w-12 rounded-full bg-gray-200 flex items-center justify-center mb-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-gray-500"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                    </div>
                    <p class="text-sm font-medium text-gray-500">Belum ada riwayat approval tercatat.</p>
                </div>
            <% } %>
        </div>
    </div>
</div>