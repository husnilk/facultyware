<aside class="flex flex-col w-64 h-screen px-4 py-8 overflow-y-auto bg-white border-r">
    <h2 class="text-2xl font-bold text-blue-700 text-center mb-6">Facultyware</h2>
    
    <div class="flex flex-col justify-between flex-1 mt-6">
        <nav>
            <% if (user && user.role === 'admin') { %>
                <a class="flex items-center px-4 py-2 mt-2 text-gray-700 bg-blue-50 rounded-md" href="/admin">
                    <span class="mx-2 font-medium">Rekap Cuti</span>
                </a>
                <a class="flex items-center px-4 py-2 mt-2 text-gray-600 hover:bg-gray-100 rounded-md" href="/admin/statistik">
                    <span class="mx-2 font-medium">Statistik Cuti</span>
                </a>
            
            <% } else if (user && user.role === 'pegawai') { %>
                <a class="flex items-center px-4 py-2 mt-2 text-gray-700 bg-blue-50 hover:bg-blue-100 rounded-md transition-colors" href="/pegawai">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-600">
                        <rect x="3" y="3" width="7" height="9" rx="1"></rect>
                        <rect x="14" y="3" width="7" height="5" rx="1"></rect>
                        <rect x="14" y="12" width="7" height="9" rx="1"></rect>
                        <rect x="3" y="16" width="7" height="5" rx="1"></rect>
                    </svg>
                    <span class="mx-2 font-medium">Dashboard Cuti</span>
                </a>

                <a class="flex items-center px-4 py-2 mt-2 text-gray-600 hover:bg-gray-100 rounded-md transition-colors" href="/pegawai/riwayat">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-500">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                    <span class="mx-2 font-medium">Riwayat Cuti</span>
                </a>

                <a class="flex items-center px-4 py-2 mt-2 text-gray-600 hover:bg-gray-100 rounded-md transition-colors" href="/pegawai/create">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-500">
                        <path d="M12 5v14M5 12h14"></path>
                    </svg>
                    <span class="mx-2 font-medium">Buat Pengajuan</span>
                </a>
            
            <% } else if (user && user.role === 'atasan_lvl_1') { %>
                <a class="flex items-center px-4 py-2 mt-2 text-gray-700 bg-blue-50 rounded-md" href="/atasan/cuti">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-600">
                        <rect width="7" height="9" x="3" y="3" rx="1" />
                        <rect width="7" height="5" x="14" y="3" rx="1" />
                        <rect width="7" height="9" x="14" y="12" rx="1" />
                        <rect width="7" height="5" x="3" y="16" rx="1" />
                    </svg>
                    <span class="mx-2 font-medium">Daftar Pengajuan</span>
                </a>
            
            <% } else if (user && user.role === 'atasan_lvl_2') { %>
                <a class="flex items-center px-4 py-2 mt-2 text-gray-700 bg-blue-50 rounded-md" href="/atasan-lvl2/cuti/pending">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-600">
                        <circle cx="12" cy="12" r="10" />
                        <polyline points="12 6 12 12 16 14" />
                    </svg>
                    <span class="mx-2 font-medium">Pending Approval</span>
                </a>
            <% } %>
        </nav>

        <div class="mt-auto border-t border-gray-100 pt-6">
            <a href="/logout" class="flex items-center justify-center w-full px-4 py-2 text-red-600 border border-red-200 rounded-md hover:bg-red-50 hover:text-red-700 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                    <polyline points="16 17 21 12 16 7"></polyline>
                    <line x1="21" y1="12" x2="9" y2="12"></line>
                </svg>
                <span class="font-medium">Logout</span>
            </a>
        </div>
    </div>
</aside>