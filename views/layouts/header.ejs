<!DOCTYPE html>
<html lang="id" class="h-full bg-slate-50">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Inter & Outfit -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
        h1, h2, h3, h4, h5, h6 {
            font-family: 'Outfit', sans-serif;
        }
    </style>
</head>
<body class="h-full flex flex-col">

    <!-- Navbar Atas -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-40">
        <div class="px-4 sm:px-6 lg:px-8 flex h-16 items-center justify-between">
            <!-- Logo & Toggle -->
            <div class="flex items-center gap-4">
                <button type="button" id="sidebar-toggle" class="text-slate-500 hover:text-slate-600 lg:hidden p-1 rounded-md hover:bg-slate-100 transition-colors">
                    <i class="fa-solid fa-bars text-xl"></i>
                </button>
                <div class="flex items-center gap-2">
                    <div class="bg-blue-600 text-white p-2 rounded-lg flex items-center justify-center shadow-md shadow-blue-500/20">
                        <i class="fa-solid fa-graduation-cap text-lg"></i>
                    </div>
                    <span class="text-xl font-bold tracking-tight bg-gradient-to-r from-blue-600 to-indigo-600 bg-clip-text text-transparent">Facultyware</span>
                </div>
            </div>

            <!-- Profile & Notifications -->
            <div class="flex items-center gap-4">
                <!-- Icon Notifikasi dengan Counter -->
                <a href="/pegawai/notifikasi" class="relative text-slate-500 hover:text-slate-600 hover:bg-slate-100 p-2 rounded-full transition-all">
                    <i class="fa-solid fa-bell text-lg"></i>
                    <% if (typeof unreadCount !== 'undefined' && unreadCount > 0) { %>
                        <span class="absolute top-1 right-1 bg-rose-500 text-white text-[10px] font-bold h-5 w-5 rounded-full flex items-center justify-center animate-pulse border-2 border-white">
                            <%= unreadCount %>
                        </span>
                    <% } %>
                </a>

                <!-- Divider -->
                <div class="h-6 w-px bg-slate-200"></div>

                <!-- User Widget -->
                <div class="flex items-center gap-3">
                    <div class="hidden sm:flex flex-col text-right">
                        <span class="text-sm font-semibold text-slate-700"><%= req.session.user.name %></span>
                        <span class="text-xs text-slate-400 font-medium capitalize"><%= req.session.user.role.replace('_', ' ') %></span>
                    </div>
                    <div class="h-10 w-10 rounded-full bg-gradient-to-tr from-blue-600 to-indigo-600 flex items-center justify-center text-white font-bold text-base shadow-md shadow-blue-500/10">
                        <%= req.session.user.name.charAt(0) %>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <div class="flex-1 flex overflow-hidden">
        <!-- Sidebar Kiri -->
        <aside id="sidebar-menu" class="fixed inset-y-0 left-0 z-30 w-64 bg-white border-r border-slate-200 pt-20 transform -translate-x-full lg:translate-x-0 lg:static lg:pt-0 transition-transform duration-300 ease-in-out flex flex-col justify-between">
            <div class="px-4 py-6 space-y-7 overflow-y-auto flex-1">
                <!-- Navigasi -->
                <div class="space-y-2">
                    <p class="px-3 text-xs font-semibold text-slate-400 uppercase tracking-wider">Navigasi Utama</p>
                    
                    <!-- Dashboard -->
                    <a href="/pegawai" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all group <%= req.baseUrl === '/pegawai' && req.path === '/' ? 'bg-blue-50 text-blue-700' : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900' %>">
                        <i class="fa-solid fa-chart-pie text-lg transition-transform group-hover:scale-110"></i>
                        <span>Dashboard</span>
                    </a>
                    
                    <!-- Buat Pengajuan -->
                    <a href="/pegawai/cuti/tambah" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all group <%= req.baseUrl === '/pegawai' && req.path === '/cuti/tambah' ? 'bg-blue-50 text-blue-700' : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900' %>">
                        <i class="fa-solid fa-calendar-plus text-lg transition-transform group-hover:scale-110"></i>
                        <span>Buat Pengajuan Cuti</span>
                    </a>
                    
                    <!-- Riwayat Pengajuan -->
                    <a href="/pegawai/cuti" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all group <%= req.baseUrl === '/pegawai' && (req.path === '/cuti' || (req.path.startsWith('/cuti/') && req.path !== '/cuti/tambah')) ? 'bg-blue-50 text-blue-700' : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900' %>">
                        <i class="fa-solid fa-history text-lg transition-transform group-hover:scale-110"></i>
                        <span>Riwayat Cuti</span>
                    </a>

                    <!-- Notifikasi -->
                    <a href="/pegawai/notifikasi" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all group <%= req.baseUrl === '/pegawai' && req.path === '/notifikasi' ? 'bg-blue-50 text-blue-700' : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900' %>">
                        <i class="fa-solid fa-bell text-lg transition-transform group-hover:scale-110"></i>
                        <span>Notifikasi</span>
                        <% if (typeof unreadCount !== 'undefined' && unreadCount > 0) { %>
                            <span class="ml-auto bg-rose-500 text-white text-[10px] font-bold px-2 py-0.5 rounded-full">
                                <%= unreadCount %>
                            </span>
                        <% } %>
                    </a>
                </div>
            </div>

            <!-- Footer Sidebar / Logout -->
            <div class="p-4 border-t border-slate-100 bg-slate-50/50">
                <a href="/logout" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-semibold text-rose-600 hover:bg-rose-50 hover:text-rose-700 transition-all group">
                    <i class="fa-solid fa-right-from-bracket text-lg transition-transform group-hover:translate-x-0.5"></i>
                    <span>Keluar Aplikasi</span>
                </a>
            </div>
        </aside>

        <!-- Overlay Menu Mobile -->
        <div id="sidebar-overlay" class="fixed inset-0 z-20 bg-slate-900/40 backdrop-blur-sm hidden lg:hidden"></div>

        <!-- Main Content Area -->
        <main class="flex-1 overflow-y-auto bg-slate-50/50 px-4 py-8 sm:px-6 lg:px-8">
            <div class="max-w-6xl mx-auto space-y-6">
