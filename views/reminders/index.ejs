<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>
  <style>
    body { font-family: Arial, sans-serif; margin: 30px; background: #f7f7f7; }
    .card { background: white; padding: 24px; border-radius: 10px; max-width: 760px; margin: auto; }
    label { display: block; margin-top: 14px; font-weight: bold; }
    select, textarea { width: 100%; padding: 10px; margin-top: 6px; }
    button { margin-top: 18px; padding: 10px 18px; cursor: pointer; }
    .success { background: #d1fae5; padding: 12px; margin-bottom: 12px; }
    .error { background: #fee2e2; padding: 12px; margin-bottom: 12px; }
    a { display: inline-block; margin-top: 16px; }
  </style>
</head>
<body>
  <div class="card">
    <h1>Kirim Reminder Event</h1>

    <% if (success) { %>
      <div class="success"><%= success %></div>
    <% } %>

    <% if (error) { %>
      <div class="error"><%= error %></div>
    <% } %>

    <form action="/reminders/send" method="POST">
      <label>Event</label>
      <select name="event_id" required>
        <option value="">-- Pilih Event --</option>
        <% events.forEach(event => { %>
          <option value="<%= event.id %>" <%= form.event_id == event.id ? 'selected' : '' %>>
            <%= event.title %> - <%= event.start_date %>
          </option>
        <% }) %>
      </select>

      <label>Channel</label>
      <select name="channel" required>
        <option value="">-- Pilih Channel --</option>
        <option value="email" <%= form.channel === 'email' ? 'selected' : '' %>>Email</option>
        <option value="whatsapp" <%= form.channel === 'whatsapp' ? 'selected' : '' %>>WhatsApp</option>
        <option value="sms" <%= form.channel === 'sms' ? 'selected' : '' %>>SMS</option>
        <option value="system" <%= form.channel === 'system' ? 'selected' : '' %>>System</option>
      </select>

      <label>Pesan Reminder</label>
      <textarea name="message" rows="6" required><%= form.message || '' %></textarea>

      <button type="submit">Kirim Reminder</button>
    </form>

    <a href="/reminders/history">Lihat Riwayat Reminder</a>
  </div>
</body>
</html>