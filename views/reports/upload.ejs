<%
  const pageTitle = typeof title !== "undefined" ? title : "Upload Laporan Kegiatan";
  const safeEvents = typeof events !== "undefined" && Array.isArray(events) ? events : [];
  const safeError = typeof error !== "undefined" ? error : null;

  const displayValue = (value, fallback = "-") => {
    return value || fallback;
  };
%>

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title><%= pageTitle %> - Facultyware</title>

    <link rel="icon" href="/assets/favicon.svg" />
    <link rel="stylesheet" href="/assets/styles.css" />

    <script src="https://unpkg.com/htmx.org@2.0.4"></script>

    <script>
      (() => {
        try {
          if (
            localStorage.getItem("themeMode") === "dark" ||
            (!localStorage.getItem("themeMode") &&
              matchMedia("(prefers-color-scheme: dark)").matches)
          ) {
            document.documentElement.classList.add("dark");
          }
        } catch (_) {}
      })();
    </script>

    <script>
      (function () {
        try {
          const storedTheme = localStorage.getItem("themeVariant");
          if (storedTheme) {
            document.documentElement.classList.add(`theme-${storedTheme}`);
          }
        } catch (event) {
          console.error("Could not apply theme variant", event);
        }
      })();
    </script>
  </head>

  <body class="bg-background text-foreground antialiased p-6 md:p-10">
    <div class="max-w-6xl mx-auto space-y-6">
      <header class="flex justify-between items-center pb-6 border-b border-border">
        <div class="flex items-center gap-2">
          <span class="font-bold text-xl tracking-tight">Facultyware</span>
          <span class="text-xs text-muted-foreground bg-muted px-2 py-0.5 rounded">Hana</span>
        </div>

        <nav class="flex gap-4 items-center">
          <a href="/home" class="text-sm font-medium hover:underline">Dashboard</a>
          <a href="/participants" class="text-sm font-medium hover:underline">Peserta</a>
          <a href="/certificates" class="text-sm font-medium hover:underline">Sertifikat</a>
          <a href="/reports" class="text-sm font-medium hover:underline">Laporan</a>
          <a href="/logout" class="text-sm font-medium hover:underline">Logout</a>
        </nav>
      </header>

      <main class="space-y-6">
        <div>
          <a href="/reports" class="text-sm font-medium hover:underline">
            ← Kembali ke Laporan
          </a>
        </div>

        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
          <div>
            <h1 class="text-3xl font-bold tracking-tight">Upload Laporan Kegiatan</h1>
            <p class="text-muted-foreground text-sm mt-2">
              Unggah file laporan kegiatan berdasarkan event yang tersedia.
            </p>
          </div>

          <span class="text-xs text-muted-foreground bg-muted px-2.5 py-1 rounded-full w-fit">
            <%= safeEvents.length %> Event Tersedia
          </span>
        </div>

        <% if (safeError) { %>
          <div class="rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
            <%= safeError %>
          </div>
        <% } %>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          <div data-slot="card" class="lg:col-span-2 rounded-xl border border-border bg-card text-card-foreground shadow-md overflow-hidden">
            <div class="p-6 border-b border-border">
              <h2 class="text-xl font-bold tracking-tight">Form Upload Laporan</h2>
              <p class="text-sm text-muted-foreground mt-1">
                Lengkapi data laporan, pilih event, lalu unggah file pendukung.
              </p>
            </div>

            <form method="POST" action="/reports/upload" enctype="multipart/form-data">
              <div class="p-6 space-y-5">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                  <div class="space-y-2">
                    <label class="text-sm font-medium">Event</label>
                    <select
                      name="event_id"
                      required
                      class="w-full h-10 rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-xs transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
                    >
                      <option value="">-- Pilih Event --</option>
                      <% safeEvents.forEach((event) => { %>
                        <option value="<%= event.id %>">
                          <%= displayValue(event.title || event.name || event.event_title) %>
                        </option>
                      <% }) %>
                    </select>
                  </div>

                  <div class="space-y-2">
                    <label class="text-sm font-medium">Jenis Dokumen</label>
                    <select
                      name="document_type"
                      required
                      class="w-full h-10 rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-xs transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
                    >
                      <option value="">-- Pilih Jenis Dokumen --</option>
                      <option value="report">Report</option>
                      <option value="photo">Photo</option>
                      <option value="proposal">Proposal</option>
                      <option value="minutes">Minutes</option>
                      <option value="attendance">Attendance</option>
                      <option value="other">Other</option>
                    </select>
                  </div>
                </div>

                <div class="space-y-2">
                  <label class="text-sm font-medium">Judul Laporan</label>
                  <input
                    type="text"
                    name="title"
                    placeholder="Contoh: Laporan Kegiatan Seminar"
                    required
                    class="w-full h-10 rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-xs transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
                  />
                </div>

                <div class="space-y-2">
                  <label class="text-sm font-medium">Deskripsi</label>
                  <textarea
                    name="description"
                    placeholder="Deskripsi singkat laporan kegiatan"
                    class="w-full min-h-28 rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-xs transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
                  ></textarea>
                </div>

                <div class="space-y-2">
                  <label class="text-sm font-medium">File Laporan</label>
                  <input
                    type="file"
                    name="report_file"
                    accept=".pdf,.docx,.jpg,.jpeg,.png"
                    required
                    class="w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-xs transition-colors file:mr-4 file:rounded-md file:border-0 file:bg-muted file:px-3 file:py-1.5 file:text-sm file:font-medium focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
                  />

                  <p class="text-xs text-muted-foreground">
                    Format yang didukung: PDF, DOCX, JPG, JPEG, PNG.
                  </p>
                </div>
              </div>

              <div class="p-6 border-t border-border flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                <p class="text-sm text-muted-foreground">
                  Pastikan data laporan sudah benar sebelum diunggah.
                </p>

                <div class="flex gap-3">
                  <a
                    href="/reports"
                    class="inline-flex items-center justify-center rounded-md text-sm font-medium border border-border bg-background h-10 px-4 py-2 hover:bg-accent transition-colors"
                  >
                    Batal
                  </a>

                  <button
                    type="submit"
                    class="inline-flex items-center justify-center rounded-md text-sm font-medium bg-primary text-primary-foreground h-10 px-4 py-2 hover:bg-primary/90 transition-colors"
                  >
                    Upload Laporan
                  </button>
                </div>
              </div>
            </form>
          </div>

          <div class="space-y-6">
            <div data-slot="card" class="rounded-xl border border-border bg-card text-card-foreground shadow-md">
              <div class="p-6 border-b border-border">
                <h2 class="text-xl font-bold tracking-tight">Panduan Upload</h2>
                <p class="text-sm text-muted-foreground mt-1">
                  Ringkasan data yang perlu disiapkan.
                </p>
              </div>

              <div class="p-6 space-y-4 text-sm">
                <div class="rounded-lg border border-border bg-background p-4">
                  <div class="font-medium mb-1">1. Pilih Event</div>
                  <p class="text-muted-foreground">
                    Pastikan laporan dihubungkan dengan event yang sesuai.
                  </p>
                </div>

                <div class="rounded-lg border border-border bg-background p-4">
                  <div class="font-medium mb-1">2. Isi Detail</div>
                  <p class="text-muted-foreground">
                    Judul, jenis dokumen, dan deskripsi membantu admin mengenali laporan.
                  </p>
                </div>

                <div class="rounded-lg border border-border bg-background p-4">
                  <div class="font-medium mb-1">3. Upload File</div>
                  <p class="text-muted-foreground">
                    Gunakan file yang jelas dan sesuai format yang tersedia.
                  </p>
                </div>
              </div>
            </div>

            <div data-slot="card" class="rounded-xl border border-border bg-card text-card-foreground shadow-md">
              <div class="p-6">
                <h3 class="font-semibold mb-2">Kembali ke Laporan</h3>
                <p class="text-sm text-muted-foreground mb-4">
                  Lihat kembali daftar laporan yang sudah diunggah ke sistem.
                </p>

                <a
                  href="/reports"
                  class="inline-flex items-center justify-center rounded-md text-sm font-medium border border-border bg-background h-10 px-4 py-2 hover:bg-accent transition-colors w-full"
                >
                  Lihat Data Laporan
                </a>
              </div>
            </div>
          </div>
        </div>
      </main>
    </div>
  </body>
</html>