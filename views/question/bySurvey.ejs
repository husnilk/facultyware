<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %></title>

    <link rel="stylesheet" href="/assets/styles.css">
    <link rel="stylesheet" href="/assets/dashboard.css">
    <link rel="stylesheet" href="/assets/survey.css">
</head>

<body>

<video autoplay muted loop playsinline class="dashboard-video">
    <source src="/assets/videos/dashboard.mp4" type="video/mp4">
</video>

<div class="dashboard-bg"></div>
<div class="dashboard-blur"></div>

<div class="wrapper">

    <%- include("../partials/sidebar") %>

    <div class="content">

        <%- include("../partials/navbar") %>

        <div class="page-header">

            <div>

                <span class="hero-badge">
                    Question Management
                </span>

              <h1 data-testid="page-title">
    Question
</h1>
                <p>
                    Manage questions assigned to survey:
                    <strong><%= survey?.title || '-' %></strong>
                </p>

            </div>

            <div class="header-action">

                <a
                    href="/question/create/<%= survey.id %>"
                    class="hero-btn">

                    ➕ Add Question

                </a>

                <a
                    href="/survey"
                    class="hero-btn-outline">

                    ← Back

                </a>

            </div>

        </div>

        <div class="stats-grid">

            <div class="stat-card">

                <div class="stat-icon">❓</div>

                <div>

                    <p>Total Question</p>

                    <h2><%= questions.length %></h2>

                </div>

            </div>

            <div class="stat-card">

                <div class="stat-icon">📋</div>

                <div>

                    <p>Survey ID</p>

                    <h2>#<%= survey.id %></h2>

                </div>

            </div>

        </div>

        <div class="glass-card">

            <table class="modern-table">

                <thead>

                    <tr>

                        <th>No</th>
                        <th>Question</th>
                        <th>Type</th>
                        <th>Order</th>
                        <th width="220">Action</th>

                    </tr>

                </thead>

                <tbody>

                <% if(questions.length === 0){ %>

                    <tr>

                        <td colspan="5" class="empty">

                            <div class="empty-box">

                                <h2>📭 No Question</h2>

                                <p>
                                    This survey has no questions yet.
                                </p>

                            </div>

                        </td>

                    </tr>

                <% } %>

                <% questions.forEach((question,index)=>{ %>

                    <tr>

                        <td><%= index + 1 %></td>

                        <td>
                            <strong>
                                <%= question.question_text %>
                            </strong>
                        </td>

                        <td>
                            <span class="question-badge">
                                <%= question.type %>
                            </span>
                        </td>

                        <td>
                            <%= question.order %>
                        </td>

                        <td>

                            <div class="action-group">

                                <a
                                    href="/option/question/<%= question.id %>"
                                    class="action option"
                                    title="Manage Option">

                                    📝

                                </a>

                                <a
                                    href="/question/edit/<%= question.id %>"
                                    class="action edit"
                                    title="Edit Question">

                                    ✏️

                                </a>

                                <form
                                    action="/question/delete/<%= question.id %>"
                                    method="POST"
                                    style="display:inline;">

                                    <button
                                        type="submit"
                                        class="action delete"
                                        title="Delete Question"
                                        onclick="return confirm('Delete this question?')">

                                        🗑️

                                    </button>

                                </form>

                            </div>

                        </td>

                    </tr>

                <% }) %>

                </tbody>

            </table>

        </div>

    </div>

</div>

</body>
</html>