<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <title><%= title %></title>

    <link rel="stylesheet" href="/assets/styles.css">

</head>

<body>

<div class="container mx-auto p-10">

    <h1 class="text-3xl font-bold mb-6">

        Tambah Pertanyaan

    </h1>

    <form action="/question/create" method="POST">

        <div class="mb-4">

            <label>Pertanyaan</label>

            <textarea
                name="question_text"
                class="border w-full p-2"
                rows="5"
                required></textarea>

        </div>

        <div class="mb-4">

            <label>Tipe</label>

            <select
                name="type"
                class="border w-full p-2"
                required>

                <option value="text">
                    Text
                </option>

                <option value="radio">
                    Radio
                </option>

                <option value="checkbox">
                    Checkbox
                </option>

            </select>

        </div>

        <button 
         type="submit"
    class="btn">

    Simpan


        </button>

        <a href="/question" class="btn">

            Kembali

        </a>

    </form>

</div>

</body>

</html>