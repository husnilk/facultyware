      })();
    </script> -->

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %> - SIMPEL</title>
    <link rel="stylesheet" href="/assets/styles.css" />
  </head>
  <body>
    <script>
      (() => {
        document.addEventListener("DOMContentLoaded", () => {
          const sidebar = document.getElementById("sidebar");
          if (!sidebar) return;
          const updateCurrentLinks = () => {
            const currentPath = window.location.pathname.replace(/\/$/, "");
            sidebar.querySelectorAll("a, button").forEach((item) => {
              const href = item.getAttribute("href");
              if (!href) return item.removeAttribute("aria-current");
              const url = new URL(href, window.location.origin);
              if (url.pathname.replace(/\/$/, "") === currentPath) {
                item.setAttribute("aria-current", "page");
              } else {
                item.removeAttribute("aria-current");
              }
            });
          };
          updateCurrentLinks();
        });
      })();
    </script>
    <aside id="sidebar" class="sidebar group fixed inset-0 z-50 bg-black/40 transition-opacity duration-300 aria-[hidden=true]:opacity-0 aria-[hidden=true]:pointer-events-none md:relative md:inset-auto md:z-auto md:w-72 md:bg-transparent md:opacity-100 md:pointer-events-auto flex flex-col h-full" data-side="left" aria-hidden="true" data-breakpoint="768">
      <nav aria-label="Sidebar navigation" class="absolute inset-y-0 left-0 w-72 bg-background border-r transform transition-transform duration-300 ease-in-out group-aria-[hidden=true]:-translate-x-full md:relative md:translate-x-0 flex flex-col h-full">
        
        <header>
          <a href="/equipment-loans" class="btn-ghost p-2 h-12 w-full justify-start">
            <div class="bg-primary text-primary-foreground flex aspect-square size-8 items-center justify-center rounded-lg">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" class="h-4 w-4">
                <rect width="256" height="256" fill="none"></rect>
                <path d="M224,115.55V208a16,16,0,0,1-16,16H48a16,16,0,0,1-16-16V115.55a16,16,0,0,1,5.17-11.78l80-75.48.11-.11a16,16,0,0,1,21.53,0l.11.11,80,75.48A16,16,0,0,1,224,115.55Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></path>
              </svg>
            </div>
            <div class="grid flex-1 text-left text-sm leading-tight">
                <span class="truncate font-bold">SIMPEL</span>
                <span class="truncate text-xs">Peminjaman Peralatan</span>
            </div>
          </a>
        </header>

        <section class="scrollbar flex-1 overflow-y-auto">
          <div role="group" aria-labelledby="group-label-sidebar-content-1">
            <h3 id="group-label-sidebar-content-1">Menu Utama</h3>
            <ul>
              <li>
                <a href="/equipment-loans">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
                  <span>Daftar Peminjaman</span>
                </a>
              </li>
            </ul>
          </div>
        </section>

        <footer class="p-4 border-t mt-auto">
          <div class="flex items-center gap-3">
            
            <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
            </div>
            
            <div class="grid flex-1 text-left text-sm leading-tight">
              <span class="truncate font-semibold"><%= user.name %></span>
              <span class="truncate text-xs text-muted-foreground"><%= user.email %></span>
            </div>
            
            <a href="/logout" class="text-muted-foreground hover:text-destructive hover:bg-destructive/10 p-2 rounded-md transition-colors" title="Keluar">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                <polyline points="16 17 21 12 16 7"></polyline>
                <line x1="21" y1="12" x2="9" y2="12"></line>
              </svg>
            </a>

          </div>
        </footer>

      </nav>
    </aside>

    <main id="content">
      <header class="bg-background sticky inset-x-0 top-0 isolate flex shrink-0 items-center gap-2 border-b z-10">
        <div class="flex h-14 w-full items-center gap-2 px-4">
          <button type="button" onclick="document.dispatchEvent(new CustomEvent('basecoat:sidebar'))" class="btn-sm-icon-ghost mr-auto size-7 -ml-1.5 md:hidden">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M9 3v18"/></svg>
          </button>
          
          <!-- <select class="select h-8 leading-none" id="theme-select">
            <option value="">Default Theme</option>
            <option value="claude">Claude</option>
            <option value="supabase">Supabase</option>
          </select>
          <script>
            (() => {
              const themeSelect = document.getElementById("theme-select");
              const storedTheme = localStorage.getItem("themeVariant");
              if (themeSelect && storedTheme) themeSelect.value = storedTheme;
              themeSelect.addEventListener("change", () => {
                const newTheme = themeSelect.value;
                document.documentElement.classList.forEach((c) => {
                  if (c.startsWith("theme-")) document.documentElement.classList.remove(c);
                });
                if (newTheme) {
                  document.documentElement.classList.add(`theme-${newTheme}`);
                  localStorage.setItem("themeVariant", newTheme);
                } else {
                  localStorage.removeItem("themeVariant");
                }
              });
            })();
          </script> -->

          <button type="button" onclick="document.dispatchEvent(new CustomEvent('basecoat:theme'))" class="btn-icon-outline size-8">
            <span class="hidden dark:block"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg></span>
            <span class="block dark:hidden"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg></span>
          </button>
        </div>
      </header>

      <div class="p-4 md:p-6 xl:p-12 bg-muted min-h-[calc(100vh-3.5rem)]">
        <div class="max-w-6xl mx-auto flex flex-col gap-6">
          <div class="flex justify-between items-center">
            <div>
              <h1 class="text-3xl font-bold">Daftar Peminjaman</h1>
              <p class="text-muted-foreground mt-1">Kelola Pengajuan Peminjaman Peralatan di Sini.</p>
            </div>
            <a href="/equipment-loans/create" class="bg-primary text-primary-foreground px-4 py-2 rounded-md text-sm font-medium hover:bg-primary/90 transition-all shadow-sm">
              + Tambah Peminjaman
            </a>
          </div>

          <div class="bg-card text-card-foreground rounded-xl border shadow-sm overflow-hidden">
            <div class="overflow-x-auto">
              <table class="w-full text-sm text-left">
                <thead class="border-b bg-muted/50 font-medium">
                    <tr>
                        <th class="p-4">Kode Aset</th>
                        <th class="p-4">Nama Peralatan</th>
                        <th class="p-4">Tgl Mulai</th>
                        <th class="p-4">Tgl Selesai</th>
                        <th class="p-4">Status</th>
                        <th class="p-4 text-right">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                  <% if (data.length === 0) { %>
                    <tr>
                      <td colspan="6" class="p-8 text-center text-muted-foreground">No loan records found.</td>
                    </tr>
                  <% } else { %>
                    <% data.forEach(item => { %>
                      <tr class="border-b last:border-0 hover:bg-muted/50 transition-colors">
                        <td class="p-4 font-medium"><%= item.asset_code %></td>
                        <td class="p-4 font-medium"><%= item.equipment_name %></td>
                        <td class="p-4 text-muted-foreground"><%= new Date(item.start_date).toLocaleDateString('en-US') %></td>
                        <td class="p-4 text-muted-foreground"><%= item.end_date ? new Date(item.end_date).toLocaleDateString('en-US') : '-' %></td>
                        <td class="p-4">
                          <% let badgeColor = 
                              item.status === 'requested' ? 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900/30 dark:text-yellow-400' : 
                              item.status === 'approved' ? 'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400' : 
                              item.status === 'returned' ? 'bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-400' : 
                              item.status === 'cancelled' ? 'bg-gray-100 text-gray-800 dark:bg-gray-800/30 dark:text-gray-400' : 
                              'bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-400'; 
                            
                            const statusLabel = {
                              'requested': 'Diajukan',
                              'approved': 'Disetujui',
                              'returned': 'Dikembalikan',
                              'cancelled': 'Dibatalkan',
                              'rejected': 'Ditolak'
                            };
                          %>
                          <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold border border-transparent <%= badgeColor %>">
                            <%= (statusLabel[item.status] || item.status) %>
                          </span>
                        </td>
                        <td class="p-4 text-right flex justify-end gap-3">
                          <% if (item.status === 'requested') { %>
                            <a href="/equipment-loans/edit/<%= item.id %>" class="text-sm font-medium text-primary hover:underline">Edit</a>
                            <form action="/equipment-loans/cancel/<%= item.id %>" method="POST" class="inline">
                              <button type="submit" class="text-sm font-medium text-destructive hover:underline" onclick="return confirm('Are you sure you want to cancel this request?')">Cancel</button>
                            </form>
                          <% } else { %>
                            <span class="text-muted-foreground text-xs italic">Locked</span>
                          <% } %>
                        </td>
                      </tr>
                    <% }) %>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </main>

    <div id="toaster" class="toaster"></div>
    <script src="/assets/js/basecoat.js"></script>
    <script src="/assets/js/sidebar.js"></script>
  
  </body>
</html>