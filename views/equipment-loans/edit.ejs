<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %> - Facultyware</title>
    <link rel="stylesheet" href="/assets/styles.css" />
  </head>
  <body class="bg-background">
    <div class="flex min-h-svh flex-col items-center justify-center bg-muted p-6 md:p-10">
      
      <div class="w-full max-w-md">
        <div class="flex flex-col gap-6 rounded-xl border bg-card text-card-foreground shadow-sm p-6 md:p-8">
          
          <div class="flex flex-col items-center gap-2 text-center mb-2">
            <h1 class="text-2xl font-bold">Edit Request</h1>
            <p class="text-balance text-muted-foreground">
              Update your equipment loan details
            </p>
          </div>

          <form action="/equipment-loans/edit/<%= loan.id %>" method="POST" class="flex flex-col gap-5">
            <div class="flex flex-col gap-2">
              <label for="equipment_id" class="text-sm font-medium">Select Equipment</label>
              <select name="equipment_id" id="equipment_id" required class="h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-xs focus-visible:outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50">
                <% equipments.forEach(eq => { %>
                  <option value="<%= eq.id %>" <%= loan.equipment_id === eq.id ? 'selected' : '' %>>
                    <%= eq.asset_code %> - <%= eq.equipment_name %>
                  </option>
                <% }) %>
              </select>
            </div>

            <div class="grid grid-cols-2 gap-4">
              <div class="flex flex-col gap-2">
                <label for="start_date" class="text-sm font-medium">Start Date</label>
                <input type="date" name="start_date" id="start_date" value="<%= new Date(loan.start_date).toISOString().split('T')[0] %>" required class="h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-xs focus-visible:outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50">
              </div>
              <div class="flex flex-col gap-2">
                <label for="end_date" class="text-sm font-medium">End Date</label>
                <input type="date" name="end_date" id="end_date" value="<%= loan.end_date ? new Date(loan.end_date).toISOString().split('T')[0] : '' %>" required class="h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-xs focus-visible:outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50">
              </div>
            </div>

            <div class="flex gap-3 mt-4">
              <a href="/equipment-loans" class="flex-1 inline-flex items-center justify-center h-9 px-4 py-2 rounded-md border border-input bg-background text-sm font-medium hover:bg-accent hover:text-accent-foreground transition-colors">
                Cancel
              </a>
              <button type="submit" class="flex-1 h-9 px-4 py-2 rounded-md bg-primary text-primary-foreground text-sm font-medium hover:bg-primary/90 shadow-sm transition-colors">
                Update Request
              </button>
            </div>
          </form>

        </div>
      </div>
    </div>
  </body>
</html>