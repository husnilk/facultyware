<%
  const safeForm = typeof form !== "undefined" && form ? form : {};

  const ticketValue =
    safeForm.ticket_number ||
    safeForm.ticketNumber ||
    safeForm.peserta_id ||
    (typeof ticket_number !== "undefined" ? ticket_number : "") ||
    (typeof ticketNumber !== "undefined" ? ticketNumber : "") ||
    "";

  const safeResult =
    typeof result !== "undefined"
      ? result
      : typeof checkinResult !== "undefined"
        ? checkinResult
        : null;

  const isObjectResult = safeResult && typeof safeResult === "object";

  const resultMessage =
    typeof safeResult === "string"
      ? safeResult
      : isObjectResult
        ? (safeResult.message || safeResult.status_message || "")
        : "";

  const getValue = (key, fallback = "-") => {
    if (!isObjectResult) return fallback;
    return safeResult[key] || fallback;
  };

  const formatDate = (value) => {
    if (!value) return "-";
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return value;

    return date.toLocaleString("id-ID", {
      day: "numeric",
      month: "short",
      year: "numeric",
      hour: "2-digit",
      minute: "2-digit"
    });
  };
%>

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title><%= typeof title !== "undefined" ? title : "Check-in Peserta" %> - Facultyware</title>

    <link rel="stylesheet" href="/assets/styles.css" />

    <script src="https://unpkg.com/htmx.org@2.0.4"></script>

    <script>
      (() => {
        try {
          if (
            localStorage.getItem("themeMode") === "dark" ||
            (!localStorage.getItem("themeMode") &&
              matchMedia("(prefers-color-scheme: dark)").matches)
          ) {
            document.documentElement.classList.add("dark");
          }
        } catch (_) {}
      })();
    </script>

    <script>
      (function () {
        try {
          const storedTheme = localStorage.getItem("themeVariant");
          if (storedTheme) {
            document.documentElement.classList.add(`theme-${storedTheme}`);
          }
        } catch (event) {
          console.error("Could not apply theme variant", event);
        }
      })();
    </script>

    <style>
      @media (min-width: 1024px) {
        .checkin-grid {
          display: grid;
          grid-template-columns: minmax(0, 1.25fr) minmax(280px, 0.75fr);
          gap: 1.5rem;
          align-items: start;
        }
      }

      .checkin-step {
        display: flex;
        gap: 0.75rem;
        align-items: flex-start;
      }

      .checkin-step-number {
        width: 1.75rem;
        height: 1.75rem;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.75rem;
        font-weight: 700;
        background: var(--muted);
        color: var(--foreground);
        border: 1px solid var(--border);
        flex-shrink: 0;
      }
    </style>
  </head>

  <body class="bg-background text-foreground antialiased p-6 md:p-10">
    <div class="max-w-5xl mx-auto space-y-6">
      <header class="flex justify-between items-center pb-6 border-b border-border">
        <div class="flex items-center gap-2">
          <span class="font-bold text-xl tracking-tight">Facultyware</span>
          <span class="text-xs text-muted-foreground bg-muted px-2 py-0.5 rounded">Check-in</span>
        </div>

        <nav class="flex gap-4 items-center">
          <a href="/home" class="text-sm font-medium hover:underline">Dashboard</a>
          <a href="/reminders" class="text-sm font-medium hover:underline">Reminder</a>
          <a href="/attendances" class="text-sm font-medium hover:underline">Attendance</a>
          <a href="/attendances/recap" class="text-sm font-medium hover:underline">Rekap</a>

          <% if (typeof user !== "undefined" && user) { %>
            <span class="text-sm text-muted-foreground">Halo, <strong><%= user %></strong></span>
          <% } else { %>
            <a href="/login" class="text-sm font-medium hover:underline">Login</a>
          <% } %>
        </nav>
      </header>

      <main class="space-y-6">
        <div class="flex items-center justify-between">
          <div>
            <h1 class="text-3xl font-bold tracking-tight">Check-in Peserta</h1>
            <p class="text-muted-foreground text-sm mt-2">
              Masukkan nomor tiket peserta untuk melakukan verifikasi dan pencatatan kehadiran.
            </p>
          </div>

          <a
            href="/attendances"
            class="inline-flex items-center justify-center rounded-md text-sm font-medium border border-input bg-background hover:bg-accent hover:text-accent-foreground h-10 px-4 py-2"
          >
            Lihat Attendance
          </a>
        </div>

        <% if (typeof success !== "undefined" && success) { %>
          <div class="rounded-md border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-700">
            <%= success %>
          </div>
        <% } %>

        <% if (typeof error !== "undefined" && error) { %>
          <div class="rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
            <%= error %>
          </div>
        <% } %>

        <% if (resultMessage) { %>
          <div class="rounded-md border border-border bg-muted px-4 py-3 text-sm text-muted-foreground">
            <%= resultMessage %>
          </div>
        <% } %>

        <div class="checkin-grid space-y-6 lg:space-y-0">
          <div data-slot="card" class="rounded-xl border border-border bg-card text-card-foreground shadow-md">
            <div class="p-6 border-b border-border">
              <h2 class="text-xl font-bold tracking-tight">Form Check-in</h2>
              <p class="text-sm text-muted-foreground mt-1">
                Gunakan nomor tiket dari e-ticket peserta atau ID peserta sesuai data registrasi.
              </p>
            </div>

            <form action="/checkins/process" method="POST" class="p-6 space-y-5" id="checkinForm">
              <div class="space-y-2">
                <label for="ticket_number" class="text-sm font-medium">Nomor Tiket / ID Peserta</label>

                <input
                  type="text"
                  id="ticket_number"
                  name="ticket_number"
                  value="<%= ticketValue %>"
                  placeholder="Contoh: TICKET-001 atau 1"
                  required
                  class="w-full h-10 rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-xs transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
                />

                <input type="hidden" id="ticketNumberHidden" name="ticketNumber" value="<%= ticketValue %>" />
                <input type="hidden" id="pesertaIdHidden" name="peserta_id" value="<%= ticketValue %>" />

                <p class="text-xs text-muted-foreground">
                  Input ini mendukung <strong>ticket_number</strong>, <strong>ticketNumber</strong>, dan <strong>peserta_id</strong>.
                </p>
              </div>

              <div class="flex justify-end gap-3 pt-2">
                <a
                  href="/home"
                  class="inline-flex items-center justify-center rounded-md text-sm font-medium border border-input bg-background hover:bg-accent hover:text-accent-foreground h-10 px-4 py-2"
                >
                  Kembali
                </a>

                <button
                  type="submit"
                  class="inline-flex items-center justify-center rounded-md text-sm font-medium bg-primary text-primary-foreground h-10 px-4 py-2 hover:bg-primary/90 transition-colors"
                >
                  Proses Check-in
                </button>
              </div>
            </form>
          </div>

          <aside data-slot="card" class="rounded-xl border border-border bg-card text-card-foreground shadow-md">
            <div class="p-6 border-b border-border">
              <h2 class="text-xl font-bold tracking-tight">Panduan Singkat</h2>
              <p class="text-sm text-muted-foreground mt-1">
                Alur check-in peserta pada sistem.
              </p>
            </div>

            <div class="p-6 space-y-5">
              <div class="checkin-step">
                <div class="checkin-step-number">1</div>
                <div>
                  <h3 class="text-sm font-semibold">Input Nomor Tiket</h3>
                  <p class="text-sm text-muted-foreground mt-1">
                    Masukkan ticket number dari e-ticket peserta.
                  </p>
                </div>
              </div>

              <div class="checkin-step">
                <div class="checkin-step-number">2</div>
                <div>
                  <h3 class="text-sm font-semibold">Sistem Validasi</h3>
                  <p class="text-sm text-muted-foreground mt-1">
                    Sistem mengecek apakah tiket terdaftar dan valid.
                  </p>
                </div>
              </div>

              <div class="checkin-step">
                <div class="checkin-step-number">3</div>
                <div>
                  <h3 class="text-sm font-semibold">Attendance Tercatat</h3>
                  <p class="text-sm text-muted-foreground mt-1">
                    Jika valid, data kehadiran peserta akan disimpan.
                  </p>
                </div>
              </div>

              <div class="rounded-md border border-border bg-muted px-4 py-3 text-sm text-muted-foreground">
                Setelah check-in berhasil, data dapat dilihat pada halaman Attendance List.
              </div>
            </div>
          </aside>
        </div>

        <div data-slot="card" class="rounded-xl border border-border bg-card text-card-foreground shadow-md overflow-hidden">
  <div class="p-6 border-b border-border flex items-center justify-between gap-4">
    <div>
      <h2 class="text-xl font-bold tracking-tight">Shortcut Attendance</h2>
      <p class="text-sm text-muted-foreground mt-1">
        Akses cepat untuk melihat hasil check-in, rekap kehadiran, dan export data.
      </p>
    </div>
  </div>

  <div class="p-6">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <a
        href="/attendances"
        class="rounded-xl border border-border bg-background p-4 hover:bg-accent transition-colors"
      >
        <div class="text-sm font-bold">Attendance List</div>
        <p class="text-sm text-muted-foreground mt-1">
          Lihat daftar peserta yang sudah melakukan check-in.
        </p>
        <div class="mt-4 inline-flex items-center justify-center rounded-md text-sm font-medium bg-primary text-primary-foreground h-9 px-3">
          Buka Attendance
        </div>
      </a>

      <a
        href="/attendances/recap"
        class="rounded-xl border border-border bg-background p-4 hover:bg-accent transition-colors"
      >
        <div class="text-sm font-bold">Rekap Attendance</div>
        <p class="text-sm text-muted-foreground mt-1">
          Lihat ringkasan peserta hadir, partial, dan no show.
        </p>
        <div class="mt-4 inline-flex items-center justify-center rounded-md text-sm font-medium border border-input bg-background h-9 px-3">
          Lihat Rekap
        </div>
      </a>

      <a
        href="/attendances/export/excel"
        class="rounded-xl border border-border bg-background p-4 hover:bg-accent transition-colors"
      >
        <div class="text-sm font-bold">Export Excel</div>
        <p class="text-sm text-muted-foreground mt-1">
          Unduh data attendance untuk kebutuhan laporan.
        </p>
        <div class="mt-4 inline-flex items-center justify-center rounded-md text-sm font-medium bg-primary text-primary-foreground h-9 px-3">
          Export Data
        </div>
      </a>
    </div>
  </div>
</div>

        <% if (isObjectResult) { %>
          <div data-slot="card" class="rounded-xl border border-border bg-card text-card-foreground shadow-md overflow-hidden">
            <div class="p-6 border-b border-border">
              <h2 class="text-xl font-bold tracking-tight">Hasil Verifikasi</h2>
              <p class="text-sm text-muted-foreground mt-1">
                Informasi peserta berdasarkan tiket yang diproses.
              </p>
            </div>

            <div class="p-6">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
                <div class="rounded-md border border-border p-4">
                  <p class="text-muted-foreground mb-1">Nama Peserta</p>
                  <p class="font-semibold">
                    <%= getValue("participant_name", getValue("nama", getValue("name"))) %>
                  </p>
                </div>

                <div class="rounded-md border border-border p-4">
                  <p class="text-muted-foreground mb-1">Email</p>
                  <p class="font-semibold">
                    <%= getValue("participant_email", getValue("email")) %>
                  </p>
                </div>

                <div class="rounded-md border border-border p-4">
                  <p class="text-muted-foreground mb-1">Event</p>
                  <p class="font-semibold">
                    <%= getValue("event_title", getValue("event_name", getValue("title"))) %>
                  </p>
                </div>

                <div class="rounded-md border border-border p-4">
                  <p class="text-muted-foreground mb-1">Nomor Tiket</p>
                  <p class="font-semibold">
                    <%= getValue("ticket_number", getValue("ticketNumber")) %>
                  </p>
                </div>

                <div class="rounded-md border border-border p-4">
                  <p class="text-muted-foreground mb-1">Status</p>
                  <p class="font-semibold">
                    <%= getValue("status", getValue("attendance_status", "Check-in Diproses")) %>
                  </p>
                </div>

                <div class="rounded-md border border-border p-4">
                  <p class="text-muted-foreground mb-1">Waktu Check-in</p>
                  <p class="font-semibold">
                    <%= formatDate(getValue("checked_in_at", getValue("created_at", ""))) %>
                  </p>
                </div>
              </div>
            </div>
          </div>
        <% } %>
      </main>
    </div>

    <script>
      const input = document.getElementById("ticket_number");
      const ticketNumberHidden = document.getElementById("ticketNumberHidden");
      const pesertaIdHidden = document.getElementById("pesertaIdHidden");

      function syncCheckinValue() {
        const value = input.value.trim();
        ticketNumberHidden.value = value;
        pesertaIdHidden.value = value;
      }

      input.addEventListener("input", syncCheckinValue);
      document.getElementById("checkinForm").addEventListener("submit", syncCheckinValue);
    </script>
  </body>
</html>