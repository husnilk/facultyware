<div class="p-4 md:p-6 xl:p-12">
  <div class="max-w-screen-lg mx-auto flex flex-col gap-8">
    <header class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div class="flex flex-col gap-2">
        <div class="flex items-center gap-2">
           <a href="/users" class="btn-icon-sm-ghost" title="Back to list">
             <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
           </a>
           <h1 class="text-2xl font-bold tracking-tight sm:text-3xl"><%= userRecord.fullname || userRecord.username %></h1>
        </div>
        <p class="text-muted-foreground ml-8">User profile and assigned roles.</p>
      </div>
      <div class="flex gap-2">
        <% if (userRecord.active !== 0) { %>
          <form action="/users/<%= userRecord.id %>/status" method="POST" hx-boost="true" hx-target="#content" hx-select="#content">
            <input type="hidden" name="status" value="0">
            <button type="submit" class="btn-outline text-destructive hover:bg-destructive/10">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><line x1="9" x2="15" y1="9" y2="15"/><line x1="15" x2="9" y1="9" y2="15"/></svg>
              Deactivate
            </button>
          </form>
        <% } else { %>
          <form action="/users/<%= userRecord.id %>/status" method="POST" hx-boost="true" hx-target="#content" hx-select="#content">
            <input type="hidden" name="status" value="1">
            <button type="submit" class="btn-outline text-primary hover:bg-primary/10">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              Activate
            </button>
          </form>
        <% } %>
        <a href="/users/<%= userRecord.id %>/edit" class="btn">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
          Edit User
        </a>
      </div>
    </header>

    <div class="grid gap-6">
      <div class="card">
        <header class="flex items-center justify-between">
          <h2>Account Information</h2>
          <span class="badge <%= userRecord.active !== 0 ? 'bg-primary/10 text-primary' : 'bg-destructive/10 text-destructive' %> border-transparent">
            <%= userRecord.active !== 0 ? 'Active' : 'Inactive' %>
          </span>
        </header>
        <section class="grid sm:grid-cols-2 gap-8 py-4">
          <div class="flex flex-col gap-1">
            <span class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Username</span>
            <span class="text-sm font-medium">@<%= userRecord.username %></span>
          </div>
          <div class="flex flex-col gap-1">
            <span class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Email Address</span>
            <span class="text-sm"><%= userRecord.email || 'N/A' %></span>
          </div>
          <div class="flex flex-col gap-1">
            <span class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Full Name</span>
            <span class="text-sm"><%= userRecord.fullname || 'N/A' %></span>
          </div>
          <div class="flex flex-col gap-1">
            <span class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Member Since</span>
            <span class="text-sm"><%= new Date(userRecord.created_at).toLocaleDateString() %></span>
          </div>
          <div class="flex flex-col gap-1 sm:col-span-2">
            <span class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Assigned Roles</span>
            <div class="flex flex-wrap gap-1.5 mt-1">
              <% if (userRecord.roles) { %>
                <% userRecord.roles.split(',').forEach(role => { %>
                  <span class="badge badge-outline"><%= role %></span>
                <% }) %>
              <% } else { %>
                <span class="text-sm text-muted-foreground italic">No roles assigned.</span>
              <% } %>
            </div>
          </div>
        </section>
      </div>
    </div>
  </div>
</div>
