<div class="p-4 md:p-6 xl:p-12">
  <div class="max-w-screen-xl mx-auto flex flex-col gap-8">
    <header class="flex items-center justify-between gap-4">
      <div class="flex flex-col gap-2">
        <h1 class="text-2xl font-bold tracking-tight sm:text-3xl md:text-4xl">
          Role Management
        </h1>
        <p class="sm:text-lg text-muted-foreground">
          Define user roles and view their assigned permissions.
        </p>
      </div>
      <div class="flex gap-2">
        <a href="/acl/permissions" class="btn-outline">
          Manage Permissions
        </a>
        <a href="/acl/roles/new" class="btn">
          Add Role
        </a>
      </div>
    </header>

    <div class="grid gap-6">
      <% roles.forEach(role => { %>
        <div class="card bg-muted/30 border-dashed" id="role-<%= role.id %>">
          <header class="flex items-center justify-between py-2">
            <div class="flex flex-col gap-1">
              <h3 class="font-semibold text-lg"><%= role.name %></h3>
              <div class="flex flex-wrap gap-1.5">
                <% if (role.permissions && role.permissions.length > 0) { %>
                  <% role.permissions.forEach(permName => { %>
                    <span class="badge bg-secondary text-secondary-foreground border-transparent"><%= permName %></span>
                  <% }) %>
                <% } else { %>
                  <span class="text-xs text-muted-foreground italic">No permissions assigned.</span>
                <% } %>
              </div>
            </div>
            <div class="flex gap-2">
              <a 
                href="/acl/roles/<%= role.id %>/edit" 
                class="btn-icon-sm"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-pencil"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
              </a>
              <button 
                class="btn-icon-sm text-destructive"
                hx-delete="/acl/roles/<%= role.id %>"
                hx-target="#role-<%= role.id %>"
                hx-swap="outerHTML"
                hx-confirm="Are you sure you want to delete this role?"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash-2"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" x2="10" y1="11" y2="17"/><line x1="14" x2="14" y1="11" y2="17"/></svg>
              </button>
            </div>
          </header>
        </div>
      <% }) %>
    </div>
  </div>
</div>
