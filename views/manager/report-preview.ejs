<!doctype html>
<html lang="id">
  <head>
    <script>
      (() => {
        try {
          const stored = localStorage.getItem("themeMode");
          if (stored ? stored === "dark" : matchMedia("(prefers-color-scheme: dark)").matches) {
            document.documentElement.classList.add("dark");
          }
        } catch (_) {}
        document.addEventListener("basecoat:theme", (event) => {
          const mode = event.detail?.mode;
          const dark = mode === "dark" ? true : mode === "light" ? false : !document.documentElement.classList.contains("dark");
          document.documentElement.classList.toggle("dark", dark);
          try { localStorage.setItem("themeMode", dark ? "dark" : "light"); } catch (_) {}
        });
      })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %> - SIMPEL</title>
    <link rel="stylesheet" href="/assets/styles.css" />
    <style>
      @media print {
        #sidebar, header, .no-print { display: none !important; }
        #content { margin: 0 !important; }
        .print-area { padding: 0 !important; }
      }
    </style>
  </head>
  <body>
    <aside id="sidebar" class="sidebar" data-side="left" aria-hidden="false">
      <nav aria-label="Sidebar navigation">
        <header>
          <a href="/manager" class="btn-ghost p-2 h-12 w-full justify-start">
            <div class="bg-primary text-primary-foreground flex aspect-square size-8 items-center justify-center rounded-lg">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" class="h-4 w-4">
                <rect width="256" height="256" fill="none"></rect>
                <path d="M224,115.55V208a16,16,0,0,1-16,16H48a16,16,0,0,1-16-16V115.55a16,16,0,0,1,5.17-11.78l80-75.48.11-.11a16,16,0,0,1,21.53,0l.11.11,80,75.48A16,16,0,0,1,224,115.55Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></path>
              </svg>
            </div>
            <div class="grid flex-1 text-left text-sm leading-tight">
              <span class="truncate font-bold">SIMPEL</span>
              <span class="truncate text-xs">Penanggung Jawab</span>
            </div>
          </a>
        </header>
        <section class="scrollbar">
          <div role="group" aria-labelledby="group-label-manager-menu">
            <h3 id="group-label-manager-menu">Menu Utama</h3>
            <ul>
              <li>
                <a href="/manager">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                  <span>Riwayat Peminjaman</span>
                </a>
              </li>
            </ul>
          </div>
          <div role="group" class="mt-8">
            <ul>
              <li>
                <a href="/logout" class="text-destructive hover:bg-destructive/10">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                  <span>Logout</span>
                </a>
              </li>
            </ul>
          </div>
        </section>
      </nav>
    </aside>

    <main id="content">
      <header class="bg-background sticky inset-x-0 top-0 isolate flex shrink-0 items-center gap-2 border-b z-10 no-print">
        <div class="flex h-14 w-full items-center gap-2 px-4">
          <button type="button" onclick="document.dispatchEvent(new CustomEvent('basecoat:sidebar'))" class="btn-sm-icon-ghost mr-auto size-7 -ml-1.5 md:hidden">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M9 3v18"/></svg>
          </button>
          <button type="button" onclick="document.dispatchEvent(new CustomEvent('basecoat:theme'))" class="btn-icon-outline size-8 ml-auto">
            <span class="hidden dark:block"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg></span>
            <span class="block dark:hidden"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg></span>
          </button>
        </div>
      </header>

      <div class="p-4 md:p-6 xl:p-12 bg-muted min-h-[calc(100vh-3.5rem)] print-area">
        <div class="max-w-6xl mx-auto flex flex-col gap-6">

          <!-- Action bar (hidden on print) -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 no-print">
            <div>
              <h1 class="text-3xl font-bold">Preview Laporan</h1>
              <p class="text-muted-foreground mt-1">Tinjau laporan sebelum diexport ke PDF.</p>
            </div>
            <div class="flex gap-2">
              <a href="/manager<%= Object.keys(filters).length ? '?' + new URLSearchParams(filters).toString() : '' %>"
                 class="inline-flex items-center gap-2 border border-input bg-background px-4 py-2 rounded-md text-sm font-medium hover:bg-accent transition-all">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
                Kembali
              </a>
              <a href="/manager/report/export<%= Object.keys(filters).length ? '?' + new URLSearchParams(filters).toString() : '' %>"
                 class="inline-flex items-center gap-2 bg-primary text-primary-foreground px-4 py-2 rounded-md text-sm font-medium hover:bg-primary/90 transition-all shadow-sm">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                Export PDF
              </a>
            </div>
          </div>

          <!-- Filter summary (no-print) -->
          <% const hasFilters = Object.values(filters).some(v => v); %>
          <% if (hasFilters) { %>
            <div class="no-print flex flex-wrap gap-2 items-center text-sm">
              <span class="text-muted-foreground">Filter aktif:</span>
              <% if (filters.search) { %>
                <span class="px-2.5 py-0.5 rounded-full bg-secondary text-secondary-foreground text-xs font-medium">Pencarian: "<%= filters.search %>"</span>
              <% } %>
              <% if (filters.status) { %>
                <% const sl = { requested: 'Diminta', approved: 'Disetujui', returned: 'Dikembalikan', rejected: 'Ditolak' }; %>
                <span class="px-2.5 py-0.5 rounded-full bg-secondary text-secondary-foreground text-xs font-medium">Status: <%= sl[filters.status] || filters.status %></span>
              <% } %>
              <% if (filters.date_from) { %>
                <span class="px-2.5 py-0.5 rounded-full bg-secondary text-secondary-foreground text-xs font-medium">Dari: <%= filters.date_from %></span>
              <% } %>
              <% if (filters.date_to) { %>
                <span class="px-2.5 py-0.5 rounded-full bg-secondary text-secondary-foreground text-xs font-medium">Sampai: <%= filters.date_to %></span>
              <% } %>
            </div>
          <% } %>

          <!-- Report document -->
          <div class="bg-white text-gray-900 rounded-xl border shadow-sm overflow-hidden">
            <!-- Report header -->
            <div class="px-8 py-6 border-b text-center">
              <h2 class="text-xl font-bold text-gray-900">SIMPEL – Laporan Riwayat Peminjaman Peralatan</h2>
              <p class="text-sm text-gray-500 mt-1">Dicetak pada: <%= generatedAt %></p>
              <% if (hasFilters) { %>
                <p class="text-xs text-gray-400 mt-1">
                  Filter:
                  <% if (filters.search)    { %> Pencarian "<%= filters.search %>" <% } %>
                  <% if (filters.status)    { %> | Status: <%= filters.status %> <% } %>
                  <% if (filters.date_from) { %> | Dari: <%= filters.date_from %> <% } %>
                  <% if (filters.date_to)   { %> | Sampai: <%= filters.date_to %> <% } %>
                </p>
              <% } %>
            </div>

            <!-- Table -->
            <div class="overflow-x-auto">
              <table class="w-full text-sm text-left">
                <thead class="bg-gray-100 border-b">
                  <tr>
                    <th class="px-4 py-3 font-semibold text-gray-700">No</th>
                    <th class="px-4 py-3 font-semibold text-gray-700">Kode Aset</th>
                    <th class="px-4 py-3 font-semibold text-gray-700">Nama Peralatan</th>
                    <th class="px-4 py-3 font-semibold text-gray-700">Peminjam</th>
                    <th class="px-4 py-3 font-semibold text-gray-700">Tgl Mulai</th>
                    <th class="px-4 py-3 font-semibold text-gray-700">Tgl Selesai</th>
                    <th class="px-4 py-3 font-semibold text-gray-700">Status</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (data.length === 0) { %>
                    <tr>
                      <td colspan="7" class="px-4 py-8 text-center text-gray-400">Tidak ada data peminjaman.</td>
                    </tr>
                  <% } else { %>
                    <% data.forEach((item, idx) => { %>
                      <%
                        const statusLabel = { requested: 'Diminta', approved: 'Disetujui', returned: 'Dikembalikan', rejected: 'Ditolak' };
                        const statusStyle =
                          item.status === 'requested' ? 'background:#fef9c3;color:#854d0e' :
                          item.status === 'approved'  ? 'background:#dcfce7;color:#166534' :
                          item.status === 'returned'  ? 'background:#dbeafe;color:#1e40af' :
                          'background:#fee2e2;color:#991b1b';
                      %>
                      <tr class="border-b last:border-0 <%= idx % 2 === 1 ? 'bg-gray-50' : '' %>">
                        <td class="px-4 py-3 text-gray-500"><%= idx + 1 %></td>
                        <td class="px-4 py-3 font-medium"><%= item.asset_code %></td>
                        <td class="px-4 py-3"><%= item.equipment_name %></td>
                        <td class="px-4 py-3"><%= item.employee_name %></td>
                        <td class="px-4 py-3"><%= new Date(item.start_date).toLocaleDateString('id-ID') %></td>
                        <td class="px-4 py-3"><%= item.end_date ? new Date(item.end_date).toLocaleDateString('id-ID') : '-' %></td>
                        <td class="px-4 py-3">
                          <span style="<%= statusStyle %>" class="px-2 py-0.5 rounded-full text-xs font-semibold">
                            <%= statusLabel[item.status] || item.status %>
                          </span>
                        </td>
                      </tr>
                    <% }) %>
                  <% } %>
                </tbody>
              </table>
            </div>

            <!-- Footer summary -->
            <div class="px-8 py-4 border-t bg-gray-50 flex justify-between items-center text-sm text-gray-600">
              <span>Total: <strong><%= data.length %></strong> data peminjaman</span>
              <span class="text-xs text-gray-400">SIMPEL – Equipment Loan Management</span>
            </div>
          </div>

        </div>
      </div>
    </main>

    <div id="toaster" class="toaster"></div>
    <script src="/assets/js/basecoat.js"></script>
    <script src="/assets/js/sidebar.js"></script>
  </body>
</html>
