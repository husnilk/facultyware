<!doctype html>
<html lang="id">
  <head>
    <script>
      (() => {
        try {
          const stored = localStorage.getItem("themeMode");
          if (stored ? stored === "dark" : matchMedia("(prefers-color-scheme: dark)").matches) {
            document.documentElement.classList.add("dark");
          }
        } catch (_) {}
        const apply = (dark) => {
          document.documentElement.classList.toggle("dark", dark);
          try { localStorage.setItem("themeMode", dark ? "dark" : "light"); } catch (_) {}
        };
        document.addEventListener("basecoat:theme", (event) => {
          const mode = event.detail?.mode;
          apply(mode === "dark" ? true : mode === "light" ? false : !document.documentElement.classList.contains("dark"));
        });
      })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %> - SIMPEL</title>
    <link rel="stylesheet" href="/assets/styles.css" />
  </head>
  <body>
    <!-- Sidebar active-link highlight -->
    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const sidebar = document.getElementById("sidebar");
        if (!sidebar) return;
        const currentPath = window.location.pathname.replace(/\/$/, "");
        sidebar.querySelectorAll("a").forEach((a) => {
          const href = a.getAttribute("href");
          if (!href) return;
          const url = new URL(href, window.location.origin);
          if (url.pathname.replace(/\/$/, "") === currentPath) {
            a.setAttribute("aria-current", "page");
          } else {
            a.removeAttribute("aria-current");
          }
        });
      });
    </script>

    <aside id="sidebar" class="sidebar" data-side="left" aria-hidden="false">
      <nav aria-label="Sidebar navigation">
        <header>
          <a href="/manager/ongoing" class="btn-ghost p-2 h-12 w-full justify-start">
            <div class="bg-primary text-primary-foreground flex aspect-square size-8 items-center justify-center rounded-lg">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" class="h-4 w-4">
                <rect width="256" height="256" fill="none"></rect>
                <path d="M224,115.55V208a16,16,0,0,1-16,16H48a16,16,0,0,1-16-16V115.55a16,16,0,0,1,5.17-11.78l80-75.48.11-.11a16,16,0,0,1,21.53,0l.11.11,80,75.48A16,16,0,0,1,224,115.55Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="24"></path>
              </svg>
            </div>
            <div class="grid flex-1 text-left text-sm leading-tight">
              <span class="truncate font-bold">SIMPEL</span>
              <span class="truncate text-xs">Penanggung Jawab</span>
            </div>
          </a>
        </header>

        <section class="scrollbar">
          <div role="group" aria-labelledby="group-label-manager-menu">
            <h3 id="group-label-manager-menu">Menu Utama</h3>
            <ul>
              <li>
                <a href="/manager/ongoing">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/></svg>
                  <span>Peminjaman yang Sedang Berlangsung</span>
                  <span id="badge-requested" style="display:none;margin-left:auto;background-color:#f59e0b;color:#ffffff;font-size:11px;font-weight:700;padding:2px 6px;border-radius:999px;white-space:nowrap;"></span>
                </a>
              </li>
              <li>
                <a href="/manager">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                  <span>Riwayat Peminjaman</span>
                </a>
              </li>
            </ul>
          </div>

          <div role="group" class="mt-8">
            <ul>
              <li>
                <a href="/logout" class="text-destructive hover:bg-destructive/10">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                  <span>Logout</span>
                </a>
              </li>
            </ul>
          </div>
        </section>
      </nav>
    </aside>

    <main id="content">
      <header class="bg-background sticky inset-x-0 top-0 isolate flex shrink-0 items-center gap-2 border-b z-10">
        <div class="flex h-14 w-full items-center gap-2 px-4">
          <button type="button" onclick="document.dispatchEvent(new CustomEvent('basecoat:sidebar'))" class="btn-sm-icon-ghost mr-auto size-7 -ml-1.5 md:hidden">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M9 3v18"/></svg>
          </button>
          <button type="button" onclick="document.dispatchEvent(new CustomEvent('basecoat:theme'))" class="btn-icon-outline size-8 ml-auto">
            <span class="hidden dark:block"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg></span>
            <span class="block dark:hidden"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg></span>
          </button>
        </div>
      </header>

      <div class="p-4 md:p-6 xl:p-12 bg-muted min-h-[calc(100vh-3.5rem)]">
        <div class="max-w-6xl mx-auto flex flex-col gap-6">

          <!-- Page title -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
              <h1 class="text-3xl font-bold">Peminjaman yang Sedang Berlangsung</h1>
              <p class="text-muted-foreground mt-1">Kelola dan setujui permintaan peminjaman peralatan.</p>
            </div>
            <!-- Card jumlah permintaan masuk -->
            <div id="card-requested" style="display:none;" class="flex items-center gap-2 bg-white dark:bg-zinc-800 border border-amber-300 dark:border-amber-600 rounded-lg px-3 py-2 shadow-sm">
              <div style="background-color:#f59e0b;border-radius:50%;width:30px;height:30px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/><line x1="6" y1="1" x2="6" y2="4"/><line x1="10" y1="1" x2="10" y2="4"/><line x1="14" y1="1" x2="14" y2="4"/></svg>
              </div>
              <div>
                <p style="font-size:11px;font-weight:500;color:#d97706;margin:0;">Menunggu Persetujuan</p>
                <p id="count-requested" style="font-size:20px;font-weight:700;color:#f59e0b;margin:0;line-height:1.1;">-</p>
              </div>
            </div>
            <div class="flex gap-2">
              <a href="/manager/ongoing/export<%= Object.keys(filters).length ? '?' + new URLSearchParams(filters).toString() : '' %>"
                 class="inline-flex items-center gap-2 bg-primary text-primary-foreground px-4 py-2 rounded-md text-sm font-medium hover:bg-primary/90 transition-all shadow-sm">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                Export PDF
              </a>
            </div>
          </div>

          <!-- Search & Filter -->
          <form method="GET" action="/manager/ongoing" class="bg-card border rounded-xl p-4 shadow-sm flex flex-col gap-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
              <div class="flex flex-col gap-1.5 sm:col-span-2 lg:col-span-4">
                <label class="text-xs font-medium text-muted-foreground">Pencarian</label>
                <input
                  type="text"
                  name="search"
                  value="<%= filters.search || '' %>"
                  placeholder="Cari kode aset, nama peralatan, atau peminjam…"
                  class="h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-xs focus-visible:outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50"
                />
              </div>
              <div class="flex flex-col gap-1.5">
                <label for="filter-status" class="text-xs font-medium text-muted-foreground">Status</label>
                <select id="filter-status" name="status" class="h-9 rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-xs focus-visible:outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50">
                  <option value="">Semua Status</option>
                  <option value="requested" <%= filters.status === 'requested' ? 'selected' : '' %>>Diminta</option>
                  <option value="approved"  <%= filters.status === 'approved'  ? 'selected' : '' %>>Disetujui</option>
                </select>
              </div>
              <div class="flex flex-col gap-1.5">
                <label for="filter-date-from" class="text-xs font-medium text-muted-foreground">Tanggal Mulai</label>
                <input id="filter-date-from" type="date" name="date_from" value="<%= filters.date_from || '' %>"
                  class="h-9 rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-xs focus-visible:outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50" />
              </div>
              <div class="flex flex-col gap-1.5">
                <label for="filter-date-to" class="text-xs font-medium text-muted-foreground">Tanggal Selesai</label>
                <input id="filter-date-to" type="date" name="date_to" value="<%= filters.date_to || '' %>"
                  class="h-9 rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-xs focus-visible:outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50" />
              </div>
              <div class="flex items-end gap-2">
                <button type="submit" class="h-9 px-4 rounded-md bg-primary text-primary-foreground text-sm font-medium hover:bg-primary/90 shadow-sm transition-colors">
                  Filter
                </button>
                <% if (Object.values(filters).some(v => v)) { %>
                  <a href="/manager/ongoing" class="h-9 px-4 inline-flex items-center rounded-md border border-input bg-background text-sm font-medium hover:bg-accent transition-colors">
                    Reset
                  </a>
                <% } %>
              </div>
            </div>
          </form>

          <!-- Table -->
          <!-- Form bulk cancel diletakkan di LUAR tabel agar tidak nested dengan form aksi per-baris -->
          <form method="POST" action="/manager/loans/cancel" id="bulkCancelForm" onsubmit="return confirm('Batalkan peminjaman yang dipilih?')"></form>

          <div class="bg-card text-card-foreground rounded-xl border shadow-sm overflow-hidden">
              <div class="p-4 flex items-center gap-2 border-b">
                <button type="submit" form="bulkCancelForm" class="inline-flex items-center gap-2 bg-destructive text-destructive-foreground px-3 py-1 rounded-md text-sm font-medium hover:opacity-90">
                  Batalkan Terpilih
                </button>
              </div>
              <div class="overflow-x-auto">
                <table class="w-full text-sm text-left">
                <thead class="border-b bg-muted/50 font-medium">
                  <tr>
                    <th class="p-4" style="width:48px">
                      <input type="checkbox" id="selectAll" />
                    </th>
                    <th class="p-4">Kode Aset</th>
                    <th class="p-4">Nama Peralatan</th>
                    <th class="p-4">Peminjam</th>
                    <th class="p-4">Tgl Mulai</th>
                    <th class="p-4">Tgl Selesai</th>
                    <th class="p-4">Status</th>
                    <th class="p-4 text-right">Aksi</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (data.length === 0) { %>
                    <tr>
                      <td colspan="8" class="p-8 text-center text-muted-foreground">Tidak ada data peminjaman yang sedang berlangsung.</td>
                    </tr>
                  <% } else { %>
                    <% data.forEach(item => { %>
                      <%
                        const badgeColor =
                          item.status === 'requested' ? 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900/30 dark:text-yellow-400' :
                          item.status === 'approved'  ? 'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400' :
                          item.status === 'returned'  ? 'bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-400' :
                          'bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-400';
                        const statusLabel = { requested: 'Diminta', approved: 'Disetujui', returned: 'Dikembalikan', rejected: 'Ditolak' };
                      %>
                      <tr class="border-b last:border-0 hover:bg-muted/50 transition-colors">
                        <td class="p-4">
                          <!-- checkbox dikaitkan ke bulkCancelForm via atribut form -->
                          <input type="checkbox" name="ids[]" value="<%= item.id %>" class="rowCheckbox" form="bulkCancelForm" />
                        </td>
                        <td class="p-4 font-medium"><%= item.asset_code %></td>
                        <td class="p-4"><%= item.equipment_name %></td>
                        <td class="p-4"><%= item.employee_name %></td>
                        <td class="p-4 text-muted-foreground"><%= new Date(item.start_date).toLocaleDateString('id-ID') %></td>
                        <td class="p-4 text-muted-foreground"><%= item.end_date ? new Date(item.end_date).toLocaleDateString('id-ID') : '-' %></td>
                        <td class="p-4">
                          <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold border border-transparent <%= badgeColor %>">
                            <%= statusLabel[item.status] || item.status.toUpperCase() %>
                          </span>
                        </td>
                        <td class="p-4 text-right">
                          <div class="inline-flex items-center gap-2 justify-end">
                            <a href="/manager/detail/<%= item.id %>" class="text-sm font-medium text-primary hover:underline">Detail</a>
                            <% if (item.status === 'requested') { %>
                              <span class="text-muted-foreground select-none text-xs">|</span>
                              <form method="POST" action="/manager/loan/<%= item.id %>/approve" onsubmit="return confirm('Terima permintaan peminjaman ini?')">
                                <button type="submit" style="background-color:#16a34a;color:#ffffff;padding:4px 10px;border-radius:6px;font-size:12px;font-weight:600;border:none;cursor:pointer;" onmouseover="this.style.backgroundColor='#15803d'" onmouseout="this.style.backgroundColor='#16a34a'">Terima</button>
                              </form>
                              <span class="text-muted-foreground select-none text-xs">|</span>
                              <form method="POST" action="/manager/loan/<%= item.id %>/reject" onsubmit="return confirm('Tolak permintaan peminjaman ini?')">
                                <button type="submit" style="background-color:#dc2626;color:#ffffff;padding:4px 10px;border-radius:6px;font-size:12px;font-weight:600;border:none;cursor:pointer;" onmouseover="this.style.backgroundColor='#b91c1c'" onmouseout="this.style.backgroundColor='#dc2626'">Tolak</button>
                              </form>
                            <% } %>
                            <% if (item.status === 'approved') { %>
                              <span class="text-muted-foreground select-none text-xs">|</span>
                              <form method="POST" action="/manager/loan/<%= item.id %>/return" onsubmit="return confirm('Tandai peminjaman ini sebagai dikembalikan?')">
                                <button type="submit" style="background-color:#2563eb;color:#ffffff;padding:4px 10px;border-radius:6px;font-size:12px;font-weight:600;border:none;cursor:pointer;" onmouseover="this.style.backgroundColor='#1d4ed8'" onmouseout="this.style.backgroundColor='#2563eb'">Dikembalikan</button>
                              </form>
                            <% } %>
                          </div>
                        </td>
                      </tr>
                    <% }) %>
                  <% } %>
                </tbody>
              </table>
            </div>
            <% if (data.length > 0) { %>
              <div class="px-4 py-3 border-t text-xs text-muted-foreground text-right">
                Total: <%= data.length %> data
              </div>
            <% } %>
          </div>

        </div>
      </div>
    </main>

    <div id="toaster" class="toaster"></div>
    <script src="/assets/js/basecoat.js"></script>
    <script src="/assets/js/sidebar.js"></script>
    <script>
      // Checkbox select-all
      document.addEventListener('DOMContentLoaded', () => {
        const selectAll = document.getElementById('selectAll');
        if (!selectAll) return;
        selectAll.addEventListener('change', (e) => {
          document.querySelectorAll('.rowCheckbox').forEach(cb => cb.checked = e.target.checked);
        });
      });
    </script>

    <script>
      // Fetch jumlah peminjaman dengan status 'requested' dari API
      async function loadRequestedCount() {
        try {
          const res = await fetch('/api/manager/loans/requested');
          if (!res.ok) return;
          const data = await res.json();
          const total = data.total ?? 0;

          // Update badge di sidebar
          const badge = document.getElementById('badge-requested');
          if (badge) {
            if (total > 0) {
              badge.textContent = total;
              badge.style.display = 'inline-block';
            } else {
              badge.style.display = 'none';
            }
          }

          // Update card di header halaman
          const card = document.getElementById('card-requested');
          const count = document.getElementById('count-requested');
          if (card && count) {
            count.textContent = total;
            card.style.display = 'flex';
          }
        } catch (e) {
          // Gagal fetch — abaikan saja, tidak perlu menampilkan error ke user
        }
      }

      document.addEventListener('DOMContentLoaded', loadRequestedCount);
    </script>
  </body>
</html>
