<%- include('../partials/header') %>
<div class="p-6">
    <h1 class="text-2xl font-bold">Manajemen Event</h1>
    <form action="/admin/events/add" method="POST">
        <input type="text" name="name" class="border p-2" placeholder="Nama Event" required>
        <button type="submit" class="bg-blue-500 text-white p-2">Tambah Event</button>
    </form>
    <table class="w-full mt-4">
        <% events.forEach(e => { %>
        <tr>
            <td><%= e.name %></td>
            <td><%= e.status %></td>
            <td>
                <form action="/admin/events/publish/<%= e.id %>" method="POST">
                    <button type="submit">Publikasi</button>
                </form>
            </td>
        </tr>
        <% }) %>
    </table>
</div>
<%- include('../partials/footer') %>