<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Sistem Cuti Facultyware</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-white h-screen overflow-hidden flex">

    <div class="hidden lg:flex lg:w-1/2 h-full relative bg-cover bg-center" style="background-image: url('/assets/images/bg-login.png');">
        <div class="absolute inset-0 bg-gray-900 bg-opacity-75 mix-blend-multiply"></div>
        
        <div class="relative z-10 flex flex-col justify-center p-12 lg:p-20 xl:p-24 text-white h-full">
            <div class="mb-6">
                <span class="inline-block px-4 py-1.5 text-xs font-bold tracking-wider uppercase border border-gray-400 rounded-full bg-white/10 backdrop-blur-sm">
                    Fakultas Teknologi Informasi
                </span>
            </div>
            
            <h1 class="text-4xl lg:text-5xl xl:text-6xl font-extrabold leading-tight mb-6">
                Sistem Informasi<br>Cuti Pegawai
            </h1>
            
            <p class="text-lg text-gray-300 mb-8 max-w-lg leading-relaxed">
                Portal administrasi cuti pegawai Fakultas Teknologi Informasi untuk membantu proses pengajuan, verifikasi, dan pemantauan cuti secara lebih tertib, transparan, dan terintegrasi.
            </p>
            
            <div class="pl-5 border-l-4 border-white/50">
                <p class="text-sm text-gray-300 max-w-md leading-relaxed">
                    Akses sistem menggunakan akun yang telah terdaftar untuk melihat status pengajuan dan proses persetujuan cuti sesuai kewenangan pengguna.
                </p>
            </div>
        </div>
    </div>

    <div class="flex flex-col justify-center h-full w-full lg:w-1/2 p-8 lg:p-20 xl:p-24 bg-white relative overflow-y-auto">
        <div class="w-full max-w-md mx-auto">
            
            <div class="flex items-center gap-4 mb-12">
                <img src="/assets/images/logo-unand.png" alt="Logo UNAND" class="w-14 h-14 object-contain">
                <div>
                    <h2 class="text-xl font-extrabold text-gray-900 tracking-tight">Fakultas Teknologi Informasi</h2>
                    <p class="text-sm text-gray-500 font-medium">Universitas Andalas</p>
                </div>
            </div>

            <div class="mb-8">
                <h1 class="text-4xl font-extrabold text-gray-900 mb-2 tracking-tight">Selamat Datang</h1>
                <p class="text-gray-500 font-medium">Masuk menggunakan akun yang telah terdaftar.</p>
            </div>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="bg-red-50 border-l-4 border-red-500 text-red-700 p-4 mb-6 rounded-md shadow-sm" role="alert">
                    <p class="text-sm font-medium"><%= error %></p>
                </div>
            <% } %>

            <form action="/login" method="POST" class="bg-[#f4f7fe] border border-[#e2e8f0] p-6 sm:p-8 rounded-3xl shadow-sm space-y-5">
                
                <div>
                    <label for="email" class="block text-xs font-extrabold text-gray-600 uppercase tracking-widest mb-2 ml-1">Email</label>
                    <input 
                        type="email" 
                        id="email" 
                        name="email" 
                        required 
                        class="w-full px-5 py-3.5 rounded-xl border border-blue-100 bg-[#ebf0f9] text-gray-800 font-medium focus:bg-white focus:ring-2 focus:ring-blue-600 focus:border-transparent outline-none transition-all placeholder-gray-400"
                        placeholder="Masukkan email Anda"
                    >
                </div>

                <div class="relative">
                    <label for="password" class="block text-xs font-extrabold text-gray-600 uppercase tracking-widest mb-2 ml-1">Password</label>
                    <input 
                        type="password" 
                        id="password" 
                        name="password" 
                        required 
                        class="w-full px-5 py-3.5 rounded-xl border border-blue-100 bg-[#ebf0f9] text-gray-800 font-medium focus:bg-white focus:ring-2 focus:ring-blue-600 focus:border-transparent outline-none transition-all placeholder-gray-400 pr-12"
                        placeholder="••••••••"
                    >
                    <button type="button" id="togglePassword" class="absolute right-4 top-[38px] text-gray-400 hover:text-gray-600 focus:outline-none transition-colors">
                        <svg id="eyeIcon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                    </button>
                </div>

                <div class="pt-2">
                    <button 
                        type="submit" 
                        class="w-full flex justify-center py-4 px-4 border border-transparent rounded-xl shadow-md text-base font-bold text-white bg-[#1a56db] hover:bg-blue-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-600 transition-colors"
                    >
                        Masuk Sekarang
                    </button>
                </div>
            </form>

            <div class="mt-12 text-center lg:text-left">
                <p class="text-xs text-gray-400 font-medium">&copy; 2026 Fakultas Teknologi Informasi, Universitas Andalas.</p>
            </div>

        </div>
    </div>

    <script>
        const togglePassword = document.getElementById('togglePassword');
        const passwordInput = document.getElementById('password');

        togglePassword.addEventListener('click', function () {
            // Cek tipe input saat ini
            const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
            passwordInput.setAttribute('type', type);
            
            // Ganti icon mata terbuka/tertutup
            if (type === 'text') {
                this.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"></path><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"></path><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"></path><line x1="2" x2="22" y1="2" y2="22"></line></svg>`;
            } else {
                this.innerHTML = `<svg id="eyeIcon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path><circle cx="12" cy="12" r="3"></circle></svg>`;
            }
        });
    </script>
</body>
</html>