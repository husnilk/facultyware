<div class="p-4 md:p-6 xl:p-12">
  <div class="max-w-screen-lg mx-auto flex flex-col gap-8">
    <header class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div class="flex flex-col gap-2">
        <div class="flex items-center gap-2">
           <a href="/units" class="btn-icon-sm-ghost" title="Back to list">
             <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
           </a>
           <h1 class="text-2xl font-bold tracking-tight sm:text-3xl"><%= unit.name %></h1>
        </div>
        <p class="text-muted-foreground ml-8">Unit details and configuration.</p>
      </div>
      <div class="flex gap-2">
        <a href="/units/<%= unit.id %>/edit" class="btn">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
          Edit Unit
        </a>
      </div>
    </header>

    <div class="grid gap-6">
      <div class="card">
        <header>
          <h2>General Information</h2>
        </header>
        <section class="grid sm:grid-cols-2 gap-8 py-4">
          <div class="flex flex-col gap-1">
            <span class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Unit Name</span>
            <span class="text-sm"><%= unit.name %></span>
          </div>
          <div class="flex flex-col gap-1">
            <span class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Unit Code</span>
            <span class="text-sm font-mono"><%= unit.code %></span>
          </div>
          <div class="flex flex-col gap-1">
            <span class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Type</span>
            <span class="text-sm capitalize"><%= unit.type %></span>
          </div>
          <div class="flex flex-col gap-1">
            <span class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Parent Unit</span>
            <span class="text-sm"><%= unit.parent_name || 'None (Root Unit)' %></span>
          </div>
          <div class="flex flex-col gap-1 sm:col-span-2">
            <span class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Description</span>
            <div class="text-sm text-muted-foreground whitespace-pre-wrap"><%= unit.description || 'No description provided.' %></div>
          </div>
        </section>
        <footer class="bg-muted/30 -mx-6 -mb-6 px-6 py-4 mt-4 border-t flex justify-between">
          <div class="text-[10px] text-muted-foreground italic">
            Created at: <%= new Date(unit.created_at).toLocaleString() %>
          </div>
          <div class="text-[10px] text-muted-foreground italic">
            Last updated: <%= new Date(unit.updated_at).toLocaleString() %>
          </div>
        </footer>
      </div>
    </div>
  </div>
</div>
