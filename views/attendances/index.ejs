<%
  const safeAttendances =
    typeof attendances !== "undefined" && Array.isArray(attendances)
      ? attendances
      : typeof attendanceList !== "undefined" && Array.isArray(attendanceList)
        ? attendanceList
        : typeof records !== "undefined" && Array.isArray(records)
          ? records
          : typeof rows !== "undefined" && Array.isArray(rows)
            ? rows
            : [];

  const formatDate = (value) => {
    if (!value) return "-";

    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return value;

    return date.toLocaleString("id-ID", {
      day: "numeric",
      month: "short",
      year: "numeric",
      hour: "2-digit",
      minute: "2-digit"
    });
  };

  const getParticipantName = (item) => {
    return (
      item.participant_name ||
      item.nama_peserta ||
      item.nama ||
      item.name ||
      "-"
    );
  };

  const getParticipantEmail = (item) => {
    return (
      item.participant_email ||
      item.email ||
      "-"
    );
  };

  const getEventName = (item) => {
    return (
      item.event_title ||
      item.event_name ||
      item.nama_event ||
      item.title ||
      (item.event_id ? `Event #${item.event_id}` : "-")
    );
  };

  const getTicketNumber = (item) => {
    return (
      item.ticket_number ||
      item.ticketNumber ||
      item.nomor_tiket ||
      "-"
    );
  };

  const getStatus = (item) => {
    return (
      item.attendance_status ||
      item.status_kehadiran ||
      item.status ||
      "hadir"
    );
  };

  const getMethod = (item) => {
    return (
      item.checkin_method ||
      item.method ||
      item.metode ||
      "manual"
    );
  };

  const getCheckinTime = (item) => {
    return (
      item.checked_in_at ||
      item.checkin_at ||
      item.created_at ||
      item.updated_at ||
      ""
    );
  };

  const statusClass = (status) => {
    const normalized = String(status || "").toLowerCase();

    if (normalized.includes("hadir") || normalized.includes("present")) {
      return "bg-green-50 text-green-700 border-green-200";
    }

    if (normalized.includes("partial")) {
      return "bg-yellow-50 text-yellow-700 border-yellow-200";
    }

    if (normalized.includes("no") || normalized.includes("absent")) {
      return "bg-red-50 text-red-700 border-red-200";
    }

    return "bg-muted text-muted-foreground border-border";
  };
%>

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title><%= typeof title !== "undefined" ? title : "Attendance List" %> - Facultyware</title>

    <link rel="stylesheet" href="/assets/styles.css" />

    <script src="https://unpkg.com/htmx.org@2.0.4"></script>

    <script>
      (() => {
        try {
          if (
            localStorage.getItem("themeMode") === "dark" ||
            (!localStorage.getItem("themeMode") &&
              matchMedia("(prefers-color-scheme: dark)").matches)
          ) {
            document.documentElement.classList.add("dark");
          }
        } catch (_) {}
      })();
    </script>

    <script>
      (function () {
        try {
          const storedTheme = localStorage.getItem("themeVariant");
          if (storedTheme) {
            document.documentElement.classList.add(`theme-${storedTheme}`);
          }
        } catch (event) {
          console.error("Could not apply theme variant", event);
        }
      })();
    </script>
  </head>

  <body class="bg-background text-foreground antialiased p-6 md:p-10">
    <div class="max-w-6xl mx-auto space-y-6">
      <header class="flex justify-between items-center pb-6 border-b border-border">
        <div class="flex items-center gap-2">
          <span class="font-bold text-xl tracking-tight">Facultyware</span>
          <span class="text-xs text-muted-foreground bg-muted px-2 py-0.5 rounded">Attendance</span>
        </div>

        <nav class="flex gap-4 items-center">
          <a href="/home" class="text-sm font-medium hover:underline">Dashboard</a>
          <a href="/checkins" class="text-sm font-medium hover:underline">Check-in</a>
          <a href="/attendances/recap" class="text-sm font-medium hover:underline">Rekap</a>
          <a href="/reminders" class="text-sm font-medium hover:underline">Reminder</a>

          <% if (typeof user !== "undefined" && user) { %>
            <span class="text-sm text-muted-foreground">Halo, <strong><%= user %></strong></span>
          <% } else { %>
            <a href="/login" class="text-sm font-medium hover:underline">Login</a>
          <% } %>
        </nav>
      </header>

      <main class="space-y-6">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
          <div>
            <h1 class="text-3xl font-bold tracking-tight">Attendance List</h1>
            <p class="text-muted-foreground text-sm mt-2">
              Daftar peserta yang sudah tercatat pada proses check-in.
            </p>
          </div>

          <div class="flex flex-wrap gap-3">
            <a
              href="/checkins"
              class="inline-flex items-center justify-center rounded-md text-sm font-medium border border-input bg-background hover:bg-accent hover:text-accent-foreground h-10 px-4 py-2"
            >
              Check-in Peserta
            </a>

            <a
              href="/attendances/recap"
              class="inline-flex items-center justify-center rounded-md text-sm font-medium border border-input bg-background hover:bg-accent hover:text-accent-foreground h-10 px-4 py-2"
            >
              Rekap Attendance
            </a>

            <a
              href="/attendances/export/excel"
              class="inline-flex items-center justify-center rounded-md text-sm font-medium bg-primary text-primary-foreground h-10 px-4 py-2 hover:bg-primary/90 transition-colors"
            >
              Export Excel
            </a>
          </div>
        </div>

        <% if (typeof success !== "undefined" && success) { %>
          <div class="rounded-md border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-700">
            <%= success %>
          </div>
        <% } %>

        <% if (typeof error !== "undefined" && error) { %>
          <div class="rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
            <%= error %>
          </div>
        <% } %>

        <div data-slot="card" class="rounded-xl border border-border bg-card text-card-foreground shadow-md overflow-hidden">
          <div class="p-6 border-b border-border flex flex-col md:flex-row md:items-center md:justify-between gap-4">
            <div>
              <h2 class="text-xl font-bold tracking-tight">Data Attendance</h2>
              <p class="text-sm text-muted-foreground mt-1">
                Total <%= safeAttendances.length %> data attendance tercatat.
              </p>
            </div>

            <div class="flex flex-col sm:flex-row gap-3 sm:items-center">
              <input
                type="text"
                id="attendanceSearch"
                placeholder="Cari peserta, event, atau tiket..."
                class="w-full sm:w-72 h-10 rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-xs transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
              />

              <span class="text-xs text-muted-foreground bg-muted px-2.5 py-1 rounded-full whitespace-nowrap">
                <%= safeAttendances.length %> Data
              </span>
            </div>
          </div>

          <% if (safeAttendances.length > 0) { %>
            <div class="overflow-x-auto">
              <table class="w-full text-sm" id="attendanceTable">
                <thead class="border-b border-border bg-muted/50">
                  <tr>
                    <th class="text-left font-semibold px-4 py-3">No</th>
                    <th class="text-left font-semibold px-4 py-3">Peserta</th>
                    <th class="text-left font-semibold px-4 py-3">Event</th>
                    <th class="text-left font-semibold px-4 py-3">Nomor Tiket</th>
                    <th class="text-left font-semibold px-4 py-3">Metode</th>
                    <th class="text-left font-semibold px-4 py-3">Status</th>
                    <th class="text-left font-semibold px-4 py-3">Waktu Check-in</th>
                  </tr>
                </thead>

                <tbody>
                  <% safeAttendances.forEach((item, index) => { %>
                    <tr class="border-b border-border last:border-0 attendance-row">
                      <td class="px-4 py-3 text-muted-foreground">
                        <%= index + 1 %>
                      </td>

                      <td class="px-4 py-3">
                        <div class="font-medium"><%= getParticipantName(item) %></div>
                        <div class="text-xs text-muted-foreground mt-0.5"><%= getParticipantEmail(item) %></div>
                      </td>

                      <td class="px-4 py-3">
                        <div class="font-medium"><%= getEventName(item) %></div>
                      </td>

                      <td class="px-4 py-3">
                        <span class="inline-flex items-center rounded-md bg-muted px-2 py-0.5 text-xs font-semibold text-muted-foreground">
                          <%= getTicketNumber(item) %>
                        </span>
                      </td>

                      <td class="px-4 py-3 text-muted-foreground">
                        <%= getMethod(item) %>
                      </td>

                      <td class="px-4 py-3">
                        <span class="inline-flex items-center rounded-md px-2 py-0.5 text-xs font-semibold border <%= statusClass(getStatus(item)) %>">
                          <%= getStatus(item) %>
                        </span>
                      </td>

                      <td class="px-4 py-3 text-muted-foreground whitespace-nowrap">
                        <%= formatDate(getCheckinTime(item)) %>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <div class="text-center py-12">
              <h3 class="text-lg font-semibold mb-2">Belum ada data attendance</h3>
              <p class="text-muted-foreground text-sm mb-5">
                Data attendance akan muncul setelah peserta berhasil melakukan check-in.
              </p>

              <a
                href="/checkins"
                class="inline-flex items-center justify-center rounded-md text-sm font-medium bg-primary text-primary-foreground h-10 px-4 py-2 hover:bg-primary/90 transition-colors"
              >
                Check-in Peserta
              </a>
            </div>
          <% } %>
        </div>
      </main>
    </div>

    <script>
      const searchInput = document.getElementById("attendanceSearch");
      const rows = document.querySelectorAll(".attendance-row");

      if (searchInput) {
        searchInput.addEventListener("input", function () {
          const keyword = this.value.toLowerCase().trim();

          rows.forEach((row) => {
            const text = row.textContent.toLowerCase();
            row.style.display = text.includes(keyword) ? "" : "none";
          });
        });
      }
    </script>
  </body>
</html>