<!doctype html>
<html lang="en">
  <head>
    <script>
      (() => {
        try {
          const stored = localStorage.getItem("themeMode");
          if (
            stored
              ? stored === "dark"
              : matchMedia("(prefers-color-scheme: dark)").matches
          ) {
            document.documentElement.classList.add("dark");
          }
        } catch (_) {}
      })();
    </script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %> - Facultyware</title>

    <link rel="stylesheet" href="/assets/styles.css" />
    <script src="https://unpkg.com/htmx.org@2.0.4"></script>
  </head>
  <body>
    <main>
      <header
        class="bg-background sticky inset-x-0 top-0 isolate flex shrink-0 items-center gap-2 border-b z-10"
      >
        <div class="flex h-14 w-full items-center gap-4 px-4">
          <span class="font-semibold">Facultyware - Event Module</span>
          <span class="text-sm text-muted-foreground">
            Login sebagai <strong><%= user %></strong>
            <% roles.forEach(function(role) { %>
              <span class="badge ml-1"><%= role %></span>
            <% }) %>
          </span>
          <a href="/logout" class="btn-sm-outline ml-auto">Logout</a>
        </div>
      </header>

      <div class="p-4 md:p-6 xl:p-12">
        <div class="max-w-screen-lg mx-auto">

          <header class="flex flex-col gap-2 mb-8">
            <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">
              Selamat datang, <%= user %>
            </h1>
            <p class="text-muted-foreground">
              Dashboard ringkasan untuk modul Event - Facultyware.
            </p>
          </header>

          <% if (summary) { %>
          <section class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
            <div class="card p-4">
              <p class="text-sm text-muted-foreground">Total Peserta</p>
              <p class="text-2xl font-bold"><%= summary.totalPeserta %></p>
            </div>
            <div class="card p-4">
              <p class="text-sm text-muted-foreground">Peserta Hadir</p>
              <p class="text-2xl font-bold"><%= summary.totalHadir %></p>
            </div>
            <div class="card p-4">
              <p class="text-sm text-muted-foreground">Sertifikat Terbit</p>
              <p class="text-2xl font-bold"><%= summary.totalSertifikat %></p>
            </div>
            <div class="card p-4">
              <p class="text-sm text-muted-foreground">Laporan Diupload</p>
              <p class="text-2xl font-bold"><%= summary.totalLaporan %></p>
            </div>
          </section>
          <% } %>

          <section>
            <h2 class="text-lg font-semibold mb-4">Menu</h2>

            <% if (menus.length === 0) { %>
              <p class="text-muted-foreground">Belum ada menu untuk role kamu.</p>
            <% } else { %>
              <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
                <% menus.forEach(function(menu) { %>
                  <a href="<%= menu.href %>" class="card p-4 hover:bg-muted transition-colors">
                    <div class="text-2xl mb-2"><%= menu.icon %></div>
                    <h3 class="font-medium"><%= menu.title %></h3>
                    <p class="text-sm text-muted-foreground"><%= menu.desc %></p>
                  </a>
                <% }) %>
              </div>
            <% } %>
          </section>

        </div>
      </div>
    </main>

    <div id="toaster" class="toaster"></div>
  </body>
</html>