<!DOCTYPE html>
<html>
<head>
  <title><%= title %></title>
  <link rel="stylesheet" href="/assets/basecoat.min.css">
  <link rel="stylesheet" href="/assets/styles.css">

  <style>
    * {
      letter-spacing: normal;
    }

    body {
      margin: 0;
      background-color: #f7f7f7;
      font-family: Arial, sans-serif;
      font-size: 14px;
      color: #111;
    }

    .container {
      width: 800px;
      margin: 70px auto;
      background-color: #fff;
      padding: 28px 32px;
      border-radius: 8px;
    }

    h1 {
      font-family: Arial, sans-serif;
      font-size: 28px;
      font-weight: 700;
      margin: 0 0 12px 0;
      letter-spacing: 0 !important;
      word-spacing: normal !important;
    }

    p {
      margin-top: 0;
      margin-bottom: 22px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 18px;
      font-size: 14px;
    }

    th {
      text-align: left;
      font-weight: 700;
      padding: 9px 6px;
      border-bottom: 1px solid #ddd;
    }

    td {
      padding: 9px 6px;
      border-bottom: 1px solid #eee;
    }

    .empty {
      text-align: center;
      color: #333;
      padding: 18px;
    }

    .top-link {
      margin-bottom: 20px;
    }

    a {
      color: #4b2e83;
      text-decoration: underline;
    }
  </style>
</head>

<body>
  <div class="container">
    <div class="top-link">
      <a href="/participants">← Kembali ke Peserta</a>
    </div>

    <h1>Sertifikat Peserta</h1>
    <p>Daftar peserta yang sudah hadir dan layak mendapatkan sertifikat.</p>

    <table>
      <thead>
        <tr>
          <th>No</th>
          <th>Nama Peserta</th>
          <th>Email</th>
          <th>Event</th>
          <th>Nomor Sertifikat</th>
          <th>Aksi</th>
        </tr>
      </thead>

      <tbody>
        <% if (participants.length === 0) { %>
          <tr>
            <td colspan="6" class="empty">
              Belum ada peserta yang layak mendapatkan sertifikat.
            </td>
          </tr>
        <% } %>

        <% participants.forEach((participant, index) => { %>
          <tr>
            <td><%= index + 1 %></td>
            <td><%= participant.participant_name %></td>
            <td><%= participant.participant_email %></td>
            <td><%= participant.event_title %></td>
            <td><%= participant.certificate_number || "-" %></td>
            <td>
              <a href="/certificates/<%= participant.id %>">Cetak Sertifikat</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</body>
</html>