<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title><%= typeof title !== "undefined" ? title : "FTI Event Management System" %></title>

  <link rel="stylesheet" href="/assets/basecoat.min.css" />
  <link rel="stylesheet" href="/assets/styles.css" />

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      font-family: Arial, sans-serif;
      background: #f8fafc;
      color: #111827;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .app-layout {
      min-height: 100vh;
      display: flex;
      background: #f8fafc;
    }

    .sidebar {
      width: 310px;
      min-height: 100vh;
      background: #ffffff;
      border-right: 1px solid #e5e7eb;
      position: fixed;
      top: 0;
      left: 0;
      padding: 22px 18px;
      display: flex;
      flex-direction: column;
      z-index: 100;
    }

    .sidebar-header {
      padding-bottom: 18px;
      border-bottom: 1px solid #e5e7eb;
      margin-bottom: 18px;
    }

    .sidebar-brand {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .sidebar-logo {
      width: 46px;
      height: 46px;
      border-radius: 15px;
      background: #111827;
      color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 15px;
      font-weight: 800;
      letter-spacing: -0.04em;
      flex-shrink: 0;
    }

    .sidebar-brand-text {
      display: flex;
      flex-direction: column;
      min-width: 0;
      line-height: 1.2;
    }

    .sidebar-brand-text strong {
      font-size: 17px;
      font-weight: 800;
      color: #111827;
    }

    .sidebar-brand-text span {
      margin-top: 3px;
      font-size: 12px;
      color: #6b7280;
      font-weight: 500;
    }

    .sidebar-menu {
      flex: 1;
      overflow-y: auto;
      padding-right: 4px;
    }

    .sidebar-menu::-webkit-scrollbar {
      width: 5px;
    }

    .sidebar-menu::-webkit-scrollbar-track {
      background: transparent;
    }

    .sidebar-menu::-webkit-scrollbar-thumb {
      background: #d1d5db;
      border-radius: 999px;
    }

    .sidebar-section {
      margin-bottom: 18px;
    }

    .sidebar-section-title {
      margin: 0 0 8px 10px;
      font-size: 11px;
      font-weight: 800;
      color: #9ca3af;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .sidebar-link {
      display: flex;
      align-items: center;
      gap: 12px;
      min-height: 43px;
      padding: 9px 10px;
      border-radius: 12px;
      color: #374151;
      font-size: 14px;
      font-weight: 600;
      transition: 0.16s ease;
      margin-bottom: 4px;
    }

    .sidebar-link:hover {
      background: #f3f4f6;
      color: #111827;
    }

    .sidebar-link.active {
      background: #111827;
      color: #ffffff;
    }

    .sidebar-icon {
      width: 32px;
      height: 32px;
      border-radius: 10px;
      background: #f3f4f6;
      color: #111827;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 11px;
      font-weight: 800;
      flex-shrink: 0;
      transition: 0.16s ease;
    }

    .sidebar-link:hover .sidebar-icon {
      background: #111827;
      color: #ffffff;
    }

    .sidebar-link.active .sidebar-icon {
      background: #ffffff;
      color: #111827;
    }

    .sidebar-text {
      display: flex;
      flex-direction: column;
      line-height: 1.25;
      min-width: 0;
    }

    .sidebar-note {
      margin-top: 2px;
      font-size: 11px;
      color: #9ca3af;
      font-weight: 500;
      line-height: 1.35;
    }

    .sidebar-link.active .sidebar-note {
      color: rgba(255, 255, 255, 0.72);
    }

    .sidebar-footer {
      padding-top: 14px;
      border-top: 1px solid #e5e7eb;
      margin-top: 14px;
    }

    .sidebar-logout {
      color: #991b1b;
    }

    .sidebar-logout .sidebar-icon {
      background: #fee2e2;
      color: #991b1b;
    }

    .sidebar-logout:hover {
      background: #fef2f2;
      color: #991b1b;
    }

    .sidebar-logout:hover .sidebar-icon {
      background: #991b1b;
      color: #ffffff;
    }

    .main-content {
      width: 100%;
      min-height: 100vh;
      margin-left: 310px;
      padding: 24px;
    }

    .topbar {
      min-height: 70px;
      background: #ffffff;
      border: 1px solid #e5e7eb;
      border-radius: 18px;
      padding: 16px 20px;
      margin-bottom: 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      box-shadow: 0 8px 20px rgba(15, 23, 42, 0.04);
    }

    .topbar-title {
      margin: 0;
      font-size: 22px;
      font-weight: 800;
      color: #111827;
      letter-spacing: -0.03em;
      line-height: 1.2;
    }

    .topbar-subtitle {
      margin-top: 4px;
      font-size: 13px;
      color: #6b7280;
      line-height: 1.4;
    }

    .topbar-actions {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
      justify-content: flex-end;
    }

    .topbar-badge {
      display: inline-flex;
      align-items: center;
      padding: 7px 12px;
      border-radius: 999px;
      background: #f3f4f6;
      color: #374151;
      font-size: 13px;
      font-weight: 600;
    }

    .page-content {
      max-width: 1180px;
      margin: 0 auto;
    }

    .btn,
    button,
    .button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 42px;
      padding: 10px 16px;
      border-radius: 10px;
      border: 1px solid #111827;
      background: #111827;
      color: #ffffff;
      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
      transition: 0.16s ease;
    }

    .btn:hover,
    button:hover,
    .button:hover {
      background: #030712;
      border-color: #030712;
      color: #ffffff;
    }

    .btn-outline {
      background: #ffffff;
      color: #111827;
      border: 1px solid #d1d5db;
    }

    .btn-outline:hover {
      background: #f9fafb;
      color: #111827;
      border-color: #9ca3af;
    }

    .card,
    .panel,
    .page-card {
      background: #ffffff;
      border: 1px solid #e5e7eb;
      border-radius: 16px;
      box-shadow: 0 8px 20px rgba(15, 23, 42, 0.04);
    }

    table {
      width: 100%;
      border-collapse: collapse;
      background: #ffffff;
      border: 1px solid #e5e7eb;
      border-radius: 14px;
      overflow: hidden;
    }

    th,
    td {
      padding: 13px 14px;
      border-bottom: 1px solid #e5e7eb;
      text-align: left;
      font-size: 14px;
      vertical-align: top;
    }

    th {
      background: #f9fafb;
      color: #374151;
      font-weight: 800;
      white-space: nowrap;
    }

    tr:last-child td {
      border-bottom: none;
    }

    input,
    select,
    textarea {
      width: 100%;
      min-height: 42px;
      border: 1px solid #d1d5db;
      border-radius: 10px;
      padding: 10px 12px;
      background: #ffffff;
      color: #111827;
      font-size: 14px;
      outline: none;
    }

    input:focus,
    select:focus,
    textarea:focus {
      border-color: #111827;
      box-shadow: 0 0 0 3px rgba(17, 24, 39, 0.08);
    }

    textarea {
      resize: vertical;
    }

    label {
      display: block;
      margin-bottom: 7px;
      font-size: 14px;
      font-weight: 700;
      color: #374151;
    }

    .alert,
    .success,
    .error {
      padding: 13px 15px;
      border-radius: 12px;
      margin-bottom: 16px;
      font-size: 14px;
      font-weight: 600;
    }

    .success,
    .alert-success {
      background: #dcfce7;
      color: #166534;
      border: 1px solid #bbf7d0;
    }

    .error,
    .alert-error {
      background: #fee2e2;
      color: #991b1b;
      border: 1px solid #fecaca;
    }

    @media (max-width: 1080px) {
      .app-layout {
        flex-direction: column;
      }

      .sidebar {
        position: relative;
        width: 100%;
        min-height: auto;
        border-right: none;
        border-bottom: 1px solid #e5e7eb;
      }

      .sidebar-menu {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
        overflow-y: visible;
      }

      .sidebar-section {
        margin-bottom: 0;
      }

      .sidebar-section-title {
        grid-column: 1 / -1;
      }

      .main-content {
        margin-left: 0;
        padding: 18px;
      }

      .topbar {
        align-items: flex-start;
        flex-direction: column;
      }

      .topbar-actions {
        justify-content: flex-start;
      }
    }

    @media (max-width: 560px) {
      .sidebar-menu {
        grid-template-columns: 1fr;
      }

      .main-content {
        padding: 14px;
      }

      .topbar {
        border-radius: 14px;
      }

      table {
        display: block;
        overflow-x: auto;
      }
    }
  </style>

  <script>
    document.addEventListener("DOMContentLoaded", function () {
      var currentPath = window.location.pathname;
      var links = document.querySelectorAll(".sidebar-link");

      links.forEach(function (link) {
        var route = link.getAttribute("data-route");

        if (!route) {
          return;
        }

        if (route === "/home" && currentPath === "/home") {
          link.classList.add("active");
          return;
        }

        if (route !== "/home" && currentPath.indexOf(route) === 0) {
          link.classList.add("active");
        }
      });
    });
  </script>
</head>

<body>
  <div class="app-layout">
    <aside class="sidebar">
      <div class="sidebar-header">
        <a href="/home" class="sidebar-brand">
          <div class="sidebar-logo">FTI</div>
          <div class="sidebar-brand-text">
            <strong>FTI Event</strong>
            <span>Management System</span>
          </div>
        </a>
      </div>

      <nav class="sidebar-menu">
        <div class="sidebar-section">
          <div class="sidebar-section-title">Main Menu</div>

          <a href="/home" class="sidebar-link" data-route="/home">
