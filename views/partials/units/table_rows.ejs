<% units.forEach(u => { %>
  <tr id="unit-<%= u.id %>" class="group">
    <td>
      <div class="flex flex-col">
        <a href="/units/<%= u.id %>" class="font-medium text-sm hover:underline"><%= u.name %></a>
      </div>
    </td>
    <td class="text-sm font-mono text-muted-foreground">
      <%= u.code %>
    </td>
    <td>
      <span class="badge badge-outline text-[10px] py-0 px-1.5 capitalize"><%= u.type %></span>
    </td>
    <td class="text-sm text-muted-foreground">
      <%= u.parent_name || '-' %>
    </td>
    <td class="text-right">
      <div class="flex items-center justify-end gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
        <a 
          href="/units/<%= u.id %>" 
          class="btn-icon-sm-ghost"
          title="View Details"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
        </a>
        <a 
          href="/units/<%= u.id %>/edit" 
          class="btn-icon-sm-ghost"
          title="Edit Unit"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
        </a>
        <button 
          class="btn-icon-sm-ghost text-destructive"
          hx-delete="/units/<%= u.id %>"
          hx-target="#unit-<%= u.id %>"
          hx-swap="outerHTML"
          hx-confirm="Are you sure you want to delete this unit?"
          title="Delete Unit"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" x2="10" y1="11" y2="17"/><line x1="14" x2="14" y1="11" y2="17"/></svg>
        </button>
      </div>
    </td>
  </tr>
<% }) %>

<% if (units.length === 0) { %>
  <tr>
    <td colspan="5" class="py-12 text-center text-muted-foreground italic">
      No units found matching your search.
    </td>
  </tr>
<% } %>
