<!doctype html>
<html lang="en">
  <head>
    <script>
      (() => {
        try {
          const stored = localStorage.getItem("themeMode");
          if (
            stored
              ? stored === "dark"
              : matchMedia("(prefers-color-scheme: dark)").matches
          ) {
            document.documentElement.classList.add("dark");
          }
        } catch (_) {}

        const apply = (dark) => {
          document.documentElement.classList.toggle("dark", dark);
          try {
            localStorage.setItem("themeMode", dark ? "dark" : "light");
          } catch (_) {}
        };

        document.addEventListener("basecoat:theme", (event) => {
          const mode = event.detail?.mode;
          apply(
            mode === "dark"
              ? true
              : mode === "light"
                ? false
                : !document.documentElement.classList.contains("dark"),
          );
        });
      })();
    </script>

    <script>
      (function () {
        try {
          const storedTheme = localStorage.getItem("themeVariant");
          if (storedTheme)
            document.documentElement.classList.add(`theme-${storedTheme}`);
        } catch (event) {
          console.error("Could not apply theme variant from localStorage", event);
        }
      })();
    </script>

    <meta charset="utf-8" />
    <meta http-equiv="Content-Language" content="en" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Basecoat</title>
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png" />
    <link rel="stylesheet" href="/assets/styles.css" />
    <script src="/assets/js/basecoat.js?v=0.3.11" defer></script>
    <script src="/assets/js/command.js?v=0.3.11" defer></script>
    <script src="/assets/js/dropdown-menu.js?v=0.3.11" defer></script>
    <script src="/assets/js/popover.js?v=0.3.11" defer></script>
    <script src="/assets/js/select.js?v=0.3.11" defer></script>
    <script src="/assets/js/sidebar.js?v=0.3.11" defer></script>
    <script src="/assets/js/tabs.js?v=0.3.11" defer></script>
    <script src="/assets/js/toast.js?v=0.3.11" defer></script>
    <script src="https://unpkg.com/htmx.org@2.0.4"></script>
  </head>
  <body class="bg-background *:data-[slot=card]:has-[[data-slot=chart]]:shadow-none">
    <div class="flex min-h-svh flex-col items-center justify-center bg-muted p-6 md:p-10">
      <div class="w-full max-w-sm md:max-w-4xl">
        <div class="flex flex-col gap-6">
          <div data-slot="card" class="flex flex-col gap-6 rounded-xl border bg-card text-card-foreground shadow-sm overflow-hidden p-0">
            <div data-slot="card-content" class="grid p-0 md:grid-cols-2">
              <form class="p-6 md:p-8" action="/register" method="POST">
                <div data-slot="field-group" class="group/field-group @container/field-group flex w-full flex-col gap-7 data-[slot=checkbox-group]:gap-3 [&>[data-slot=field-group]]:gap-4">
                  
                  <div class="flex flex-col items-center gap-2 text-center">
                    <h1 class="text-2xl font-bold">Create an account</h1>
                  </div>

                  <% if (error) { %>
                    <div class="bg-destructive/15 text-destructive text-sm p-3 rounded-md border border-destructive/20 text-center">
                      <%= error %>
                    </div>
                  <% } %>

                  <!-- Nama -->
                  <div role="group" data-slot="field" data-orientation="vertical"
                    class="group/field flex w-full gap-3 data-[invalid=true]:text-destructive flex-col [&>*]:w-full [&>.sr-only]:w-auto">
                    <label data-slot="field-label"
                      class="items-center text-sm font-medium select-none group/field-label peer/field-label flex w-fit gap-2 leading-snug"
                      for="name">Full Name</label>
                    <input type="text" name="name" id="name" placeholder="John Doe" required
                      data-slot="input"
                      class="h-9 w-full min-w-0 rounded-md border border-input bg-transparent px-3 py-1 text-base shadow-xs transition-[color,box-shadow] outline-none placeholder:text-muted-foreground md:text-sm dark:bg-input/30 focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50" />
                  </div>

                  <!-- Email -->
                  <div role="group" data-slot="field" data-orientation="vertical"
                    class="group/field flex w-full gap-3 data-[invalid=true]:text-destructive flex-col [&>*]:w-full [&>.sr-only]:w-auto">
                    <label data-slot="field-label"
                      class="items-center text-sm font-medium select-none group/field-label peer/field-label flex w-fit gap-2 leading-snug"
                      for="email">Email</label>
                    <input type="email" name="email" id="email" placeholder="john@example.com" required
                      data-slot="input"
                      class="h-9 w-full min-w-0 rounded-md border border-input bg-transparent px-3 py-1 text-base shadow-xs transition-[color,box-shadow] outline-none placeholder:text-muted-foreground md:text-sm dark:bg-input/30 focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50" />
                  </div>

                  <!-- Password -->
                  <div role="group" data-slot="field" data-orientation="vertical"
                    class="group/field flex w-full gap-3 data-[invalid=true]:text-destructive flex-col [&>*]:w-full [&>.sr-only]:w-auto">
                    <label data-slot="field-label"
                      class="items-center text-sm font-medium select-none group/field-label peer/field-label flex w-fit gap-2 leading-snug"
                      for="password">Password</label>
                    <input type="password" name="password" id="password" required
                      data-slot="input"
                      class="h-9 w-full min-w-0 rounded-md border border-input bg-transparent px-3 py-1 text-base shadow-xs transition-[color,box-shadow] outline-none placeholder:text-muted-foreground md:text-sm dark:bg-input/30 focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50" />
                  </div>

                  <!-- Tombol Submit -->
                  <div role="group" data-slot="field" data-orientation="vertical"
                    class="group/field flex w-full gap-3 flex-col [&>*]:w-full">
                    <button data-slot="button" data-variant="default" data-size="default"
                      class="inline-flex shrink-0 items-center justify-center gap-2 rounded-md text-sm font-medium whitespace-nowrap transition-all outline-none focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 bg-primary text-primary-foreground hover:bg-primary/90 h-9 px-4 py-2"
                      type="submit">
                      Register
                    </button>
                  </div>

                  <p data-slot="field-description"
                    class="text-sm leading-normal font-normal text-muted-foreground [&>a]:underline [&>a]:underline-offset-4 [&>a:hover]:text-primary text-center">
                    Already have an account? <a href="/login">Login</a>
                  </p>

                </div>
              </form>
              <div class="relative hidden bg-muted md:block">
                <img src="/assets/images/placeholder.svg" alt="Image"
                  class="absolute inset-0 h-full w-full object-cover dark:brightness-[0.2] dark:grayscale" />
              </div>
            </div>
          </div>
          <p data-slot="field-description"
            class="text-sm leading-normal font-normal text-muted-foreground [&>a]:underline [&>a]:underline-offset-4 [&>a:hover]:text-primary px-6 text-center">
            By clicking continue, you agree to our
            <a href="#">Terms of Service</a> and <a href="#">Privacy Policy</a>.
          </p>
        </div>
      </div>
    </div>
    <div id="toaster" class="toaster"></div>
  </body>
</html>