<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %> - Facultyware</title>
    <link rel="stylesheet" href="/assets/styles.css" />
    <script>
      (() => {
        try {
          if (localStorage.getItem("themeMode") === "dark" || (!localStorage.getItem("themeMode") && matchMedia("(prefers-color-scheme: dark)").matches)) {
            document.documentElement.classList.add("dark");
          }
        } catch (_) {}
      })();
    </script>
    <script>
      (function () {
        try {
          const storedTheme = localStorage.getItem("themeVariant");
          if (storedTheme)
            document.documentElement.classList.add(`theme-${storedTheme}`);
        } catch (event) {
          console.error("Could not apply theme variant", event);
        }
      })();
    </script>
  </head>
  <body class="bg-muted flex min-h-svh flex-col items-center justify-center p-6 md:p-10">
    <div class="w-full max-w-xl">
        <a href="/events/<%= event.id %>" class="text-sm font-medium hover:underline mb-6 inline-block text-muted-foreground" style="margin-bottom: 1.5rem;">&larr; Kembali ke Detail Event</a>
        
        <div data-slot="card" class="flex flex-col gap-6 rounded-xl border border-border bg-card text-card-foreground shadow-md overflow-hidden p-6 md:p-8">
            <div class="space-y-2" style="margin-bottom: 1rem;">
                <h1 class="text-2xl font-bold tracking-tight">Form Pendaftaran Event</h1>
                <p class="text-muted-foreground text-sm">Lengkapi detail pendaftaran Anda untuk event di bawah ini.</p>
            </div>
            
            <!-- Event Summary Info Box -->
            <div class="p-4 rounded-lg border border-border" style="background-color: var(--muted); margin-bottom: 1.5rem;">
                <span class="block text-xs font-bold text-muted-foreground mb-1" style="letter-spacing: 0.05em;">EVENT YANG DIIKUTI</span>
                <h2 class="text-base font-bold text-foreground mb-3"><%= event.title %></h2>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-xs text-muted-foreground">
                    <div class="flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                        <span><%= new Date(event.start_date).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
                    </div>
                    <div class="flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                        <span class="truncate"><%= event.delivery_mode === 'online' ? 'Online' : (event.venue || 'Offline') %></span>
                    </div>
                </div>
            </div>
            
            <form action="/events/<%= event.id %>/register" method="POST" class="space-y-6">
                <!-- Nama Lengkap (Read-only) -->
                <div role="group" data-slot="field" data-orientation="vertical" class="group/field flex w-full gap-2 flex-col">
                    <label data-slot="field-label" class="text-sm font-semibold leading-snug" for="name">Nama Lengkap</label>
                    <input 
                        type="text" 
                        id="name" 
                        class="h-9 w-full min-w-0 rounded-md border border-input px-3 py-1 text-sm bg-muted text-muted-foreground cursor-not-allowed"
                        style="background-color: var(--muted); border-color: var(--border);"
                        value="<%= user %>" 
                        disabled 
                        readonly 
                    />
                </div>

                <!-- Email (Read-only) -->
                <div role="group" data-slot="field" data-orientation="vertical" class="group/field flex w-full gap-2 flex-col">
                    <label data-slot="field-label" class="text-sm font-semibold leading-snug" for="email">Email</label>
                    <input 
                        type="email" 
                        id="email" 
                        class="h-9 w-full min-w-0 rounded-md border border-input px-3 py-1 text-sm bg-muted text-muted-foreground cursor-not-allowed"
                        style="background-color: var(--muted); border-color: var(--border);"
                        value="<%= email || '-' %>" 
                        disabled 
                        readonly 
                    />
                </div>

                <!-- Catatan Tambahan -->
                <div role="group" data-slot="field" data-orientation="vertical" class="group/field flex w-full gap-2 flex-col">
                    <label data-slot="field-label" class="text-sm font-semibold leading-snug" for="notes">Catatan Tambahan (Opsional)</label>
                    <textarea 
                        name="notes" 
                        data-slot="textarea" 
                        id="notes" 
                        class="min-h-[100px] w-full rounded-md border border-input bg-transparent px-3 py-2 text-base shadow-xs placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50 focus-visible:border-ring md:text-sm"
                        placeholder="Misal: Alergi makanan tertentu, dsb."
                    ></textarea>
                </div>

                <!-- Persetujuan Checkbox -->
                <div class="flex items-start gap-3">
                    <input 
                        type="checkbox" 
                        id="consent" 
                        required 
                        class="rounded border-input text-primary focus:ring-ring"
                        style="width: 1.1rem; height: 1.1rem; margin-top: 0.1rem; cursor: pointer;"
                    />
                    <label for="consent" class="text-xs text-muted-foreground leading-normal cursor-pointer select-none">
                        Saya menyetujui Ketentuan Pendaftaran dan bersedia hadir tepat waktu pada event <strong><%= event.title %></strong>.
                    </label>
                </div>
                
                <div class="pt-4 border-t border-border flex justify-end gap-3" style="margin-top: 1.5rem;">
                    <a href="/events/<%= event.id %>" class="inline-flex shrink-0 items-center justify-center gap-2 rounded-md text-xs font-semibold whitespace-nowrap transition-all outline-none bg-secondary text-secondary-foreground hover:bg-secondary/80 h-9 px-4 py-2">
                        Batal
                    </a>
                    <button type="submit" class="inline-flex shrink-0 items-center justify-center gap-2 rounded-md text-xs font-semibold whitespace-nowrap transition-all outline-none bg-primary text-primary-foreground hover:bg-primary/90 h-9 px-4 py-2">
                        Konfirmasi Pendaftaran
                    </button>
                </div>
            </form>
        </div>
    </div>
  </body>
</html>
