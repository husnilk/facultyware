<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %> - Facultyware</title>
    <link rel="stylesheet" href="/assets/styles.css" />
    <script>
      (() => {
        try {
          if (localStorage.getItem("themeMode") === "dark" || (!localStorage.getItem("themeMode") && matchMedia("(prefers-color-scheme: dark)").matches)) {
            document.documentElement.classList.add("dark");
          }
        } catch (_) {}
      })();
    </script>
  </head>
  <body class="bg-muted flex min-h-svh flex-col items-center justify-center p-6 md:p-10">
    <div class="w-full max-w-2xl">
        <a href="/events/<%= event.id %>" class="text-sm font-medium hover:underline mb-6 inline-block text-muted-foreground">&larr; Kembali ke Detail Event</a>
        
        <div data-slot="card" class="flex flex-col gap-6 rounded-xl border bg-card text-card-foreground shadow-sm overflow-hidden p-6 md:p-8">
            <div class="space-y-2 mb-4">
                <h1 class="text-2xl font-bold tracking-tight">Form Pendaftaran Event</h1>
                <p class="text-muted-foreground">Silakan lengkapi data pendaftaran Anda untuk event <strong><%= event.title %></strong>.</p>
            </div>
            
            <form action="/events/<%= event.id %>/register" method="POST" class="space-y-6">
                <div role="group" data-slot="field" data-orientation="vertical" class="group/field flex w-full gap-3 flex-col">
                    <label data-slot="field-label" class="text-sm font-medium leading-snug" for="notes">Catatan Tambahan (Opsional)</label>
                    <textarea 
                        name="notes" 
                        data-slot="textarea" 
                        id="notes" 
                        class="min-h-[100px] w-full rounded-md border border-input bg-transparent px-3 py-2 text-base shadow-xs placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50 focus-visible:border-ring md:text-sm"
                        placeholder="Misal: Alergi makanan tertentu, dsb."
                    ></textarea>
                </div>
                
                <div class="pt-4 border-t flex justify-end gap-4">
                    <a href="/events/<%= event.id %>" class="inline-flex shrink-0 items-center justify-center gap-2 rounded-md text-sm font-medium whitespace-nowrap transition-all outline-none focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 bg-secondary text-secondary-foreground hover:bg-secondary/80 h-9 px-4 py-2">Batal</a>
                    <button type="submit" class="inline-flex shrink-0 items-center justify-center gap-2 rounded-md text-sm font-medium whitespace-nowrap transition-all outline-none focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 bg-primary text-primary-foreground hover:bg-primary/90 h-9 px-4 py-2">
                        Konfirmasi Pendaftaran
                    </button>
                </div>
            </form>
        </div>
    </div>
  </body>
</html>
