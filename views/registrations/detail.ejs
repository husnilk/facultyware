<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %> - Facultyware</title>
    <link rel="stylesheet" href="/assets/styles.css" />
    <script src="https://unpkg.com/htmx.org@2.0.4"></script>
    <script>
      (() => {
        try {
          if (localStorage.getItem("themeMode") === "dark" || (!localStorage.getItem("themeMode") && matchMedia("(prefers-color-scheme: dark)").matches)) {
            document.documentElement.classList.add("dark");
          }
        } catch (_) {}
      })();
    </script>
    <script>
      (function () {
        try {
          const storedTheme = localStorage.getItem("themeVariant");
          if (storedTheme)
            document.documentElement.classList.add(`theme-${storedTheme}`);
        } catch (event) {
          console.error("Could not apply theme variant", event);
        }
      })();
    </script>
    <style>
      @media (min-width: 768px) {
        .detail-grid {
          display: grid !important;
          grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
          gap: 1.5rem !important;
        }
        .detail-main {
          grid-column: span 2 / span 2 !important;
        }
        .detail-sidebar {
          grid-column: span 1 / span 1 !important;
        }
      }
    </style>
  </head>
  <% 
    const getBannerForType = (type) => {
      switch(type) {
        case 'seminar': return 'https://images.unsplash.com/photo-1508962914676-134849a727f0?w=1200&auto=format&fit=crop';
        case 'workshop': return 'https://images.unsplash.com/photo-1531482615713-2afd69097998?w=1200&auto=format&fit=crop';
        case 'training': return 'https://images.unsplash.com/photo-1524178232363-1fb2b075b655?w=1200&auto=format&fit=crop';
        case 'conference': return 'https://images.unsplash.com/photo-1511578314322-379afb476865?w=1200&auto=format&fit=crop';
        case 'webinar': return 'https://images.unsplash.com/photo-1588196749597-9ff075ee6b5b?w=1200&auto=format&fit=crop';
        default: return 'https://images.unsplash.com/photo-1540575467063-178a50c2df87?w=1200&auto=format&fit=crop';
      }
    }
  %>
  <body class="bg-background text-foreground antialiased p-6 md:p-10">
    <div class="max-w-5xl mx-auto space-y-6">
        
        <header class="flex justify-between items-center pb-6 border-b border-border">
            <div class="flex items-center gap-4">
                <a href="/events" class="inline-flex items-center justify-center rounded-md text-xs font-semibold border border-input bg-background h-8 px-3 hover:bg-accent hover:text-accent-foreground transition-colors">
                    &larr; Kembali
                </a>
                <span class="text-sm font-semibold text-muted-foreground">Detail Event</span>
            </div>
            <% if (user) { %>
                <span class="text-sm text-muted-foreground">Halo, <strong><%= user %></strong></span>
            <% } %>
        </header>

        <!-- Immersive Banner Header -->
        <div class="rounded-xl border border-border overflow-hidden" 
             style="background-image: linear-gradient(to right, rgba(0, 0, 0, 0.85), rgba(0, 0, 0, 0.5)), url('<%= event.banner_image ? event.banner_image : getBannerForType(event.event_type) %>'); background-size: cover; background-position: center; min-height: 14rem; position: relative; padding: 2rem; display: flex; flex-direction: column; justify-content: flex-end;">
            <div class="space-y-2">
                <div class="inline-flex items-center rounded-md px-2.5 py-0.5 text-xs font-semibold" style="background-color: rgba(255, 255, 255, 0.2); color: #fff; backdrop-filter: blur(4px);">
                    <%= event.event_type.toUpperCase() %>
                </div>
                <h2 class="text-2xl font-bold tracking-tight text-white" style="text-shadow: 0 1px 3px rgba(0,0,0,0.5);"><%= event.title %></h2>
            </div>
        </div>

        <main class="detail-grid flex flex-col gap-6">
            <!-- Left Side: Event Details -->
            <div class="detail-main flex flex-col gap-6">
                <!-- Deskripsi & Objectives -->
                <div data-slot="card" class="rounded-xl border border-border bg-card text-card-foreground shadow-md p-6">
                    <h3 class="text-lg font-bold tracking-tight mb-4 border-b border-border pb-2">Deskripsi Event</h3>
                    <p class="text-sm text-muted-foreground whitespace-pre-line leading-relaxed mb-6"><%= event.description %></p>
                    
                    <% if (event.objectives) { %>
                        <h3 class="text-lg font-bold tracking-tight mt-6 mb-4 border-b border-border pb-2">Tujuan & Objektif</h3>
                        <p class="text-sm text-muted-foreground whitespace-pre-line leading-relaxed"><%= event.objectives %></p>
                    <% } %>
                </div>

                <!-- Fasilitas & Benefit Peserta -->
                <div data-slot="card" class="rounded-xl border border-border bg-card text-card-foreground shadow-md p-6">
                    <h3 class="text-lg font-bold tracking-tight mb-4 border-b border-border pb-2">Fasilitas Peserta</h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="flex items-center gap-3">
                            <span class="flex items-center justify-center rounded-full text-green-500" style="background-color: var(--muted); width: 1.5rem; height: 1.5rem; flex-shrink: 0;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                            </span>
                            <span class="text-sm text-muted-foreground">E-Sertifikat Resmi</span>
                        </div>
                        <div class="flex items-center gap-3">
                            <span class="flex items-center justify-center rounded-full text-green-500" style="background-color: var(--muted); width: 1.5rem; height: 1.5rem; flex-shrink: 0;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                            </span>
                            <span class="text-sm text-muted-foreground">E-Ticket dengan QR Code</span>
                        </div>
                        <div class="flex items-center gap-3">
                            <span class="flex items-center justify-center rounded-full text-green-500" style="background-color: var(--muted); width: 1.5rem; height: 1.5rem; flex-shrink: 0;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                            </span>
                            <span class="text-sm text-muted-foreground">Materi Eksklusif Pembicara</span>
                        </div>
                        <div class="flex items-center gap-3">
                            <span class="flex items-center justify-center rounded-full text-green-500" style="background-color: var(--muted); width: 1.5rem; height: 1.5rem; flex-shrink: 0;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                            </span>
                            <span class="text-sm text-muted-foreground">Akses Komunitas & Networking</span>
                        </div>
                    </div>
                </div>

                <!-- Agenda Event -->
                <div data-slot="card" class="rounded-xl border border-border bg-card text-card-foreground shadow-md p-6">
                    <h3 class="text-lg font-bold tracking-tight mb-4 border-b border-border pb-2">Agenda Kegiatan</h3>
                    <div class="space-y-4">
                        <div class="flex gap-4">
                            <div class="flex flex-col items-center">
                                <span class="flex items-center justify-center rounded-full font-bold text-xs" style="background-color: var(--primary); color: var(--primary-foreground); width: 1.5rem; height: 1.5rem; flex-shrink: 0;">1</span>
                                <div class="w-0.5 flex-1" style="background-color: var(--border); min-height: 1.5rem;"></div>
                            </div>
                            <div>
                                <h4 class="text-sm font-bold text-foreground">Sesi Pembukaan & Registrasi Ulang</h4>
                                <p class="text-xs text-muted-foreground"><%= event.start_time ? event.start_time.substring(0, 5) : '08:00' %> - Selesai Persiapan</p>
                            </div>
                        </div>
                        <div class="flex gap-4">
                            <div class="flex flex-col items-center">
                                <span class="flex items-center justify-center rounded-full font-bold text-xs" style="background-color: var(--primary); color: var(--primary-foreground); width: 1.5rem; height: 1.5rem; flex-shrink: 0;">2</span>
                                <div class="w-0.5 flex-1" style="background-color: var(--border); min-height: 1.5rem;"></div>
                            </div>
                            <div>
                                <h4 class="text-sm font-bold text-foreground">Penyampaian Materi & Sesi Interaktif</h4>
                                <p class="text-xs text-muted-foreground">Pembahasan mendalam topik <%= event.title %></p>
                            </div>
                        </div>
                        <div class="flex gap-4">
                            <div class="flex flex-col items-center">
                                <span class="flex items-center justify-center rounded-full font-bold text-xs" style="background-color: var(--primary); color: var(--primary-foreground); width: 1.5rem; height: 1.5rem; flex-shrink: 0;">3</span>
                            </div>
                            <div>
                                <h4 class="text-sm font-bold text-foreground">Sesi Tanya Jawab & Penutupan</h4>
                                <p class="text-xs text-muted-foreground">Q&A, Foto Bersama, dan Pembagian Link Feedback s.d. <%= event.end_time ? event.end_time.substring(0, 5) : 'Selesai' %> WIB</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Side: Sidebar Widget -->
            <div class="detail-sidebar flex flex-col gap-6">
                <div data-slot="card" class="rounded-xl border border-border bg-card text-card-foreground shadow-md p-6">
                    <h3 class="text-base font-bold tracking-tight mb-4 border-b border-border pb-2">Informasi Penting</h3>
                    
                    <div class="space-y-4">
                        <div class="flex items-start gap-3">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground mt-0.5"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                            <div>
                                <span class="block text-xs font-semibold text-muted-foreground" style="letter-spacing: 0.05em;">TANGGAL</span>
                                <span class="text-sm font-medium"><%= new Date(event.start_date).toLocaleDateString('id-ID', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) %></span>
                            </div>
                        </div>
                        
                        <div class="flex items-start gap-3">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground mt-0.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                            <div>
                                <span class="block text-xs font-semibold text-muted-foreground" style="letter-spacing: 0.05em;">WAKTU</span>
                                <span class="text-sm font-medium"><%= event.start_time || '-' %> - <%= event.end_time || '-' %> WIB</span>
                            </div>
                        </div>
                        
                        <div class="flex items-start gap-3">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground mt-0.5"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                            <div>
                                <span class="block text-xs font-semibold text-muted-foreground" style="letter-spacing: 0.05em;">METODE / LOKASI</span>
                                <span class="text-sm font-medium capitalize"><%= event.delivery_mode %></span>
                                <span class="block text-xs text-muted-foreground mt-0.5"><%= event.venue || '-' %></span>
                            </div>
                        </div>

                        <div class="flex items-start gap-3">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground mt-0.5"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                            <div>
                                <span class="block text-xs font-semibold text-muted-foreground" style="letter-spacing: 0.05em;">KUOTA PENDAFTAR</span>
                                <span class="text-sm font-medium"><%= event.quota ? event.quota + ' Orang' : 'Tidak Terbatas' %></span>
                            </div>
                        </div>
                    </div>

                    <!-- Action Button Box -->
                    <div class="border-t border-border mt-6 pt-6">
                        <% if (isRegistered) { %>
                            <div class="p-4 rounded-md border text-center" style="background-color: var(--muted); border-color: var(--border);">
                                <p class="text-xs font-semibold text-foreground">Anda sudah terdaftar di event ini.</p>
                                <a href="/events/<%= event.id %>/register" class="inline-flex items-center justify-center rounded-md text-xs font-semibold bg-primary text-primary-foreground h-9 px-4 mt-3 hover:bg-primary/90 transition-colors w-full">
                                    Lihat Tiket Anda
                                </a>
                            </div>
                        <% } else { %>
                            <a href="/events/<%= event.id %>/register" class="inline-flex items-center justify-center rounded-md text-sm font-semibold bg-primary text-primary-foreground h-10 px-4 hover:bg-primary/90 transition-colors w-full shadow-md">
                                Daftar Sekarang
                            </a>
                        <% } %>
                    </div>
                </div>
            </div>
        </main>
    </div>
  </body>
</html>
