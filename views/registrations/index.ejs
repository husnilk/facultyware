<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %> - Facultyware</title>
    <link rel="stylesheet" href="/assets/styles.css" />
    <script src="https://unpkg.com/htmx.org@2.0.4"></script>
    <script>
      // Simple theme mode logic
      (() => {
        try {
          if (localStorage.getItem("themeMode") === "dark" || (!localStorage.getItem("themeMode") && matchMedia("(prefers-color-scheme: dark)").matches)) {
            document.documentElement.classList.add("dark");
          }
        } catch (_) {}
      })();
    </script>
  </head>
  <body class="bg-background text-foreground antialiased p-6 md:p-10">
    <div class="max-w-6xl mx-auto space-y-8">
        
        <header class="flex justify-between items-center pb-6 border-b">
            <h1 class="text-3xl font-bold">Katalog Event</h1>
            <nav class="flex gap-4 items-center">
                <a href="/home" class="text-sm font-medium hover:underline">Dashboard</a>
                <% if (user) { %>
                    <span class="text-sm text-muted-foreground">Halo, <%= user %></span>
                <% } else { %>
                    <a href="/login" class="text-sm font-medium hover:underline">Login</a>
                <% } %>
            </nav>
        </header>

        <main>
            <form action="/events" method="GET" class="flex gap-2 mb-6">
                <input type="text" name="q" placeholder="Cari event..." value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>" class="flex-1 h-9 rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-xs transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring" />
                <button type="submit" class="inline-flex items-center justify-center rounded-md text-sm font-medium bg-primary text-primary-foreground h-9 px-4 py-2 hover:bg-primary/90">
                    Cari
                </button>
            </form>

            <% if (events && events.length > 0) { %>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    <% events.forEach(event => { %>
                        <div data-slot="card" class="flex flex-col gap-4 rounded-xl border bg-card text-card-foreground shadow-sm p-6 transition-all hover:shadow-md">
                            <div class="space-y-2">
                                <div class="inline-flex items-center rounded-md border px-2.5 py-0.5 text-xs font-semibold text-primary transition-colors focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 border-transparent bg-primary/10 w-fit">
                                    <%= event.event_type.charAt(0).toUpperCase() + event.event_type.slice(1) %>
                                </div>
                                <h3 class="text-xl font-semibold leading-none tracking-tight"><%= event.title %></h3>
                                <p class="text-sm text-muted-foreground line-clamp-2"><%= event.description %></p>
                            </div>
                            
                            <div class="mt-auto pt-4 flex justify-between items-center text-sm border-t">
                                <span class="text-muted-foreground">
                                    <%= new Date(event.start_date).toLocaleDateString('id-ID') %>
                                </span>
                                <a href="/events/<%= event.id %>" class="inline-flex items-center justify-center rounded-md text-sm font-medium bg-primary text-primary-foreground h-9 px-4 py-2 hover:bg-primary/90 transition-colors">
                                    Detail Event
                                </a>
                            </div>
                        </div>
                    <% }) %>
                </div>

                <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
                <div class="flex items-center justify-center space-x-2 mt-8">
                    <% if (currentPage > 1) { %>
                    <a href="?page=<%= currentPage - 1 %><%= searchQuery ? '&q='+searchQuery : '' %>" class="inline-flex items-center justify-center rounded-md text-sm font-medium border border-input bg-background hover:bg-accent hover:text-accent-foreground h-9 w-9">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="m15 18-6-6 6-6"/></svg>
                    </a>
                    <% } %>
                    
                    <span class="text-sm font-medium">Halaman <%= currentPage %> dari <%= totalPages %></span>

                    <% if (currentPage < totalPages) { %>
                    <a href="?page=<%= currentPage + 1 %><%= searchQuery ? '&q='+searchQuery : '' %>" class="inline-flex items-center justify-center rounded-md text-sm font-medium border border-input bg-background hover:bg-accent hover:text-accent-foreground h-9 w-9">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="m9 18 6-6-6-6"/></svg>
                    </a>
                    <% } %>
                </div>
                <% } %>
            <% } else { %>
                <div class="text-center py-12 border rounded-xl bg-card border-dashed">
                    <h3 class="text-lg font-semibold mb-2">Belum ada Event</h3>
                    <p class="text-muted-foreground">Belum ada event yang dipublikasikan saat ini.</p>
                </div>
            <% } %>
        </main>
        
    </div>
  </body>
</html>
