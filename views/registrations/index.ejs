<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %> - Facultyware</title>
    <link rel="stylesheet" href="/assets/styles.css" />
    <script src="https://unpkg.com/htmx.org@2.0.4"></script>
    <script>
      // Simple theme mode logic
      (() => {
        try {
          if (localStorage.getItem("themeMode") === "dark" || (!localStorage.getItem("themeMode") && matchMedia("(prefers-color-scheme: dark)").matches)) {
            document.documentElement.classList.add("dark");
          }
        } catch (_) {}
      })();
    </script>
    <script>
      (function () {
        try {
          const storedTheme = localStorage.getItem("themeVariant");
          if (storedTheme)
            document.documentElement.classList.add(`theme-${storedTheme}`);
        } catch (event) {
          console.error("Could not apply theme variant", event);
        }
      })();
    </script>
  </head>
  <% 
    const getImageForType = (type) => {
      switch(type) {
        case 'seminar': return 'https://images.unsplash.com/photo-1540575467063-178a50c2df87?w=600&auto=format&fit=crop';
        case 'workshop': return 'https://images.unsplash.com/photo-1531482615713-2afd69097998?w=600&auto=format&fit=crop';
        case 'training': return 'https://images.unsplash.com/photo-1524178232363-1fb2b075b655?w=600&auto=format&fit=crop';
        case 'conference': return 'https://images.unsplash.com/photo-1515187029135-18ee286d815b?w=600&auto=format&fit=crop';
        case 'webinar': return 'https://images.unsplash.com/photo-1588196749597-9ff075ee6b5b?w=600&auto=format&fit=crop';
        default: return 'https://images.unsplash.com/photo-1501281668745-f7f57925c3b4?w=600&auto=format&fit=crop';
      }
    }
  %>
  <body class="bg-background text-foreground antialiased p-6 md:p-10">
    <div class="max-w-6xl mx-auto space-y-6">
        
        <header class="flex justify-between items-center pb-6 border-b border-border">
            <div class="flex items-center gap-2">
                <span class="font-bold text-xl tracking-tight">Facultyware</span>
                <span class="text-xs text-muted-foreground bg-muted px-2 py-0.5 rounded">Events</span>
            </div>
            <nav class="flex gap-4 items-center">
                <a href="/home" class="text-sm font-medium hover:underline">Dashboard</a>
                <% if (user) { %>
                    <span class="text-sm text-muted-foreground">Halo, <strong><%= user %></strong></span>
                <% } else { %>
                    <a href="/login" class="text-sm font-medium hover:underline">Login</a>
                <% } %>
            </nav>
        </header>

        <!-- Hero Section -->
        <div class="rounded-xl border border-border p-6 md:p-10 text-center" style="background: linear-gradient(135deg, var(--muted) 0%, var(--background) 100%); margin-bottom: 2rem;">
            <h1 class="text-3xl font-bold tracking-tight mb-2">Temukan Event Terbaik</h1>
            <p class="text-muted-foreground text-sm max-w-xl mx-auto mb-6">Jelajahi berbagai seminar, workshop, dan pelatihan untuk mengembangkan skill dan karir Anda bersama Facultyware.</p>
            
            <form action="/events" method="GET" class="flex gap-3 max-w-md mx-auto">
                <input type="text" name="q" placeholder="Cari berdasarkan judul atau deskripsi..." value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>" class="flex-1 h-10 rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-xs transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring" />
                <button type="submit" class="inline-flex items-center justify-center rounded-md text-sm font-medium bg-primary text-primary-foreground h-10 px-4 py-2 hover:bg-primary/90 transition-colors">
                    Cari Event
                </button>
            </form>
        </div>

        <main>
            <div class="flex items-center justify-between mb-6">
                <h2 class="text-xl font-bold tracking-tight">
                    <%= typeof searchQuery !== 'undefined' && searchQuery ? `Hasil Pencarian untuk "${searchQuery}"` : 'Semua Event Terbaru' %>
                </h2>
                <span class="text-xs text-muted-foreground bg-muted px-2.5 py-1 rounded-full"><%= events.length %> Event Ditemukan</span>
            </div>

            <% if (events && events.length > 0) { %>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    <% events.forEach(event => { %>
                        <div data-slot="card" class="flex flex-col gap-4 rounded-xl border border-border bg-card text-card-foreground shadow-md overflow-hidden hover:shadow-xl transition-all duration-200">
                            <!-- Cover Image -->
                            <div class="relative w-full h-36 overflow-hidden">
                                <img 
                                    src="<%= event.cover_image ? event.cover_image : getImageForType(event.event_type) %>" 
                                    alt="<%= event.title %>" 
                                    class="w-full h-full object-cover" 
                                />
                                <!-- Event Type Badge -->
                                <div class="absolute top-3 left-3 inline-flex items-center rounded-md px-2 py-0.5 text-xs font-semibold" style="background-color: var(--background); border: 1px solid var(--border); box-shadow: 0 1px 2px rgba(0,0,0,0.15);">
                                    <%= event.event_type.charAt(0).toUpperCase() + event.event_type.slice(1) %>
                                </div>
                            </div>

                            <!-- Content -->
                            <div class="p-4 flex flex-col flex-1 gap-3" style="padding-top: 0;">
                                <h3 class="text-lg font-bold tracking-tight line-clamp-1"><%= event.title %></h3>
                                <p class="text-sm text-muted-foreground line-clamp-2" style="min-height: 2.5rem;"><%= event.description %></p>
                                
                                <!-- Info metadata -->
                                <div class="space-y-1.5 text-xs text-muted-foreground" style="margin-top: 0.5rem;">
                                    <div class="flex items-center gap-2">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                                        <span><%= new Date(event.start_date).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                                        <span class="truncate"><%= event.delivery_mode === 'online' ? 'Online' : (event.venue || 'Offline') %></span>
                                    </div>
                                </div>

                                <!-- CTA button -->
                                <div class="pt-3 border-t border-border flex justify-end" style="margin-top: auto;">
                                    <a href="/events/<%= event.id %>" class="inline-flex items-center justify-center rounded-md text-xs font-semibold bg-primary text-primary-foreground h-8 px-3 hover:bg-primary/90 transition-colors">
                                        Detail Event
                                    </a>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>

                <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
                <div class="flex items-center justify-center space-x-2 mt-8">
                    <% if (currentPage > 1) { %>
                    <a href="?page=<%= currentPage - 1 %><%= searchQuery ? '&q='+searchQuery : '' %>" class="inline-flex items-center justify-center rounded-md text-sm font-medium border border-input bg-background hover:bg-accent hover:text-accent-foreground h-9 w-9">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="m15 18-6-6 6-6"/></svg>
                    </a>
                    <% } %>
                    
                    <span class="text-sm font-medium">Halaman <%= currentPage %> dari <%= totalPages %></span>

                    <% if (currentPage < totalPages) { %>
                    <a href="?page=<%= currentPage + 1 %><%= searchQuery ? '&q='+searchQuery : '' %>" class="inline-flex items-center justify-center rounded-md text-sm font-medium border border-input bg-background hover:bg-accent hover:text-accent-foreground h-9 w-9">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="m9 18 6-6-6-6"/></svg>
                    </a>
                    <% } %>
                </div>
                <% } %>
            <% } else { %>
                <div class="text-center py-12 border border-border border-dashed rounded-xl bg-card">
                    <h3 class="text-lg font-semibold mb-2">Belum ada Event</h3>
                    <p class="text-muted-foreground text-sm">Belum ada event yang dipublikasikan saat ini.</p>
                </div>
            <% } %>
        </main>
        
    </div>
  </body>
</html>
