<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Kategori - Facultyware</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        appbg: '#000000',       
                        panel: '#0a0a0a',       
                        surface: '#171717',     
                        edge: '#262626',        
                        primary: '#ededed',     
                        muted: '#a3a3a3',       
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-appbg text-primary antialiased flex h-screen overflow-hidden font-sans">

    <aside class="w-64 bg-panel border-r border-edge flex flex-col h-full flex-shrink-0 z-20">
        <div class="h-16 flex items-center px-6 border-b border-edge">
            <span class="text-emerald-500 font-black text-xl italic tracking-tighter mr-2">//</span>
            <span class="font-bold text-sm tracking-widest text-primary uppercase">Facultyware</span>
        </div>
        
        <nav class="flex-1 px-4 py-6 space-y-1.5 overflow-y-auto">
            <p class="px-2 text-[10px] font-semibold text-muted uppercase tracking-widest mb-3">Menu</p>
            
            <a href="/kategori" class="flex items-center px-3 py-2 text-sm font-medium rounded-md bg-surface text-primary border border-edge/50">
                Data Kategori
            </a>
            
            <a href="/item" class="flex items-center px-3 py-2 text-sm font-medium rounded-md text-muted hover:text-primary hover:bg-surface transition-all">
                Data Item
            </a>
        </nav>

        <div class="p-4 border-t border-edge bg-panel">
            <div class="flex items-center gap-3 px-2">
                <div class="w-8 h-8 rounded-full bg-surface border border-edge flex items-center justify-center text-xs font-bold text-emerald-500">AD</div>
                <div>
                    <p class="text-sm font-medium text-primary leading-none">Admin</p>
                    <p class="text-xs text-muted mt-1">Sistem Inventaris</p>
                </div>
            </div>
        </div>
    </aside>

    <main class="flex-1 flex flex-col h-full overflow-hidden bg-appbg relative">
        
        <header class="h-16 flex items-center justify-between px-8 border-b border-edge bg-appbg sticky top-0 z-10">
            <h2 class="text-sm font-medium text-muted">
                Dashboard <span class="mx-2">/</span> 
                <a href="/kategori" class="hover:text-primary transition-colors">Data Kategori</a> <span class="mx-2">/</span> 
                <span class="text-primary">Edit Kategori</span>
            </h2>
            <a href="/logout" class="text-sm font-medium text-muted hover:text-primary transition-colors">Logout</a>
        </header>

        <div class="flex-1 overflow-y-auto p-8" id="dashboard-content">
            
            <div class="max-w-2xl mx-auto">
                <div class="mb-8">
                    <h1 class="text-2xl font-semibold text-primary tracking-tight">Edit Data Kategori</h1>
                    <p class="text-sm text-muted mt-1">Perbarui informasi untuk kategori <span class="font-bold text-emerald-500"><%= category.name %></span>.</p>
                </div>

                <div class="bg-panel border border-edge rounded-lg shadow-xl shadow-black/20 p-6 md:p-8">
                    <form action="/kategori/edit/<%= category.id %>" method="POST" class="space-y-6">
                        
                        <div class="space-y-1.5">
                            <label for="name" class="block text-sm font-medium text-primary">Nama Kategori</label>
                            <input type="text" id="name" name="name" required value="<%= category.name %>"
                                class="w-full bg-appbg border border-edge text-primary text-sm rounded-md focus:ring-1 focus:ring-emerald-500/50 focus:border-emerald-500/50 block p-2.5 outline-none transition-all placeholder-edge">
                        </div>

                        <div class="space-y-1.5">
                            <label for="description" class="block text-sm font-medium text-primary">Deskripsi (Opsional)</label>
                            <textarea id="description" name="description" rows="4" 
                                class="w-full bg-appbg border border-edge text-primary text-sm rounded-md focus:ring-1 focus:ring-emerald-500/50 focus:border-emerald-500/50 block p-2.5 outline-none transition-all placeholder-edge resize-none"><%= category.description %></textarea>
                        </div>

                        <div class="flex items-center justify-end gap-3 pt-4 border-t border-edge">
                            <a href="/kategori" class="text-sm font-medium text-muted hover:text-primary px-4 py-2 transition-colors">
                                Batal
                            </a>
                            <button type="submit" class="bg-primary hover:bg-white text-appbg px-6 py-2 rounded-md text-sm font-bold transition-all shadow-[0_0_15px_rgba(16,185,129,0.15)] hover:shadow-[0_0_20px_rgba(16,185,129,0.3)] ring-1 ring-emerald-500/30">
                                Update Kategori
                            </button>
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </main>
</body>
</html>