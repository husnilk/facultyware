<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <!-- CSS Utama (Tailwind & Basecoat) -->
    <link rel="stylesheet" href="/assets/styles.css" />
    <style>
        /* Custom Status Badges */
        .status-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 4px 10px;
            border-radius: 9999px;
            font-size: 0.75rem;
            font-weight: 600;
            border: 1px solid transparent;
            text-transform: capitalize;
            white-space: nowrap;
        }

        .status-pending {
            background-color: #fef3c7;
            /* amber-100 */
            color: #92400e;
            /* amber-800 */
            border-color: #fcd34d;
            /* amber-300 */
        }

        .status-approved {
            background-color: #d1fae5;
            /* emerald-100 */
            color: #065f46;
            /* emerald-800 */
            border-color: #6ee7b7;
            /* emerald-300 */
        }

        .status-rejected {
            background-color: #fee2e2;
            /* red-100 */
            color: #991b1b;
            /* red-800 */
            border-color: #fca5a5;
            /* red-300 */
        }

        .status-cancelled {
            background-color: #f3f4f6;
            /* gray-100 */
            color: #374151;
            /* gray-800 */
            border-color: #d1d5db;
            /* gray-300 */
        }
    </style>
    <!-- Script HTMX untuk interaksi SPA -->
    <script src="https://unpkg.com/htmx.org@2.0.4"></script>
    <!-- Modul Basecoat JS -->
    <script src="/assets/js/sidebar.js" defer></script>

    <script>
        // Inisialisasi Tema Gelap/Terang
        (() => {
            try {
                const stored = localStorage.getItem("themeMode");
                if (stored ? stored === "dark" : matchMedia("(prefers-color-scheme: dark)").matches) {
                    document.documentElement.classList.add("dark");
                }
            } catch (_) { }
        })();
    </script>
</head>

<body class="bg-background text-foreground antialiased min-h-screen flex">

    <!-- Render Partial Sidebar -->
    <%- include('../../partials/sidebarAtasan') %>

        <!-- Konten Utama -->
        <main id="content" class="flex-1 min-w-0 transition-all duration-300">

            <!-- Header Atas -->
            <header
                class="bg-background sticky inset-x-0 top-0 isolate flex shrink-0 items-center gap-2 border-b z-10 px-4 h-14">
                <!-- Tombol Toggle Sidebar (Mobile) -->
                <button type="button" onclick="document.dispatchEvent(new CustomEvent('basecoat:sidebar'))"
                    class="btn-sm-icon-ghost md:hidden">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect width="18" height="18" x="3" y="3" rx="2" />
                        <path d="M9 3v18" />
                    </svg>
                </button>
                <div class="font-semibold text-lg ml-2">Panel Atasan</div>

                <div class="ml-auto flex items-center gap-2">
                    <button type="button" aria-label="Toggle dark mode"
                        onclick="document.documentElement.classList.toggle('dark'); localStorage.setItem('themeMode', document.documentElement.classList.contains('dark') ? 'dark' : 'light');"
                        class="btn-icon-outline size-8">
                        <span class="hidden dark:block"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                                viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="4" />
                                <path d="M12 2v2" />
                                <path d="M12 20v2" />
                                <path d="m4.93 4.93 1.41 1.41" />
                                <path d="m17.66 17.66 1.41 1.41" />
                                <path d="M2 12h2" />
                                <path d="M20 12h2" />
                                <path d="m6.34 17.66-1.41 1.41" />
                                <path d="m19.07 4.93-1.41 1.41" />
                            </svg></span>
                        <span class="block dark:hidden"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                                viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
                            </svg></span>
                    </button>
                </div>
            </header>

            <!-- Container Konten -->
            <div class="p-4 md:p-6 xl:p-8 max-w-[1200px] mx-auto">

                <!-- Judul Halaman -->
                <header class="flex flex-col gap-4 mb-6">
                    <div>
                        <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">
                            <%= title %>
                        </h1>
                        <p class="text-muted-foreground mt-1">Informasi lengkap pengajuan cuti pegawai.</p>
                    </div>
                </header>

                <!-- Tombol Kembali -->
                <div class="mb-6">
                    <a href="/atasan/cuti" class="btn-outline inline-flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m12 19-7-7 7-7" />
                            <path d="M19 12H5" />
                        </svg>
                        Kembali ke Daftar
                    </a>
                </div>

                <div class="flex flex-col gap-6 mb-6">
                    
                    <!-- Card Informasi Pegawai -->
                    <div class="card p-6 shadow-sm border border-border">
                        <h2 class="text-lg font-semibold mb-4 border-b pb-2">Informasi Pegawai</h2>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div>
                                <label class="text-xs font-medium text-muted-foreground uppercase tracking-wider">Nama Lengkap</label>
                                <p class="text-base font-medium mt-1"><%= request.employee_name %></p>
                            </div>
                            <div>
                                <label class="text-xs font-medium text-muted-foreground uppercase tracking-wider">Nomor Pegawai (NIP)</label>
                                <p class="text-base font-medium mt-1"><%= request.employee_nip %></p>
                            </div>
                        </div>
                    </div>

                    <!-- Card Detail Pengajuan Cuti -->
                    <div class="card p-6 shadow-sm border border-border">
                        <div class="flex justify-between items-center mb-6 border-b pb-4">
                            <h2 class="text-xl font-semibold">Data Pengajuan Cuti</h2>
                            
                            <!-- Badge Status Utama -->
                            <% if (request.status === 'pending') { %>
                                <span class="status-badge status-pending">Pending</span>
                            <% } else if (request.status === 'approved') { %>
                                <span class="status-badge status-approved">Approved</span>
                            <% } else if (request.status === 'rejected') { %>
                                <span class="status-badge status-rejected">Rejected</span>
                            <% } else if (request.status === 'cancelled') { %>
                                <span class="status-badge status-cancelled">Cancelled</span>
                            <% } else { %>
                                <span class="status-badge status-cancelled"><%= request.status || '-' %></span>
                            <% } %>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-y-6 gap-x-8">
                            
                            <div class="col-span-1 md:col-span-2">
                                <label class="text-xs font-medium text-muted-foreground uppercase tracking-wider">Jenis Cuti</label>
                                <p class="text-lg font-medium mt-1"><%= request.leave_type_name %></p>
                            </div>

                            <div>
                                <label class="text-xs font-medium text-muted-foreground uppercase tracking-wider">Tanggal Mulai</label>
                                <div class="flex items-center gap-2 mt-1">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                                    <p class="text-base font-medium"><%= request.start_date ? new Date(request.start_date).toLocaleDateString('id-ID', { day: '2-digit', month: 'long', year: 'numeric' }) : '-' %></p>
                                </div>
                            </div>

                            <div>
                                <label class="text-xs font-medium text-muted-foreground uppercase tracking-wider">Tanggal Selesai</label>
                                <div class="flex items-center gap-2 mt-1">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                                    <p class="text-base font-medium"><%= request.end_date ? new Date(request.end_date).toLocaleDateString('id-ID', { day: '2-digit', month: 'long', year: 'numeric' }) : '-' %></p>
                                </div>
                            </div>

                            <div>
                                <label class="text-xs font-medium text-muted-foreground uppercase tracking-wider">Jumlah Hari Cuti</label>
                                <p class="text-base font-medium mt-1"><%= request.total_days || '-' %> Hari</p>
                            </div>

                            <div>
                                <label class="text-xs font-medium text-muted-foreground uppercase tracking-wider">Dibuat Pada</label>
                                <p class="text-base mt-1"><%= request.created_at ? new Date(request.created_at).toLocaleDateString('id-ID') : '-' %></p>
                            </div>

                            <div class="col-span-1 md:col-span-2 mt-4">
                                <label class="text-xs font-medium text-muted-foreground uppercase tracking-wider mb-2 block">Alasan / Deskripsi Cuti</label>
                                <div class="bg-muted/10 p-4 rounded-lg border border-border min-h-[80px]">
                                    <% if (request.reason) { %>
                                        <p class="whitespace-pre-wrap"><%= request.reason %></p>
                                    <% } else { %>
                                        <p class="text-muted-foreground italic">Tidak ada deskripsi atau alasan yang diberikan.</p>
                                    <% } %>
                                </div>
                            </div>

                        </div>
                    </div>

                </div>

                <!-- Card Riwayat Approval (Full Width) -->
                <div class="card p-6 shadow-sm border border-border mb-6">
                    <h2 class="text-lg font-semibold mb-4 border-b pb-2">Riwayat Approval</h2>

                    <% if (approvals && approvals.length> 0) { %>
                        <div class="space-y-4">
                            <% approvals.forEach(appr=> { %>
                                <div
                                    class="flex flex-col p-4 bg-muted/10 rounded-lg border border-border relative overflow-hidden">
                                    <div class="flex flex-wrap justify-between items-start mb-2 gap-2">
                                        <div>
                                            <span class="font-medium text-sm block">
                                                <%= appr.approver_name || 'Sistem' %>
                                            </span>
                                            <span class="text-xs text-muted-foreground">
                                                <%= appr.created_at ? new Date(appr.created_at).toLocaleString('id-ID',
                                                    { day: 'numeric' , month: 'short' , year: 'numeric' ,
                                                    hour: '2-digit' , minute:'2-digit' }) : '-' %>
                                            </span>
                                        </div>

                                        <!-- Badge Status Riwayat -->
                                        <% if (appr.status==='pending' ) { %>
                                            <span class="status-badge status-pending">Pending</span>
                                            <% } else if (appr.status==='approved' ) { %>
                                                <span class="status-badge status-approved">Approved</span>
                                                <% } else if (appr.status==='rejected' ) { %>
                                                    <span class="status-badge status-rejected">Rejected</span>
                                                    <% } else if (appr.status==='cancelled' ) { %>
                                                        <span class="status-badge status-cancelled">Cancelled</span>
                                                        <% } else { %>
                                                            <span class="status-badge status-cancelled">
                                                                <%= appr.status %>
                                                            </span>
                                                            <% } %>
                                    </div>

                                    <% if (appr.comments) { %>
                                        <div
                                            class="mt-2 text-sm bg-white dark:bg-slate-900 p-3 rounded border border-border shadow-sm">
                                            <span class="text-muted-foreground italic mr-1">Catatan:</span> "<%=
                                                appr.comments %>"
                                        </div>
                                        <% } %>
                                </div>
                                <% }) %>
                        </div>
                        <% } else { %>
                            <div
                                class="flex flex-col items-center justify-center py-8 text-center text-muted-foreground">
                                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24"
                                    fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
                                    stroke-linejoin="round" class="opacity-30 mb-3">
                                    <circle cx="12" cy="12" r="10" />
                                    <polyline points="12 6 12 12 16 14" />
                                </svg>
                                <p class="text-sm">Belum ada riwayat approval tercatat pada sistem.</p>
                            </div>
                            <% } %>
                </div>

            </div>
        </main>

</body>

</html>