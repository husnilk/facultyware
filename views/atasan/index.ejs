<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <!-- CSS Utama (Tailwind & Basecoat) -->
    <link rel="stylesheet" href="/assets/styles.css" />

    <style>
      .filter-card-header {
        margin-bottom: 20px;
        padding-bottom: 16px;
        border-bottom: 1px solid var(--border, #e5e7eb);
      }
      .filter-title {
        font-size: 1.125rem;
        font-weight: 600;
        color: var(--foreground);
        margin-bottom: 4px;
      }
      .filter-subtitle {
        font-size: 0.875rem;
        color: var(--muted-foreground, #6b7280);
      }

      .filter-form-row {
        display: grid;
        grid-template-columns: minmax(320px, 2fr) minmax(160px, 0.7fr) minmax(220px, 0.9fr) auto auto;
        gap: 16px;
        align-items: end;
      }

      .filter-form-row label {
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--muted-foreground, #6b7280);
        margin-bottom: 6px;
        display: block;
      }

      .filter-field {
        min-width: 0;
        position: relative;
      }

      .filter-field input,
      .filter-field select,
      .filter-btn,
      .reset-btn {
        height: 40px;
        border-radius: 6px;
        width: 100%;
      }

      .search-icon {
        position: absolute;
        left: 12px;
        bottom: 12px;
        color: #9ca3af;
        pointer-events: none;
      }

      .filter-field input {
        padding-left: 36px;
      }

      .filter-btn, .reset-btn {
        min-width: 72px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0 16px;
      }

      @media (max-width: 900px) {
        .filter-form-row {
          grid-template-columns: 1fr;
        }
      }

      /* Custom Status Badges */
      .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 4px 10px;
        border-radius: 9999px;
        font-size: 0.75rem;
        font-weight: 600;
        border: 1px solid transparent;
        text-transform: capitalize;
        white-space: nowrap;
      }
      .status-pending {
        background-color: #fef3c7; /* amber-100 */
        color: #92400e; /* amber-800 */
        border-color: #fcd34d; /* amber-300 */
      }
      .status-approved {
        background-color: #d1fae5; /* emerald-100 */
        color: #065f46; /* emerald-800 */
        border-color: #6ee7b7; /* emerald-300 */
      }
      .status-rejected {
        background-color: #fee2e2; /* red-100 */
        color: #991b1b; /* red-800 */
        border-color: #fca5a5; /* red-300 */
      }
      .status-cancelled {
        background-color: #f3f4f6; /* gray-100 */
        color: #374151; /* gray-800 */
        border-color: #d1d5db; /* gray-300 */
      }
    </style>
    <!-- Script HTMX untuk interaksi SPA -->
    <script src="https://unpkg.com/htmx.org@2.0.4"></script>
    <!-- Modul Basecoat JS -->
    <script src="/assets/js/sidebar.js" defer></script>
    
    <script>
      // Inisialisasi Tema Gelap/Terang
      (() => {
        try {
          const stored = localStorage.getItem("themeMode");
          if (stored ? stored === "dark" : matchMedia("(prefers-color-scheme: dark)").matches) {
            document.documentElement.classList.add("dark");
          }
        } catch (_) {}
      })();
    </script>
</head>
<body class="bg-background text-foreground antialiased min-h-screen flex">
    
    <!-- Render Partial Sidebar -->
    <%- include('../layouts/sidebar') %>

    <!-- Konten Utama -->
    <main id="content" class="flex-1 min-w-0 transition-all duration-300">
        
        <!-- Header -->
        <header class="bg-background sticky inset-x-0 top-0 isolate flex shrink-0 items-center gap-2 border-b z-10 px-4 h-14">
            <!-- Tombol Toggle Sidebar (Mobile) -->
            <button type="button" onclick="document.dispatchEvent(new CustomEvent('basecoat:sidebar'))" class="btn-sm-icon-ghost md:hidden">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect width="18" height="18" x="3" y="3" rx="2" />
                    <path d="M9 3v18" />
                </svg>
            </button>
            <div class="font-semibold text-lg ml-2">Panel Atasan</div>
            
            <!-- Tambahan switcher tema untuk konsistensi -->
            <div class="ml-auto flex items-center gap-2">
                <button type="button" aria-label="Toggle dark mode" onclick="document.documentElement.classList.toggle('dark'); localStorage.setItem('themeMode', document.documentElement.classList.contains('dark') ? 'dark' : 'light');" class="btn-icon-outline size-8">
                    <span class="hidden dark:block"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg></span>
                    <span class="block dark:hidden"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg></span>
                </button>
            </div>
        </header>

        <div class="p-4 md:p-6 xl:p-12 max-w-screen-xl mx-auto">
            
            <header class="flex flex-col gap-4 mb-8">
                <h1 class="text-2xl font-bold tracking-tight sm:text-3xl md:text-4xl"><%= title %></h1>
                <p class="text-muted-foreground sm:text-lg">Mengelola dan memantau riwayat pengajuan cuti pegawai.</p>
            </header>

            <!-- Card Filter dan Pencarian -->
            <div class="card p-6 mb-6 shadow-sm border border-border">
                <div class="filter-card-header">
                    <h2 class="filter-title">Filter Pengajuan</h2>
                    <p class="filter-subtitle">Cari dan saring data pengajuan cuti pegawai.</p>
                </div>

                <!-- Form menggunakan method GET karena hanya membaca data -->
                <form method="GET" action="/atasan/cuti" class="filter-form-row">
                    
                    <div class="filter-field search-field">
                        <label>Cari Pegawai</label>
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="search-icon"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                        <input type="text" name="search" class="input border-gray-300" placeholder="Ketik nama pegawai..." value="<%= search %>">
                    </div>
                    
                    <div class="filter-field status-field">
                        <label>Status</label>
                        <select name="status" class="select bg-background border-gray-300">
                            <option value="">Semua Status</option>
                            <option value="pending" <%= status === 'pending' ? 'selected' : '' %>>Pending</option>
                            <option value="approved" <%= status === 'approved' ? 'selected' : '' %>>Approved</option>
                            <option value="rejected" <%= status === 'rejected' ? 'selected' : '' %>>Rejected</option>
                            <option value="cancelled" <%= status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
                        </select>
                    </div>
                    
                    <div class="filter-field type-field">
                        <label>Jenis Cuti</label>
                        <select name="leave_type_id" class="select bg-background border-gray-300">
                            <option value="">Semua Jenis</option>
                            <% leaveTypes.forEach(lt => { %>
                                <option value="<%= lt.id %>" <%= leaveTypeId == lt.id ? 'selected' : '' %>><%= lt.name %></option>
                            <% }); %>
                        </select>
                    </div>
                    
                    <button type="submit" class="btn filter-btn">Filter</button>
                    <a href="/atasan/cuti" class="btn-outline reset-btn">Reset</a>
                </form>
            </div>

            <!-- Card Tabel Data -->
            <div class="card overflow-hidden shadow-sm border border-border">
                <div class="overflow-x-auto">
                    <table class="table w-full text-sm text-left">
                        <thead class="bg-muted text-muted-foreground border-b border-border">
                            <tr>
                                <th class="px-4 py-3.5 font-medium whitespace-nowrap">No</th>
                                <th class="px-4 py-3.5 font-medium whitespace-nowrap">Nama Pegawai</th>
                                <th class="px-4 py-3.5 font-medium whitespace-nowrap">Jenis Cuti</th>
                                <th class="px-4 py-3.5 font-medium whitespace-nowrap">Tgl Mulai</th>
                                <th class="px-4 py-3.5 font-medium whitespace-nowrap">Tgl Selesai</th>
                                <th class="px-4 py-3.5 font-medium text-center whitespace-nowrap">Jumlah Hari</th>
                                <th class="px-4 py-3.5 font-medium text-center whitespace-nowrap">Status</th>
                                <th class="px-4 py-3.5 font-medium text-center whitespace-nowrap">Aksi</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-border">
                            <% if (requests.length === 0) { %>
                                <tr>
                                    <td colspan="8" class="px-4 py-12 text-center text-muted-foreground">
                                        <div class="flex flex-col items-center justify-center">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="opacity-20 mb-2"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/><path d="M8 14h.01"/><path d="M12 14h.01"/><path d="M16 14h.01"/><path d="M8 18h.01"/><path d="M12 18h.01"/><path d="M16 18h.01"/></svg>
                                            Belum ada pengajuan cuti.
                                        </div>
                                    </td>
                                </tr>
                            <% } else { %>
                                <% requests.forEach((reqItem, index) => { %>
                                    <tr class="hover:bg-muted/30 transition-colors">
                                        <td class="px-4 py-3 text-muted-foreground"><%= (page - 1) * 10 + index + 1 %></td>
                                        <td class="px-4 py-3 font-medium"><%= reqItem.employee_name %></td>
                                        <td class="px-4 py-3 text-muted-foreground"><%= reqItem.leave_type_name %></td>
                                        
                                        <!-- Menampilkan tanggal dalam format lokal ID -->
                                        <td class="px-4 py-3 text-muted-foreground"><%= new Date(reqItem.start_date).toLocaleDateString('id-ID', {day: '2-digit', month: 'short', year: 'numeric'}) %></td>
                                        <td class="px-4 py-3 text-muted-foreground"><%= new Date(reqItem.end_date).toLocaleDateString('id-ID', {day: '2-digit', month: 'short', year: 'numeric'}) %></td>
                                        
                                        <td class="px-4 py-3 text-center"><%= reqItem.total_days %> Hari</td>
                                        <td class="px-4 py-3 text-center">
                                            <!-- Penggunaan badge status yang bersih sesuai instruksi -->
                                            <% if (reqItem.status === 'pending') { %>
                                                <span class="status-badge status-pending">Pending</span>
                                            <% } else if (reqItem.status === 'approved') { %>
                                                <span class="status-badge status-approved">Approved</span>
                                            <% } else if (reqItem.status === 'rejected') { %>
                                                <span class="status-badge status-rejected">Rejected</span>
                                            <% } else if (reqItem.status === 'cancelled') { %>
                                                <span class="status-badge status-cancelled">Cancelled</span>
                                            <% } else { %>
                                                <span class="status-badge status-cancelled"><%= reqItem.status %></span>
                                            <% } %>
                                        </td>
                                        <td class="px-4 py-3 text-center">
                                            <!-- Tombol Detail -->
                                            <a href="/atasan/cuti/<%= reqItem.id %>" class="inline-block px-4 py-1.5 bg-white border border-gray-400 text-black font-semibold rounded-md shadow-sm hover:bg-gray-200 transition-colors">Detail</a>
                                        </td>
                                    </tr>
                                <% }); %>
                            <% } %>
                        </tbody>
                    </table>
                </div>

                <!-- Pagination Navigasi -->
                <% if (totalPages > 1) { %>
                <div class="border-t border-border px-4 py-4 flex items-center justify-between bg-muted/20">
                    <p class="text-sm text-muted-foreground">
                        Halaman <span class="font-medium text-foreground"><%= page %></span> dari <span class="font-medium text-foreground"><%= totalPages %></span>
                    </p>
                    <div class="flex gap-2">
                        <!-- Tombol Previous -->
                        <% if (page > 1) { %>
                            <a href="/atasan/cuti?page=<%= page - 1 %>&search=<%= search %>&status=<%= status %>&leave_type_id=<%= leaveTypeId %>" class="btn-sm btn-outline">Sebelumnya</a>
                        <% } else { %>
                            <button class="btn-sm btn-outline opacity-50 cursor-not-allowed" disabled>Sebelumnya</button>
                        <% } %>

                        <!-- Tombol Next -->
                        <% if (page < totalPages) { %>
                            <a href="/atasan/cuti?page=<%= page + 1 %>&search=<%= search %>&status=<%= status %>&leave_type_id=<%= leaveTypeId %>" class="btn-sm btn-outline">Selanjutnya</a>
                        <% } else { %>
                            <button class="btn-sm btn-outline opacity-50 cursor-not-allowed" disabled>Selanjutnya</button>
                        <% } %>
                    </div>
                </div>
                <% } %>
            </div>

        </div>
    </main>

</body>
</html>
