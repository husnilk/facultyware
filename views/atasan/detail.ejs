<style>
    .status-badge { display: inline-flex; align-items: center; justify-content: center; padding: 4px 10px; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; text-transform: capitalize; white-space: nowrap; }
    .status-pending { background-color: #fef3c7; color: #92400e; }
    .status-approved { background-color: #d1fae5; color: #065f46; }
    .status-rejected { background-color: #fee2e2; color: #991b1b; }
    .status-cancelled { background-color: #f3f4f6; color: #374151; }
</style>

<div class="max-w-[1200px] mx-auto w-full">
    <header class="flex flex-col gap-2 mb-6">
        <h1 class="text-2xl font-bold tracking-tight sm:text-3xl text-gray-900"><%= title %></h1>
        <p class="text-gray-500 mt-1">Informasi lengkap pengajuan cuti pegawai.</p>
    </header>

    <div class="mb-6">
        <a href="/atasan/cuti" class="inline-flex items-center gap-2 px-4 py-2 bg-white border border-gray-300 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7" /><path d="M19 12H5" /></svg>
            Kembali ke Daftar
        </a>
    </div>

    <div class="flex flex-col gap-6 mb-6">
        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-200">
            <h2 class="text-lg font-semibold mb-4 border-b border-gray-100 pb-2 text-gray-800">Informasi Pegawai</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="text-xs font-medium text-gray-500 uppercase tracking-wider">Nama Lengkap</label>
                    <p class="text-base font-medium mt-1 text-gray-900"><%= request.employee_name %></p>
                </div>
                <div>
                    <label class="text-xs font-medium text-gray-500 uppercase tracking-wider">Nomor Pegawai (NIP)</label>
                    <p class="text-base font-medium mt-1 text-gray-900"><%= request.employee_nip %></p>
                </div>
            </div>
        </div>

        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-200">
            <div class="flex justify-between items-center mb-6 border-b border-gray-100 pb-4">
                <h2 class="text-xl font-semibold text-gray-800">Data Pengajuan Cuti</h2>
                <% if (request.status === 'pending') { %><span class="status-badge status-pending">Pending</span>
                <% } else if (request.status === 'approved') { %><span class="status-badge status-approved">Approved</span>
                <% } else if (request.status === 'rejected') { %><span class="status-badge status-rejected">Rejected</span>
                <% } else if (request.status === 'cancelled') { %><span class="status-badge status-cancelled">Cancelled</span>
                <% } else { %><span class="status-badge status-cancelled"><%= request.status || '-' %></span><% } %>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-y-6 gap-x-8">
                <div class="col-span-1 md:col-span-2">
                    <label class="text-xs font-medium text-gray-500 uppercase tracking-wider">Jenis Cuti</label>
                    <p class="text-lg font-medium mt-1 text-gray-900"><%= request.leave_type_name %></p>
                </div>
                <div>
                    <label class="text-xs font-medium text-gray-500 uppercase tracking-wider">Tanggal Mulai</label>
                    <div class="flex items-center gap-2 mt-1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-400"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                        <p class="text-base font-medium text-gray-900"><%= request.start_date ? new Date(request.start_date).toLocaleDateString('id-ID', { day: '2-digit', month: 'long', year: 'numeric' }) : '-' %></p>
                    </div>
                </div>
                <div>
                    <label class="text-xs font-medium text-gray-500 uppercase tracking-wider">Tanggal Selesai</label>
                    <div class="flex items-center gap-2 mt-1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-400"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                        <p class="text-base font-medium text-gray-900"><%= request.end_date ? new Date(request.end_date).toLocaleDateString('id-ID', { day: '2-digit', month: 'long', year: 'numeric' }) : '-' %></p>
                    </div>
                </div>
                <div>
                    <label class="text-xs font-medium text-gray-500 uppercase tracking-wider">Jumlah Hari Cuti</label>
                    <p class="text-base font-medium mt-1 text-gray-900"><%= request.total_days || '-' %> Hari</p>
                </div>
                <div>
                    <label class="text-xs font-medium text-gray-500 uppercase tracking-wider">Dibuat Pada</label>
                    <p class="text-base mt-1 text-gray-900"><%= request.created_at ? new Date(request.created_at).toLocaleDateString('id-ID') : '-' %></p>
                </div>
                <div class="col-span-1 md:col-span-2 mt-4">
                    <label class="text-xs font-medium text-gray-500 uppercase tracking-wider mb-2 block">Alasan / Deskripsi Cuti</label>
                    <div class="bg-gray-50 p-4 rounded-lg border border-gray-200 min-h-[80px]">
                        <% if (request.reason) { %>
                            <p class="whitespace-pre-wrap text-gray-800"><%= request.reason %></p>
                        <% } else { %>
                            <p class="text-gray-400 italic">Tidak ada deskripsi atau alasan yang diberikan.</p>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-200 mb-6">
        <h2 class="text-lg font-semibold mb-4 border-b border-gray-100 pb-2 text-gray-800">Riwayat Approval</h2>
        <% if (approvals && approvals.length > 0) { %>
            <div class="space-y-4">
                <% approvals.forEach(appr=> { %>
                    <div class="flex flex-col p-4 bg-gray-50 rounded-lg border border-gray-200 relative overflow-hidden">
                        <div class="flex flex-wrap justify-between items-start mb-2 gap-2">
                            <div>
                                <span class="font-medium text-sm block text-gray-900"><%= appr.approver_name || 'Sistem' %></span>
                                <span class="text-xs text-gray-500"><%= appr.created_at ? new Date(appr.created_at).toLocaleString('id-ID', { day: 'numeric' , month: 'short' , year: 'numeric' , hour: '2-digit' , minute:'2-digit' }) : '-' %></span>
                            </div>
                            <% if (appr.status === 'pending') { %><span class="status-badge status-pending">Pending</span>
                            <% } else if (appr.status === 'approved') { %><span class="status-badge status-approved">Approved</span>
                            <% } else if (appr.status === 'rejected') { %><span class="status-badge status-rejected">Rejected</span>
                            <% } else if (appr.status === 'cancelled') { %><span class="status-badge status-cancelled">Cancelled</span>
                            <% } else { %><span class="status-badge status-cancelled"><%= appr.status %></span><% } %>
                        </div>
                        <% if (appr.comments) { %>
                            <div class="mt-2 text-sm bg-white p-3 rounded border border-gray-200 shadow-sm text-gray-700">
                                <span class="text-gray-500 italic mr-1">Catatan:</span> "<%= appr.comments %>"
                            </div>
                        <% } %>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="flex flex-col items-center justify-center py-8 text-center text-gray-400">
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="opacity-50 mb-3"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
                <p class="text-sm">Belum ada riwayat approval tercatat pada sistem.</p>
            </div>
        <% } %>
    </div>
</div>