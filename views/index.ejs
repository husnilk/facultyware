<div class="mb-6 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
    <div>
        <h2 class="text-2xl font-bold text-gray-800">Riwayat Pengajuan Cuti</h2>
        <p class="text-sm text-gray-500 mt-1">Daftar seluruh pengajuan cuti yang pernah Anda buat di sistem.</p>
    </div>
    
    <div class="flex gap-3">
        <a href="/pegawai/export-pdf" target="_blank" class="bg-red-50 text-red-600 hover:bg-red-100 hover:text-red-700 font-medium py-2 px-4 border border-red-200 rounded-lg shadow-sm transition-colors flex items-center gap-2 text-sm">
            <i class="fa-solid fa-file-pdf"></i> Cetak PDF
        </a>
        
        <a href="/pegawai/create" class="bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-lg shadow-sm transition-colors flex items-center gap-2 text-sm">
            Buat Pengajuan Baru
        </a>
    </div>
</div>

<div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-sm text-left text-gray-500">
            <thead class="text-xs text-gray-700 uppercase bg-gray-50 border-b border-gray-100">
                <tr>
                    <th scope="col" class="px-6 py-4">NO. PENGAJUAN</th>
                    <th scope="col" class="px-6 py-4">JENIS CUTI</th>
                    <th scope="col" class="px-6 py-4">TANGGAL MULAI</th>
                    <th scope="col" class="px-6 py-4">DURASI</th>
                    <th scope="col" class="px-6 py-4">STATUS</th>
                    <th scope="col" class="px-6 py-4 text-center">AKSI</th>
                </tr>
            </thead>
            <tbody>
                <% if (requests.length === 0) { %>
                    <tr>
                        <td colspan="6" class="px-6 py-8 text-center text-gray-500">
                            Belum ada riwayat pengajuan cuti. Silakan buat pengajuan baru.
                        </td>
                    </tr>
                <% } else { %>
                    <% requests.forEach(cuti => { %>
                        <tr class="bg-white border-b border-gray-50 hover:bg-gray-50 transition-colors">
                            <td class="px-6 py-4 font-bold text-gray-900">#<%= cuti.id %></td>
                            <td class="px-6 py-4 text-gray-800"><%= cuti.leave_type_name %></td>
                            <td class="px-6 py-4">
                                <%= new Date(cuti.start_date).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                            </td>
                            <td class="px-6 py-4"><%= cuti.total_days %> Hari</td>
                            <td class="px-6 py-4">
                                <span class="px-3 py-1 rounded-full text-xs font-medium 
                                    <%= cuti.status === 'pending' ? 'bg-yellow-50 text-yellow-700 border border-yellow-200' : 
                                       (cuti.status === 'approved' ? 'bg-green-50 text-green-700 border border-green-200' : 
                                       'bg-red-50 text-red-700 border border-red-200') %>">
                                    <% if(cuti.status === 'pending') { %>
                                        <span class="inline-block w-1.5 h-1.5 bg-yellow-500 rounded-full mr-1"></span> Menunggu
                                    <% } else if(cuti.status === 'approved') { %>
                                        <span class="inline-block w-1.5 h-1.5 bg-green-500 rounded-full mr-1"></span> Disetujui
                                    <% } else { %>
                                        <span class="inline-block w-1.5 h-1.5 bg-red-500 rounded-full mr-1"></span> Ditolak
                                    <% } %>
                                </span>
                            </td>
                            <td class="px-6 py-4 text-center">
                                <a href="/pegawai/<%= cuti.id %>" class="text-blue-500 border border-blue-200 rounded px-3 py-1 text-xs hover:bg-blue-50 transition-colors">Detail</a>
                            </td>
                        </tr>
                    <% }) %>
                <% } %>
            </tbody>
        </table>
    </div>
</div>