<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        appbg: '#000000',       
                        panel: '#0a0a0a',       
                        surface: '#171717',     
                        edge: '#262626',        
                        primary: '#ededed',     
                        muted: '#a3a3a3',       
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-appbg text-primary antialiased flex items-center justify-center min-h-screen font-sans selection:bg-emerald-500/30">

    <div class="w-full max-w-sm p-4">
        
        <div class="flex justify-center items-center mb-8">
            <span class="text-emerald-500 font-black text-3xl italic tracking-tighter mr-2">//</span>
            <span class="font-bold text-xl tracking-widest text-primary uppercase">Facultyware</span>
        </div>

        <div class="bg-panel border border-edge rounded-lg shadow-2xl p-8 relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-emerald-500/50 to-transparent"></div>

            <div class="text-center mb-8">
                <h1 class="text-2xl font-bold text-primary tracking-tight">Login</h1>
                <p class="text-sm text-muted mt-2">Sistem Inventaris</p>
            </div>

            <form action="/login" method="POST" class="space-y-5">
                
                <div class="space-y-1.5">
                    <label for="email" class="block text-sm font-medium text-primary">Email</label>
                    <input type="email" id="email" name="email" required autocomplete="email"
                        class="w-full bg-appbg border border-edge text-primary text-sm rounded-md focus:ring-1 focus:ring-emerald-500/50 focus:border-emerald-500/50 block p-2.5 outline-none transition-all placeholder-edge" placeholder="Masukkan email">
                </div>

                <div class="space-y-1.5">
                    <label for="password" class="block text-sm font-medium text-primary">Password</label>
                    <input type="password" id="password" name="password" required autocomplete="current-password"
                        class="w-full bg-appbg border border-edge text-primary text-sm rounded-md focus:ring-1 focus:ring-emerald-500/50 focus:border-emerald-500/50 block p-2.5 outline-none transition-all placeholder-edge" placeholder="••••••••">
                </div>

                <div class="pt-2">
                    <button type="submit" class="w-full bg-primary hover:bg-white text-appbg py-2.5 rounded-md text-sm font-bold transition-all shadow-[0_0_15px_rgba(16,185,129,0.15)] hover:shadow-[0_0_20px_rgba(16,185,129,0.3)] ring-1 ring-emerald-500/30">
                        Login
                    </button>
                </div>
            </form>
        </div>
    </div>

</body>
</html>