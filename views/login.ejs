<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>FTI Survey Login</title>

    <link rel="stylesheet" href="/assets/styles.css">

</head>

<body
style="
margin:0;
min-height:100vh;
display:flex;
justify-content:center;
align-items:center;
overflow:hidden;
position:relative;
">

<!-- VIDEO BACKGROUND -->

<video
autoplay
muted
loop
playsinline
style="
position:fixed;
top:0;
left:0;
width:100%;
height:100%;
object-fit:cover;
z-index:-2;
">

    <source
        src="/assets/videos/login.mp4"
        type="video/mp4">

</video>

<!-- Overlay -->

<div
style="
position:fixed;
inset:0;
background:rgba(0,0,0,.35);
z-index:-1;
">
</div>

<!-- LOGIN CARD -->

<div
style="
width:950px;
height:560px;
display:grid;
grid-template-columns:1fr 1fr;
background:rgba(255,255,255,.12);
backdrop-filter:blur(22px);
-webkit-backdrop-filter:blur(22px);
border:1px solid rgba(255,255,255,.25);
border-radius:24px;
overflow:hidden;
box-shadow:0 20px 60px rgba(0,0,0,.40);
">

    <!-- LEFT -->

    <div
    style="
    padding:60px;
    display:flex;
    flex-direction:column;
    justify-content:center;
    background:rgba(255,255,255,.08);
    ">

        <div
        style="
        text-align:center;
        margin-bottom:35px;
        ">

            <img
                src="/assets/images/logo.jpg"
                style="
                width:80px;
                border-radius:50%;
                margin:auto;
                display:block;
                box-shadow:0 10px 30px rgba(0,0,0,.35);
                ">

            <h1
            style="
            color:white;
            font-size:34px;
            margin-top:18px;
            font-weight:bold;
            ">

                FTI Survey
              

            </h1>

            <p
            style="
            color:white;
            opacity:.85;
            ">

                Login to your account

            </p>

        </div>

        <% if(error){ %>

            <div
            style="
            background:#ef4444;
            color:white;
            padding:12px;
            border-radius:10px;
            margin-bottom:20px;
            text-align:center;
            ">

                <%= error %>

            </div>

        <% } %>

        <form
        action="/login"
        method="POST">

            <div style="margin-bottom:20px;">

                <label
                style="
                color:white;
                display:block;
                margin-bottom:8px;
                ">

                    Email

                </label>

                <input
                    type="email"
                    name="email"
                    placeholder="admin@gmail.com"
                    required
                    class="input w-full"
                    style="
                    height:48px;
                    border-radius:12px;
                    ">

            </div>

            <div style="margin-bottom:30px;">

                <label
                style="
                color:white;
                display:block;
                margin-bottom:8px;
                ">

                    Password

                </label>

                <input
                    type="password"
                    name="password"
                    placeholder="********"
                    required
                    class="input w-full"
                    style="
                    height:48px;
                    border-radius:12px;
                    ">

            </div>

            <button
                type="submit"
                class="btn btn-primary w-full"
                style="
                height:52px;
                border-radius:12px;
                font-size:16px;
                font-weight:bold;
                ">

                Login

            </button>

        </form>

    </div>

    <!-- RIGHT -->

    <div
    style="
    position:relative;
    overflow:hidden;
    ">

        <img
            src="/assets/images/side-login.jpg"
            style="
            width:100%;
            height:100%;
            object-fit:cover;
            ">

        <div
        style="
        position:absolute;
        inset:0;
        background:linear-gradient(
        rgba(0,0,0,.10),
        rgba(0,0,0,.55)
        );
        ">
        </div>

        <div
        style="
        position:absolute;
        left:40px;
        bottom:40px;
        color:white;
        ">

            <h2
            style="
            font-size:38px;
            font-weight:bold;
            margin-bottom:15px;
            ">

                FTI Survey

            </h2>

            <p
            style="
            font-size:18px;
            line-height:1.7;
            ">

                Survey Management System

                <br><br>

                Faculty of Information Technology

            </p>

        </div>

    </div>

</div>

</body>

</html>