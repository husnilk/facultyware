<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title || "Login" %> - FTI Event Management</title>
  <link rel="stylesheet" href="/assets/styles.css" />

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      min-height: 100vh;
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f6f7fb;
      color: #111827;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
    }

    .login-wrapper {
      width: 100%;
      max-width: 420px;
      background: #ffffff;
      border: 1px solid #e5e7eb;
      border-radius: 18px;
      box-shadow: 0 18px 45px rgba(15, 23, 42, 0.08);
      padding: 30px;
    }

    .brand {
      text-align: center;
      margin-bottom: 26px;
    }

    .brand-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 6px 12px;
      border-radius: 999px;
      background: #eef2ff;
      color: #4338ca;
      font-size: 12px;
      font-weight: 700;
      margin-bottom: 12px;
    }

    .brand h1 {
      margin: 0;
      font-size: 28px;
      font-weight: 800;
      letter-spacing: -0.03em;
    }

    .brand p {
      margin: 8px 0 0;
      color: #6b7280;
      font-size: 14px;
      line-height: 1.5;
    }

    .alert {
      padding: 12px 14px;
      border-radius: 12px;
      background: #fef2f2;
      color: #b91c1c;
      border: 1px solid #fecaca;
      font-size: 14px;
      margin-bottom: 18px;
    }

    .form-group {
      margin-bottom: 16px;
    }

    label {
      display: block;
      font-size: 14px;
      font-weight: 700;
      margin-bottom: 8px;
      color: #374151;
    }

    input {
      width: 100%;
      height: 46px;
      padding: 0 14px;
      border: 1px solid #d1d5db;
      border-radius: 12px;
      font-size: 14px;
      outline: none;
      background: #ffffff;
      color: #111827;
    }

    input:focus {
      border-color: #111827;
      box-shadow: 0 0 0 3px rgba(17, 24, 39, 0.08);
    }

    .btn-login {
      width: 100%;
      height: 46px;
      border: none;
      border-radius: 12px;
      background: #111827;
      color: #ffffff;
      font-size: 15px;
      font-weight: 700;
      cursor: pointer;
      margin-top: 6px;
    }

    .btn-login:hover {
      background: #030712;
    }

    .hint {
      margin-top: 18px;
      padding: 12px;
      border-radius: 12px;
      background: #f9fafb;
      border: 1px dashed #d1d5db;
      font-size: 13px;
      color: #6b7280;
      line-height: 1.5;
    }

    .hint strong {
      color: #111827;
    }
  </style>
</head>

<body>
  <main class="login-wrapper">
    <div class="brand">
      <div class="brand-badge">FTI Event Management</div>
      <h1>Login</h1>
      <p>Masuk untuk mengelola event, registrasi, reminder, sertifikat, dan laporan.</p>
    </div>

    <% if (typeof error !== "undefined" && error) { %>
      <div class="alert">
        <%= error %>
      </div>
    <% } %>

    <form action="/login" method="POST">
      <div class="form-group">
        <label for="username">Email atau Nama</label>
        <input
          type="text"
          id="username"
          name="username"
          placeholder="Masukkan email atau nama"
          value="<%= typeof oldInput !== 'undefined' ? oldInput : '' %>"
          autocomplete="username"
          required
        />
      </div>

      <div class="form-group">
        <label for="password">Password</label>
        <input
          type="password"
          id="password"
          name="password"
          placeholder="Masukkan password"
          autocomplete="current-password"
          required
        />
      </div>

      <button type="submit" class="btn-login">Masuk</button>
    </form>
  </main>
</body>
</html>