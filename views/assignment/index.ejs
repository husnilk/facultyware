<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <title><%= title %></title>

    <link rel="stylesheet" href="/assets/styles.css">

</head>

<body class="bg-muted">

<div class="container mx-auto p-10">

<div class="card p-6">

<div class="flex justify-between items-center">

<h1 class="text-2xl font-bold">

Data Assignment Survey

</h1>

<a href="/assignment/create" class="btn">

Tambah Assignment

</a>

</div>

<br>

<!-- SEARCH -->

<form action="/assignment" method="GET">

    <input
        type="text"
        name="search"
        placeholder="Cari survey / pertanyaan..."
        value="<%= search || '' %>"
        style="padding:8px;width:300px;">

    <button type="submit">

        Cari

    </button>

    <a href="/assignment">

        Reset

    </a>

</form>

<br>

<table class="table-auto w-full mt-6 border">

<thead>

<tr>

<th>No</th>

<th>Survey</th>

<th>Pertanyaan</th>

<th>Urutan</th>

<th>Aksi</th>

</tr>

</thead>

<tbody>

<% if(assignments.length==0){ %>

<tr>

<td colspan="5" align="center">

Tidak ada data.

</td>

</tr>

<% } %>

<% assignments.forEach((assignment,index)=>{ %>

<tr>

<td>

<%= ((page-1)*5)+index+1 %>

</td>

<td>

<%= assignment.survey_title %>

</td>

<td>

<%= assignment.question_text %>

</td>

<td>

<%= assignment.order %>

</td>

<td>

<a href="/assignment/edit/<%= assignment.id %>">

Edit

</a>

|

<form
action="/assignment/delete/<%= assignment.id %>"
method="POST"
style="display:inline;">

<button
onclick="return confirm('Yakin hapus data?')">

Hapus

</button>

</form>

</td>

</tr>

<% }) %>

</tbody>

</table>

<br>

<!-- PAGINATION -->

<div>

<% if(page>1){ %>

<a href="/assignment?page=<%= page-1 %>&search=<%= search %>">

← Sebelumnya

</a>

<% } %>

&nbsp;

Halaman

<%= page %>

dari

<%= totalPage %>

&nbsp;

<% if(page<totalPage){ %>

<a href="/assignment?page=<%= page+1 %>&search=<%= search %>">

Selanjutnya →

</a>

<% } %>

</div>

<br>

<a href="/home" class="btn-outline">

Kembali

</a>

</div>

</div>

</body>

</html>