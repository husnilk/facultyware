<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

<title><%= title %></title>

<link rel="stylesheet" href="/assets/styles.css">
<link rel="stylesheet" href="/assets/dashboard.css">
<link rel="stylesheet" href="/assets/survey.css">

</head>

<body>

<video autoplay muted loop playsinline class="dashboard-video">
    <source src="/assets/videos/dashboard.mp4" type="video/mp4">
</video>

<div class="dashboard-bg"></div>
<div class="dashboard-blur"></div>

<div class="wrapper">

    <%- include("../partials/sidebar") %>

    <div class="content">

        <%- include("../partials/navbar") %>

        <div class="page-header">

            <div>

                <span class="hero-badge">

                    Survey Assignment

                </span>

                <h1>

                    Edit Assignment

                </h1>

                <p>

                    Update assignment information.

                </p>

            </div>

            <a
                href="/assignment"
                class="hero-btn-outline">

                ← Back

            </a>

        </div>

        <div class="glass-card">

            <% if(error){ %>

                <div class="alert-error">

                    <%= error %>

                </div>

            <% } %>

            <form
                action="/assignment/edit/<%= assignment.id %>"
                method="POST">

                <div class="form-group">

                    <label>

                        Survey

                    </label>

                    <select
                        name="survey_id"
                        required>

                        <% surveys.forEach(survey=>{ %>

                            <option
                                value="<%= survey.id %>"
                                <%= survey.id == assignment.survey_id ? 'selected' : '' %>>

                                <%= survey.title %>

                            </option>

                        <% }) %>

                    </select>

                </div>

                <div class="form-group">

                    <label>

                        Question

                    </label>

                    <select
                        name="survey_question_id"
                        required>

                        <% questions.forEach(question=>{ %>

                            <option
                                value="<%= question.id %>"
                                <%= question.id == assignment.survey_question_id ? 'selected' : '' %>>

                                <%= question.question_text %>

                            </option>

                        <% }) %>

                    </select>

                </div>

                <div class="form-group">

                    <label>

                        Order

                    </label>

                    <input
                        type="number"
                        name="order"
                        min="1"
                        value="<%= assignment.order %>"
                        required>

                </div>

                <div class="form-action">

                    <button
                        type="submit"
                        class="hero-btn">

                        💾 Update Assignment

                    </button>

                    <a
                        href="/assignment"
                        class="hero-btn-outline">

                        Cancel

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

</body>

</html>