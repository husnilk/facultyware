<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <title>Tambah Survey</title>

    <link rel="stylesheet" href="/assets/styles.css">

</head>

<body>

<div class="container mx-auto p-10">

    <h1 class="text-3xl font-bold mb-6">

        Tambah Survey

    </h1>

    <form action="/survey/create" method="POST">

        <div class="mb-4">

            <label>Judul Survey</label>

            <input
                type="text"
                name="title"
                class="border w-full p-2"
                required>

        </div>

        <div class="mb-4">

            <label>Deskripsi</label>

            <textarea
                name="description"
                class="border w-full p-2"
                rows="5"
                required></textarea>

        </div>

        <div class="mb-4">

            <label>Tanggal Mulai</label>

            <input
                type="date"
                name="start_date"
                class="border w-full p-2"
                required>

        </div>

        <div class="mb-4">

            <label>Tanggal Selesai</label>

            <input
                type="date"
                name="end_date"
                class="border w-full p-2"
                required>

        </div>

        <button  type="submit"
    class="btn">

    Simpan

        </button>

        <a href="/survey" class="btn">

            Kembali

        </a>

    </form>

</div>

</body>

</html>